<Window x:Class="DaEtoZhe.Desktop.VehicleRepairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DaEtoZhe.Desktop.Controls"
        Title="Ремонт автомобиля"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanResize"
        MinWidth="1150" MinHeight="780"
        Width="1250" Height="820"
        Background="{DynamicResource BgMain}"
        Foreground="{DynamicResource TextMain}">

    <!-- Единый отступ содержимого окна из токена -->
    <Grid Margin="{StaticResource WindowContentMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══ ROW 0: ЗАГОЛОВОК И ИНФО ОБ АВТО ═══ -->
        <StackPanel Grid.Row="0" Margin="{StaticResource CardGapMargin}">
            <TextBlock x:Name="TitleText" Text="🔧 Ремонт" Style="{StaticResource HeadingMediumStyle}"/>
            <TextBlock x:Name="VehicleInfoText" Style="{StaticResource TextSecondaryStyle}"
                       Margin="{StaticResource PageTitleMargin}" TextWrapping="Wrap"/>
        </StackPanel>

        <!-- ═══ ROW 1: ФИНАНСОВЫЙ ПУЛЬС РЕМОНТА ═══ -->
        <Border Grid.Row="1" Style="{StaticResource CardFlatStyle}" Margin="{StaticResource CardGapMargin}">
            <UniformGrid Columns="5">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Запчасти" Style="{StaticResource FilterLabelStyle}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="PartsCostText" Style="{StaticResource StatMetricStyle}"
                               Foreground="{DynamicResource AccentOrange}"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Работы" Style="{StaticResource FilterLabelStyle}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LaborCostText" Style="{StaticResource StatMetricStyle}"
                               Foreground="{DynamicResource AccentBlue}"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="ИТОГО факт" Style="{StaticResource FilterLabelStyle}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TotalCostText" Style="{StaticResource StatMetricStyle}"
                               Foreground="{DynamicResource TextMain}"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Смета приёмки" Style="{StaticResource FilterLabelStyle}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EstimateText" Style="{StaticResource StatMetricStyle}"
                               Foreground="{DynamicResource TextMuted}"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Превышение сметы" Style="{StaticResource FilterLabelStyle}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="OverrunText" Style="{StaticResource StatMetricStyle}"/>
                </StackPanel>
            </UniformGrid>
        </Border>

        <!-- ═══ ROW 2: ЗАПЧАСТИ (СЛЕВА) + РАБОТЫ (СПРАВА) ═══ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ЛЕВО: запчасти со склада -->
            <Grid Margin="{StaticResource FormFieldColLastMargin}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="📦 Запчасти со склада" Style="{StaticResource HeadingSmallStyle}" Style="{StaticResource SectionBlockStyle}"/>

                <Border Grid.Row="1" Style="{StaticResource CardCompactStyle}" Margin="{StaticResource CardGapMargin}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Подсказка по остаткам + комбобокс через встроенный Header -->
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="StockHintText" Style="{StaticResource FormHintTextStyle}"/>
                            <controls:CustomComboBox x:Name="ItemCombo" Header="Позиция номенклатуры"
                                                     DisplayMemberPath="Name" SelectedValuePath="Id"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Style="{StaticResource FormFieldStackStyle}">
                            <TextBlock Text="Кол-во" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox x:Name="PartQtyTextBox"
                                     PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                        </StackPanel>

                        <!-- Кнопка прижата к нижней границе ряда полей -->
                        <Button Grid.Column="2" Content="➕ Списать" Style="{StaticResource PrimaryBtn}"
                                VerticalAlignment="Bottom" Margin="{StaticResource InlineButtonGapMargin},0,0,0"
                                Click="AddPart_Click"/>
                    </Grid>
                </Border>

                <DataGrid x:Name="PartsGrid" Grid.Row="2" Style="{StaticResource AuditDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Позиция" Binding="{Binding StockItem.Name}" Width="*"/>
                        <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity, StringFormat={}{0:0.###}}" Width="75"/>
                        <DataGridTextColumn Header="Цена" Binding="{Binding CostPrice, StringFormat=N2}" Width="85"/>
                        <DataGridTextColumn Header="Сумма" Binding="{Binding TotalCost, StringFormat=N0}" Width="95"/>
                        <DataGridTemplateColumn Header="" Width="45">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="↩" Click="ReturnPart_Click" Tag="{Binding}"
                                            Style="{StaticResource GridDangerButtonStyle}"
                                            ToolTip="Вернуть на склад (сторно)"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- ПРАВО: работы механиков -->
            <Grid Grid.Column="1" Margin="{StaticResource HCardGapMargin}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="👨‍🔧 Работы механиков" Style="{StaticResource HeadingSmallStyle}" Style="{StaticResource SectionBlockStyle}"/>

                <Border Grid.Row="1" Style="{StaticResource CardCompactStyle}" Margin="{StaticResource CardGapMargin}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <!-- Ряд 1: комбобоксы (Header встроенный) + числовые поля, всё выровнено по низу -->
                        <controls:CustomComboBox Grid.Column="0" x:Name="MechanicCombo" Header="Механик"
                                                 VerticalAlignment="Bottom"
                                                 DisplayMemberPath="FullName" SelectedValuePath="Id"/>
                        <controls:CustomComboBox Grid.Column="1" x:Name="DefectCombo" Header="Дефект (опц.)"
                                                 VerticalAlignment="Bottom" Margin="{StaticResource HFieldGapMargin}"
                                                 DisplayMemberPath="Description" SelectedValuePath="Id"/>
                        <StackPanel Grid.Column="2" Style="{StaticResource FormFieldStackStyle}">
                            <TextBlock Text="План, ч" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox x:Name="PlannedHoursTextBox"
                                     PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Style="{StaticResource FormFieldStackStyle}">
                            <TextBlock Text="Факт, ч" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox x:Name="ActualHoursTextBox"
                                     PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4" Style="{StaticResource FormFieldStackStyle}">
                            <TextBlock Text="Ставка ₽/ч" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox x:Name="RateTextBox"
                                     PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                        </StackPanel>
                        <controls:CustomComboBox Grid.Column="5" x:Name="WorkStatusCombo" Header="Статус"
                                                 VerticalAlignment="Bottom" Margin="{StaticResource HFieldGapMargin}"
                                                 DisplayMemberPath="Name" SelectedValuePath="Value"/>

                        <!-- Ряд 2: описание работы + кнопка добавления -->
                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Margin="{StaticResource FormFieldColLastMargin}">
                            <TextBlock Text="Описание работы" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox x:Name="WorkDescTextBox"/>
                        </StackPanel>
                        <Button Grid.Row="1" Grid.Column="5" x:Name="SaveWorkButton" Content="➕ Добавить"
                                Style="{StaticResource SuccessBtn}" VerticalAlignment="Bottom"
                                Margin="{StaticResource FormFieldColLastMargin}" Click="SaveWork_Click"/>
                    </Grid>
                </Border>

                <DataGrid x:Name="WorksGrid" Grid.Row="2" Style="{StaticResource AuditDataGridStyle}"
                          SelectionChanged="WorksGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Механик" Binding="{Binding Mechanic.FullName}" Width="115"/>
                        <DataGridTextColumn Header="Работа" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="Часы" Binding="{Binding ActualHours, StringFormat={}{0:0.#}}" Width="60"/>
                        <DataGridTextColumn Header="Сумма" Binding="{Binding TotalCost, StringFormat=N0}" Width="85"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding StatusName}" Width="85"/>
                        <DataGridTemplateColumn Header="" Width="45">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🗑" Click="DeleteWork_Click" Tag="{Binding}"
                                            Style="{StaticResource GridDangerButtonStyle}"
                                            ToolTip="Удалить работу"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <!-- ═══ ROW 3: БРИГАДА И ПРОЦЕНТЫ ЗП ═══ -->
        <Border Grid.Row="3" Style="{StaticResource CardFlatStyle}" Margin="{StaticResource FormSectionTopMargin}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <!-- Таблица долей механиков -->
                <StackPanel Margin="{StaticResource ControlGapLGMargin}">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="👷 Бригада и проценты ЗП" Style="{StaticResource HeadingSmallStyle}"/>
                        <TextBlock x:Name="ShareSumText" Style="{StaticResource TextCaptionStyle}"
                                   FontWeight="SemiBold"
                                   Margin="{StaticResource InlineButtonGapMargin}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <DataGrid x:Name="SharesGrid" Style="{StaticResource AuditDataGridStyle}"
                              MaxHeight="180" SelectionChanged="SharesGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Механик" Binding="{Binding Mechanic.FullName}" Width="*"/>
                            <DataGridTextColumn Header="Доля" Binding="{Binding SharePercent, StringFormat={}{0:0.##}%}" Width="75"/>
                            <DataGridTextColumn Header="К начислению" Binding="{Binding EarnedAmount, StringFormat=N0}" Width="115"/>
                            <DataGridTemplateColumn Header="" Width="45">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="🗑" Click="DeleteShare_Click" Tag="{Binding}"
                                                Style="{StaticResource GridDangerButtonStyle}"
                                                ToolTip="Удалить долю"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>

                <!-- Панель добавления/редактирования доли -->
                <Border Grid.Column="1" Background="{DynamicResource BgMain}"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                        CornerRadius="{DynamicResource RadiusMD}" Padding="{StaticResource ControlPaddingMD}">
                    <StackPanel>
                        <controls:CustomComboBox x:Name="ShareMechanicCombo" Header="Механик"
                                                 DisplayMemberPath="FullName" SelectedValuePath="Id"
                                                 Margin="{StaticResource FormFieldMargin}"/>
                        <TextBlock Text="Процент доли" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="SharePercentTextBox"
                                 PreviewTextInput="DecimalOnly_PreviewTextInput"
                                 Margin="{StaticResource FormFieldMargin}"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="AddShareButton" Content="➕ Добавить" Style="{StaticResource PrimaryBtn}"
                                    Margin="{StaticResource ButtonRowGapMargin}" Click="AddShare_Click"/>
                            <Button x:Name="SaveShareButton" Content="💾 Сохранить" Style="{StaticResource SuccessBtn}"
                                    Margin="0" Click="SaveShare_Click" IsEnabled="False"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ ROW 4: ФУТЕР С КНОПКАМИ ═══ -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center"
                    Margin="{StaticResource FormSectionTopMargin}">
            <Button Content="✅ Завершить ремонт" Style="{StaticResource SuccessBtn}" Click="Finish_Click"
                    Margin="{StaticResource ButtonRowGapMargin}"/>
            <Button Content="🔄 Обновить" Style="{StaticResource PrimaryBtn}" Click="Refresh_Click"
                    Margin="{StaticResource ButtonRowGapMargin}"/>
            <Button Content="✖ Закрыть" Style="{StaticResource DangerBtn}" Click="Close_Click"
                    Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
