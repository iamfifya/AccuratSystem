<Window x:Class="DaEtoZhe.Desktop.VehicleRepairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ремонт автомобиля"
        WindowStartupLocation="CenterOwner"
        Width="1250" Height="800"
        Background="{DynamicResource BgMain}"
        Foreground="{DynamicResource TextMain}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Text="🔧 Ремонт" FontSize="22" FontWeight="Bold" Margin="0,0,0,6"/>
        <TextBlock x:Name="VehicleInfoText" Grid.Row="1" FontSize="13"
                   Foreground="{DynamicResource TextMuted}" Margin="0,0,0,12" TextWrapping="Wrap"/>

        <!-- Финансовый пульс ремонта -->
        <Border Grid.Row="1" Margin="0,22,0,12" Background="{DynamicResource BgCard}" CornerRadius="6"
                Padding="15" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
            <UniformGrid Columns="5">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Запчасти" FontSize="12" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="PartsCostText" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource AccentOrange}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Работы" FontSize="12" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LaborCostText" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource AccentBlue}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="ИТОГО факт" FontSize="12" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TotalCostText" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextMain}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Смета приёмки" FontSize="12" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="EstimateText" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Превышение сметы" FontSize="12" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="OverrunText" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,4,0,0"/>
                </StackPanel>
            </UniformGrid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ЛЕВО: запчасти -->
            <Grid Margin="0,0,10,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="📦 Запчасти со склада" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

                <Border Grid.Row="1" Background="{DynamicResource BgCard}" CornerRadius="6" Padding="10"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock x:Name="StockHintText" FontSize="11" Opacity="0.7"/>
                            <controls:CustomComboBox xmlns:controls="clr-namespace:DaEtoZhe.Desktop.Controls"
                                x:Name="ItemCombo" Header="Позиция номенклатуры"
                                DisplayMemberPath="Name" SelectedValuePath="Id"
                                SelectionChanged="ItemCombo_Changed"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                            <TextBlock Text="Кол-во" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                            <TextBox x:Name="PartQtyTextBox" Height="36" Padding="10,0"
                                     PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="➕ Списать" Style="{StaticResource PrimaryBtn}"
                                VerticalAlignment="Bottom" Click="AddPart_Click"/>
                    </Grid>
                </Border>

                <DataGrid x:Name="PartsGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource BorderColor}"
                          Foreground="{DynamicResource TextMain}" RowHeight="34">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Позиция" Binding="{Binding StockItem.Name}" Width="*"/>
                        <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity, StringFormat={}{0:0.###}}" Width="70"/>
                        <DataGridTextColumn Header="Цена" Binding="{Binding CostPrice, StringFormat=N2}" Width="80"/>
                        <DataGridTextColumn Header="Сумма" Binding="{Binding TotalCost, StringFormat=N0}" Width="90"/>
                        <DataGridTemplateColumn Header="" Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="↩" Click="ReturnPart_Click" Tag="{Binding}"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Foreground="{DynamicResource AccentRed}" ToolTip="Вернуть на склад (сторно)"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>

            <!-- ПРАВО: работы -->
            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="👨‍🔧 Работы механиков" FontSize="16" FontWeight="Bold" Margin="0,0,0,8"/>

                <Border Grid.Row="1" Background="{DynamicResource BgCard}" CornerRadius="6" Padding="10"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="110"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,8,8">
                            <TextBlock Text="Механик" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="MechanicCombo" Height="36" DisplayMemberPath="FullName" SelectedValuePath="Id"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,8">
                            <TextBlock Text="Дефект (опц.)" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="DefectCombo" Height="36" DisplayMemberPath="Description" SelectedValuePath="Id"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,8,8">
                            <TextBlock Text="План, ч" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                            <TextBox x:Name="PlannedHoursTextBox" Height="36" Padding="8,0"
                                     PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="0,0,8,8">
                            <TextBlock Text="Факт, ч" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                            <TextBox x:Name="ActualHoursTextBox" Height="36" Padding="8,0"
                                     PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                        </StackPanel>
                        <StackPanel Grid.Column="4" Margin="0,0,8,8">
                            <TextBlock Text="Ставка ₽/ч" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                            <TextBox x:Name="RateTextBox" Height="36" Padding="8,0"
                                     PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                        </StackPanel>
                        <StackPanel Grid.Column="5" Margin="0,0,0,8">
                            <TextBlock Text="Статус" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                            <ComboBox x:Name="WorkStatusCombo" Height="36" DisplayMemberPath="Name" SelectedValuePath="Value"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="5" Margin="0,0,8,0">
                            <TextBlock Text="Описание работы" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                            <TextBox x:Name="WorkDescTextBox" Height="36" Padding="10,0"/>
                        </StackPanel>
                        <Button Grid.Row="1" Grid.Column="5" x:Name="SaveWorkButton" Content="➕ Добавить"
                                Style="{StaticResource SuccessBtn}" Click="SaveWork_Click"/>
                    </Grid>
                </Border>

                <DataGrid x:Name="WorksGrid" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                          Background="Transparent" BorderThickness="0" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource BorderColor}"
                          Foreground="{DynamicResource TextMain}" RowHeight="34"
                          SelectionChanged="WorksGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Механик" Binding="{Binding Mechanic.FullName}" Width="110"/>
                        <DataGridTextColumn Header="Работа" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="Часы" Binding="{Binding ActualHours, StringFormat={}{0:0.#}}" Width="55"/>
                        <DataGridTextColumn Header="Сумма" Binding="{Binding TotalCost, StringFormat=N0}" Width="80"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding StatusName}" Width="80"/>
                        <DataGridTemplateColumn Header="" Width="40">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🗑" Click="DeleteWork_Click" Tag="{Binding}"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Foreground="{DynamicResource AccentRed}" ToolTip="Удалить работу"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button Content="✅ Завершить ремонт" Style="{StaticResource SuccessBtn}" Click="Finish_Click" Margin="0,0,10,0"/>
            <Button Content="🔄 Обновить" Style="{StaticResource PrimaryBtn}" Click="Refresh_Click" Margin="0,0,10,0"/>
            <Button Content="✖ Закрыть" Style="{StaticResource DangerBtn}" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>