<UserControl x:Class="DaEtoZhe.Desktop.Controls.CalculatorOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DaEtoZhe.Desktop"
             xmlns:controls="clr-namespace:DaEtoZhe.Desktop.Controls"
             xmlns:models="clr-namespace:DaEtoZhe.Desktop.Models"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>
        <!-- Стиль кнопок классического калькулятора -->
        <Style x:Key="CalcBttnStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgCard}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="{DynamicResource RadiusSM}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BgSelected}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Компактные и аккуратные кнопки плюс/минус для денежного калькулятора -->
        <Style x:Key="CalcCounterButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgElevated}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="{DynamicResource RadiusSM}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BgSelected}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BgHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Анимации (синхронизированы с проектом) -->
        <Storyboard x:Key="ShowAnimation">
            <DoubleAnimation Storyboard.TargetName="OverlayBackground" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
            <DoubleAnimation Storyboard.TargetName="PopupPanel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="PopupPanel" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.8" To="1" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PopupPanel" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.8" To="1" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="HideAnimation">
            <DoubleAnimation Storyboard.TargetName="OverlayBackground" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="PopupPanel" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="PopupPanel" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="0.9" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PopupPanel" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="0.9" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Карточка КУПЮРЫ / МОНЕТЫ (универсальный гармоничный шаблон) -->
        <DataTemplate x:Key="DenominationCardTemplate">
            <Border Background="{DynamicResource BgCard}" CornerRadius="{DynamicResource RadiusMD}" Margin="4" Padding="10,8"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMain}" 
                               HorizontalAlignment="Center" Margin="0,0,0,6"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="−" FontSize="16" FontWeight="Bold" Cursor="Hand"
                                Click="Money_Minus_Click" Tag="{Binding}" Style="{StaticResource CalcCounterButtonStyle}"
                                Foreground="{DynamicResource AccentRed}"/>

                        <TextBox Grid.Column="1" Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="4,0" TextAlignment="Center" Height="36"
                                 FontSize="14" FontWeight="Bold" VerticalContentAlignment="Center"/>

                        <Button Grid.Column="2" Content="+" FontSize="16" FontWeight="Bold" Cursor="Hand"
                                Click="Money_Plus_Click" Tag="{Binding}" Style="{StaticResource CalcCounterButtonStyle}"
                                Foreground="{DynamicResource AccentGreen}"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <!-- ГЛАВНЫЙ КОЙТЕЙНЕР (Затемнение фона) -->
    <Border x:Name="OverlayBackground" 
            Background="{DynamicResource BgOverlay}" 
            Visibility="Collapsed" 
            Opacity="0"
            HorizontalAlignment="Stretch" 
            VerticalAlignment="Stretch"
            MouseLeftButtonDown="Overlay_MouseLeftButtonDown">

        <Border x:Name="PopupPanel" 
                Background="{DynamicResource BgMain}" 
                CornerRadius="{DynamicResource RadiusLG}" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Width="720" Height="860" 
                Opacity="0"
                MouseLeftButtonDown="PopupPanel_MouseLeftButtonDown">
            <Border.Effect>
                <DynamicResource ResourceKey="PopupShadow"/>
            </Border.Effect>

            <Border.RenderTransform>
                <ScaleTransform ScaleX="0.8" ScaleY="0.8"/>
            </Border.RenderTransform>

            <!-- Содержимое панели -->

            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <StackPanel Grid.Row="0" Margin="0,0,0,16">
                    <TextBlock Text="🧮 Калькулятор" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource TextMain}" 
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Переключатель режимов (Табы) -->
                <TabControl Grid.Row="1" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Margin="0,0,0,12">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem">
                            <Setter Property="Padding" Value="14,8"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="Border" Background="{DynamicResource BgCard}" CornerRadius="{DynamicResource RadiusSM}" Margin="3,0" Padding="14,7" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                            <ContentPresenter ContentSource="Header"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentBlue}"/>
                                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.ItemContainerStyle>

                    <TabControl.Items>
                        <!-- Классический режим -->
                        <TabItem Header="Классический" IsSelected="True">
                            <Grid Margin="0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <Border Background="{DynamicResource BgCard}"
                                        CornerRadius="{DynamicResource RadiusMD}"
                                        Padding="16,12" 
                                        Margin="0,0,0,16" 
                                        BorderBrush="{DynamicResource BorderColor}" 
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock x:Name="ClassicExpressionText"
                                                   Grid.Row="0"
                                                   Text="{Binding ClassicExpression}" 
                                                   FontSize="14"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   TextAlignment="Right"
                                                   Margin="0,0,0,4"
                                                   MinHeight="20"/>

                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding ClassicResult}" 
                                                   FontSize="42" 
                                                   FontWeight="SemiBold" 
                                                   Foreground="{DynamicResource TextMain}" 
                                                   TextAlignment="Right"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>

                                <UniformGrid Grid.Row="1" Columns="4" Rows="5">
                                    <Button Content="C" Style="{StaticResource CalcBttnStyle}" Click="Calc_Clear_Click" 
                                            Background="{DynamicResource CalcClearBg}" Foreground="{DynamicResource AccentRed}"/>
                                    <Button Content="±" Style="{StaticResource CalcBttnStyle}" Click="Calc_Sign_Click"/>
                                    <Button Content="%" Style="{StaticResource CalcBttnStyle}" Click="Calc_Percent_Click"/>
                                    <Button Content="÷" Style="{StaticResource CalcBttnStyle}" Click="Calc_Op_Click" 
                                            Background="{DynamicResource CalcOperatorBg}"/>

                                    <Button Content="7" Style="{StaticResource CalcBttnStyle}" Click="Calc_Num_Click"/>
                                    <Button Content="8" Style="{StaticResource CalcBttnStyle}" Click="Calc_Num_Click"/>
                                    <Button Content="9" Style="{StaticResource CalcBttnStyle}" Click="Calc_Num_Click"/>
                                    <Button Content="×" Style="{StaticResource CalcBttnStyle}" Click="Calc_Op_Click" 
                                            Background="{DynamicResource CalcOperatorBg}"/>

                                    <Button Content="4" Style="{StaticResource CalcBttnStyle}" Click="Calc_Num_Click"/>
                                    <Button Content="5" Style="{StaticResource CalcBttnStyle}" Click="Calc_Num_Click"/>
                                    <Button Content="6" Style="{StaticResource CalcBttnStyle}" Click="Calc_Num_Click"/>
                                    <Button Content="-" Style="{StaticResource CalcBttnStyle}" Click="Calc_Op_Click" 
                                            Background="{DynamicResource CalcOperatorBg}"/>

                                    <Button Content="1" Style="{StaticResource CalcBttnStyle}" Click="Calc_Num_Click"/>
                                    <Button Content="2" Style="{StaticResource CalcBttnStyle}" Click="Calc_Num_Click"/>
                                    <Button Content="3" Style="{StaticResource CalcBttnStyle}" Click="Calc_Num_Click"/>
                                    <Button Content="+" Style="{StaticResource CalcBttnStyle}" Click="Calc_Op_Click" 
                                            Background="{DynamicResource CalcOperatorBg}"/>

                                    <Button Content="⌫" Style="{StaticResource CalcBttnStyle}" Click="Calc_Backspace_Click"
                                            FontSize="18" Foreground="{DynamicResource AccentOrange}"/>
                                    <Button Content="0" Style="{StaticResource CalcBttnStyle}" Click="Calc_Num_Click"/>
                                    <Button Content="," Style="{StaticResource CalcBttnStyle}" Click="Calc_Comma_Click"/>
                                    <Button Content="=" Style="{StaticResource CalcBttnStyle}" Click="Calc_Equal_Click" 
                                            Background="{DynamicResource AccentGreen}" Foreground="{DynamicResource TextOnAccent}"/>
                                </UniformGrid>
                            </Grid>
                        </TabItem>

                        <!-- Денежный режим -->
                        <TabItem Header="Денежный">
                            <Grid Margin="0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- ИТОГО В КАССЕ -->
                                <Border Grid.Row="0" Background="{DynamicResource BgElevated}" 
                                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1"
                                        CornerRadius="{DynamicResource RadiusMD}" Padding="16,12" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="ИТОГО В КАССЕ" Foreground="{DynamicResource TextMuted}" 
                                                   FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding MoneyTotal, StringFormat={}{0:N0} ₽}" 
                                                   Foreground="{DynamicResource AccentGreen}"
                                                   FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <!-- КУПЮРЫ (3 колонки) -->
                                        <TextBlock Text="Купюры" FontSize="15" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMain}" Margin="4,0,0,6"/>
                                        <UniformGrid Columns="3">
                                            <ContentControl Content="{Binding Denominations[0]}" ContentTemplate="{StaticResource DenominationCardTemplate}"/>
                                            <ContentControl Content="{Binding Denominations[1]}" ContentTemplate="{StaticResource DenominationCardTemplate}"/>
                                            <ContentControl Content="{Binding Denominations[2]}" ContentTemplate="{StaticResource DenominationCardTemplate}"/>
                                            <ContentControl Content="{Binding Denominations[3]}" ContentTemplate="{StaticResource DenominationCardTemplate}"/>
                                            <ContentControl Content="{Binding Denominations[4]}" ContentTemplate="{StaticResource DenominationCardTemplate}"/>
                                            <ContentControl Content="{Binding Denominations[5]}" ContentTemplate="{StaticResource DenominationCardTemplate}"/>
                                            <ContentControl Content="{Binding Denominations[6]}" ContentTemplate="{StaticResource DenominationCardTemplate}"/>
                                            <ContentControl Content="{Binding Denominations[7]}" ContentTemplate="{StaticResource DenominationCardTemplate}"/>
                                            <ContentControl Content="{Binding Denominations[8]}" ContentTemplate="{StaticResource DenominationCardTemplate}"/>
                                        </UniformGrid>

                                        <Separator Background="{DynamicResource BorderSubtle}" Margin="4,14"/>

                                        <!-- МОНЕТЫ (4 колонки) -->
                                        <TextBlock Text="Монеты" FontSize="15" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMain}" Margin="4,10,0,6"/>
                                        <UniformGrid Columns="4">
                                            <ContentControl Content="{Binding Denominations[9]}" ContentTemplate="{StaticResource DenominationCardTemplate}"/>
                                            <ContentControl Content="{Binding Denominations[10]}" ContentTemplate="{StaticResource DenominationCardTemplate}"/>
                                            <ContentControl Content="{Binding Denominations[11]}" ContentTemplate="{StaticResource DenominationCardTemplate}"/>
                                            <ContentControl Content="{Binding Denominations[12]}" ContentTemplate="{StaticResource DenominationCardTemplate}"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                    </TabControl.Items>
                </TabControl>

                <!-- Кнопка закрытия -->
                <Button Grid.Row="3" 
                        Content="✖ Закрыть" 
                        Click="CloseButton_Click" 
                        Style="{StaticResource SecondaryBtn}"
                        HorizontalAlignment="Center"
                        Margin="0,10,0,0"/>
            </Grid>
        </Border>
    </Border>
</UserControl>