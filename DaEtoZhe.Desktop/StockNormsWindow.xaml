<Window x:Class="DaEtoZhe.Desktop.StockNormsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DaEtoZhe.Desktop"
        xmlns:controls="clr-namespace:DaEtoZhe.Desktop.Controls"
        Title="📦 Нормы списания" Height="560" Width="640"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BgMain}"
        Foreground="{DynamicResource TextMain}">

    <Window.Resources>
        <local:StockUnitRuConverter x:Key="UnitRu"/>
    </Window.Resources>

    <Grid Margin="18">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock x:Name="TitleText" Text="📦 Нормы списания" FontWeight="Bold" FontSize="18" Margin="0,0,0,12"/>

    <DataGrid x:Name="NormsGrid" Grid.Row="1" AutoGenerateColumns="False"
                  Background="{DynamicResource BgCard}" Foreground="{DynamicResource TextMain}"
                  BorderBrush="{DynamicResource BorderColor}" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{DynamicResource BorderColor}" RowHeight="36"
                  SelectionChanged="NormsGrid_SelectionChanged">
        <DataGrid.Columns>
            <DataGridTextColumn Header="Позиция" Binding="{Binding Item.Name}" Width="*"/>
            <DataGridTextColumn Header="Ед." Binding="{Binding Item.Unit, Converter={StaticResource UnitRu}}" Width="50"/>
            <DataGridTextColumn Header="Расход на 1 заказ" Binding="{Binding Quantity, StringFormat={}{0:0.###}}" Width="130"/>
        </DataGrid.Columns>
    </DataGrid>

    <Border Grid.Row="2" Margin="0,12,0,0" Padding="12" CornerRadius="6"
                Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <controls:CustomComboBox x:Name="ItemCombo" Header="Позиция склада"
                                             DisplayMemberPath="Name" SelectedValuePath="Id"
                                             SelectionChanged="ItemCombo_Changed"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock x:Name="QtyUnitText" FontSize="11" Opacity="0.7" Margin="0,4,0,0"/>
                    <TextBlock Text="Расход" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <TextBox x:Name="QtyTextBox" Height="42" Padding="12,0" FontSize="13"
                             PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                </StackPanel>
                <Button Grid.Column="2" Content="➕ Добавить" Style="{StaticResource PrimaryBtn}"
                        Margin="10,0,0,0" VerticalAlignment="Bottom" Click="AddNorm_Click"/>
                <Button Grid.Column="3" Content="💾 Обновить" Style="{StaticResource SuccessBtn}"
                        Margin="8,0,0,0" VerticalAlignment="Bottom" Click="UpdateNorm_Click"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
            <Button Content="🗑 Удалить норму" Style="{StaticResource DangerBtn}" Click="DeleteNorm_Click"/>
            <Button Content="✖ Закрыть" Style="{StaticResource DangerBtn}" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>