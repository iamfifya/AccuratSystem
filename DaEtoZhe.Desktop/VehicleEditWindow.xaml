<Window x:Class="DaEtoZhe.Desktop.VehicleEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DaEtoZhe.Desktop.Controls"
        Title="Карточка автомобиля"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanResize"
        Width="820" Height="780"
        Background="{DynamicResource BgMain}"
        Foreground="{DynamicResource TextMain}">

    <!-- Единый отступ содержимого окна из токена -->
    <Grid Margin="{StaticResource WindowContentMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== ЗАГОЛОВОК ОКНА ==================== -->
        <TextBlock x:Name="TitleText" Text="➕ Новый автомобиль"
                   Style="{StaticResource HeadingMediumStyle}"
                   Margin="{StaticResource CardGapMargin}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ═══ СЕКЦИЯ 1: ИДЕНТИФИКАЦИЯ ═══ -->
                <Border Style="{StaticResource CardFlatStyle}" Margin="{StaticResource ButtonMargin}">
                    <StackPanel>
                        <TextBlock Text="🚗 Идентификация" Style="{StaticResource CardHeaderStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Style="{StaticResource FormFieldStackStyle}" Margin="{StaticResource FormFieldColMargin}">
                                <TextBlock Text="VIN" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox x:Name="VinTextBox" MaxLength="17"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Style="{StaticResource FormFieldStackStyle}">
                                <TextBlock Text="Гос. номер *" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox x:Name="PlateTextBox" MaxLength="15"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Style="{StaticResource FormFieldStackStyle}" Margin="{StaticResource FormFieldColMargin}">
                                <TextBlock Text="Марка *" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox x:Name="MakeTextBox" MaxLength="50"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Style="{StaticResource FormFieldStackStyle}">
                                <TextBlock Text="Модель *" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox x:Name="ModelTextBox" MaxLength="50"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Style="{StaticResource FormFieldStackStyle}" Margin="{StaticResource FormFieldColMargin}">
                                <TextBlock Text="Год выпуска" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox x:Name="YearTextBox"
                                         PreviewTextInput="NumericOnly_PreviewTextInput"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Style="{StaticResource FormFieldStackStyle}">
                                <TextBlock Text="Пробег, км" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox x:Name="MileageTextBox"
                                         PreviewTextInput="NumericOnly_PreviewTextInput"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0" Style="{StaticResource FormFieldStackStyle}" Margin="{StaticResource FormFieldColMargin}">
                                <TextBlock Text="Цвет" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox x:Name="ColorTextBox" MaxLength="30"/>
                            </StackPanel>
                            <!-- Комбобоксы: метка через встроенный Header, выравнивание по нижней границе ряда -->
                            <controls:CustomComboBox Grid.Row="3" Grid.Column="1"
                                                     x:Name="EngineTypeCombo" Header="Двигатель"
                                                     VerticalAlignment="Bottom"
                                                     Margin="{StaticResource HFieldGapMargin}">
                                <ComboBoxItem Content="Бензин"/>
                                <ComboBoxItem Content="Дизель"/>
                                <ComboBoxItem Content="Гибрид"/>
                                <ComboBoxItem Content="Электро"/>
                                <ComboBoxItem Content="Газ"/>
                            </controls:CustomComboBox>

                            <StackPanel Grid.Row="4" Grid.Column="0" Style="{StaticResource FormFieldStackStyle}" Margin="{StaticResource FormFieldColMargin}">
                                <TextBlock Text="Объём двигателя, л" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox x:Name="EngineVolumeTextBox"
                                         PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                            </StackPanel>
                            <controls:CustomComboBox Grid.Row="4" Grid.Column="1"
                                                     x:Name="TransmissionCombo" Header="КПП"
                                                     VerticalAlignment="Bottom"
                                                     Margin="{StaticResource HFieldGapMargin}">
                                <ComboBoxItem Content="АКПП"/>
                                <ComboBoxItem Content="МКПП"/>
                                <ComboBoxItem Content="Робот"/>
                                <ComboBoxItem Content="Вариатор"/>
                            </controls:CustomComboBox>

                            <controls:CustomComboBox Grid.Row="5" Grid.Column="0"
                                                     x:Name="BranchCombo" Header="Филиал (где стоит)"
                                                     DisplayMemberPath="Name" SelectedValuePath="Id"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══ СЕКЦИЯ 2: ПОКУПКА ═══ -->
                <Border Style="{StaticResource CardFlatStyle}" Margin="{StaticResource ButtonMargin}">
                    <StackPanel>
                        <TextBlock Text="💰 Покупка (продавец — физлицо, данные для ДКП)"
                                   Style="{StaticResource CardHeaderStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Style="{StaticResource FormFieldStackStyle}" Margin="{StaticResource FormFieldColMargin}">
                                <TextBlock Text="Цена покупки, ₽" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox x:Name="PurchasePriceTextBox"
                                         PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Style="{StaticResource FormFieldStackStyle}">
                                <TextBlock Text="ФИО продавца" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox x:Name="SellerNameTextBox" MaxLength="150"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Style="{StaticResource FormFieldStackStyle}" Margin="{StaticResource FormFieldColLastMargin}">
                                <TextBlock Text="Телефон продавца" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox x:Name="SellerPhoneTextBox" MaxLength="20"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Style="{StaticResource FormFieldStackStyle}">
                                <TextBlock Text="Паспорт (серия + номер)" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox x:Name="SellerPassportTextBox" MaxLength="50"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══ СЕКЦИЯ 3: РЕМОНТ И ПРОДАЖА ═══ -->
                <Border x:Name="RepairSection" Style="{StaticResource CardFlatStyle}" Margin="{StaticResource ButtonMargin}"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="🔧 Ремонт и продажа" Style="{StaticResource CardHeaderStyle}"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Style="{StaticResource FormFieldStackStyle}" Margin="{StaticResource FormFieldColMargin}">
                                <TextBlock Text="Запчасти, ₽" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox x:Name="PartsCostTextBox"
                                         PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Style="{StaticResource FormFieldStackStyle}">
                                <TextBlock Text="Работы, ₽" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox x:Name="LaborCostTextBox"
                                         PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Style="{StaticResource FormFieldStackStyle}">
                                <TextBlock Text="Цена в объявлении, ₽" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox x:Name="ListingPriceTextBox"
                                         PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Style="{StaticResource FormFieldStackStyle}" Margin="{StaticResource FormFieldColLastMargin}">
                                <TextBlock Text="Цена продажи, ₽" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox x:Name="SalePriceTextBox"
                                         PreviewTextInput="DecimalOnly_PreviewTextInput"
                                         TextChanged="Money_TextChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Style="{StaticResource FormFieldStackStyle}">
                                <TextBlock Text="Маржа (продажа − покупка − ремонт)" Style="{StaticResource FormLabelStyle}"/>
                                <TextBlock x:Name="MarginLabel" Text="0 ₽"
                                           Style="{StaticResource StatValueStyle}"
                                           FontSize="{DynamicResource FontSizeHeadingMD}"
                                           Foreground="{DynamicResource AccentGreen}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Примечания по ремонту -->
                        <TextBlock Text="Что сделано / примечания по ремонту"
                                   Style="{StaticResource FormLabelStyle}"
                                   Margin="{StaticResource FormSectionTopMargin}"/>
                        <TextBox x:Name="RepairNotesTextBox"
                                 Style="{StaticResource MultilineTextBoxSmallStyle}"
                                 Margin="{StaticResource FormFieldMargin}"/>

                        <!-- Данные покупателя для ДКП -->
                        <TextBlock Text="🧾 Покупатель (физлицо, данные для ДКП)"
                                   Style="{StaticResource HeadingSmallStyle}"
                                   Margin="{StaticResource FormSectionTopMargin},0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Style="{StaticResource FormFieldStackStyle}" Margin="{StaticResource FormFieldColLastMargin}">
                                <TextBlock Text="ФИО покупателя" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox x:Name="BuyerNameTextBox" MaxLength="150"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Style="{StaticResource FormFieldStackStyle}">
                                <TextBlock Text="Телефон" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox x:Name="BuyerPhoneTextBox" MaxLength="20"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Style="{StaticResource FormFieldStackStyle}">
                                <TextBlock Text="Паспорт" Style="{StaticResource FormLabelStyle}"/>
                                <TextBox x:Name="BuyerPassportTextBox" MaxLength="50"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══ СЕКЦИЯ 4: ДЕФЕКТЫ И ЗАМЕТКИ ═══ -->
                <Border Style="{StaticResource CardFlatStyle}" Margin="{StaticResource CardGapMargin}">
                    <StackPanel>
                        <TextBlock Text="⚠️ Дефекты (осмотр при приёмке)"
                                   Style="{StaticResource CardHeaderStyle}"
                                   Margin="0,0,0,8"/>
                        <TextBox x:Name="DefectsTextBox"
                                 Style="{StaticResource MultilineTextBoxStyle}"
                                 MinHeight="70"
                                 Margin="{StaticResource FormFieldMargin}"/>
                        <TextBlock Text="Общие заметки" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox x:Name="NotesTextBox"
                                 Style="{StaticResource MultilineTextBoxSmallStyle}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ==================== ФУТЕР: КНОПКИ ДЕЙСТВИЙ ==================== -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center"
                    Margin="{StaticResource FormSectionTopMargin}">
            <Button Content="💾 Сохранить" Style="{StaticResource SuccessBtn}" Click="Save_Click"
                    Margin="{StaticResource ButtonRowGapMargin}"/>
            <Button Content="✖ Отмена" Style="{StaticResource DangerBtn}" Click="Cancel_Click"
                    Margin="0"/>
        </StackPanel>
    </Grid>
</Window>
