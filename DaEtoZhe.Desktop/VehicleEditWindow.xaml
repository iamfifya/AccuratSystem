<Window x:Class="DaEtoZhe.Desktop.VehicleEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Карточка автомобиля"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Width="780" Height="720"
        Background="{DynamicResource BgMain}"
        Foreground="{DynamicResource TextMain}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Text="➕ Новый автомобиль"
                   FontSize="22" FontWeight="Bold" Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ═══ СЕКЦИЯ 1: ИДЕНТИФИКАЦИЯ ═══ -->
                <Border Background="{DynamicResource BgCard}" CornerRadius="6" Padding="15"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="🚗 Идентификация" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                                <TextBlock Text="VIN" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                <TextBox x:Name="VinTextBox" Height="36" Padding="10,0" MaxLength="17"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,10">
                                <TextBlock Text="Гос. номер *" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                <TextBox x:Name="PlateTextBox" Height="36" Padding="10,0" MaxLength="15"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
                                <TextBlock Text="Марка *" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                <TextBox x:Name="MakeTextBox" Height="36" Padding="10,0" MaxLength="50"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,10">
                                <TextBlock Text="Модель *" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                <TextBox x:Name="ModelTextBox" Height="36" Padding="10,0" MaxLength="50"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,10">
                                <TextBlock Text="Год выпуска" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                <TextBox x:Name="YearTextBox" Height="36" Padding="10,0"
                                         PreviewTextInput="NumericOnly_PreviewTextInput"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="10,0,0,10">
                                <TextBlock Text="Пробег, км" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                <TextBox x:Name="MileageTextBox" Height="36" Padding="10,0"
                                         PreviewTextInput="NumericOnly_PreviewTextInput"/>
                            </StackPanel>

                            <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,10,10">
                                <TextBlock Text="Цвет" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                <TextBox x:Name="ColorTextBox" Height="36" Padding="10,0" MaxLength="30"/>
                            </StackPanel>
                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="10,0,0,10">
                                <TextBlock Text="Двигатель" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="EngineTypeCombo" Height="36" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="Бензин"/>
                                    <ComboBoxItem Content="Дизель"/>
                                    <ComboBoxItem Content="Гибрид"/>
                                    <ComboBoxItem Content="Электро"/>
                                    <ComboBoxItem Content="Газ"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="4" Grid.Column="0" Margin="0,0,10,10">
                                <TextBlock Text="Объём двигателя, л" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                <TextBox x:Name="EngineVolumeTextBox" Height="36" Padding="10,0"
                                         PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                            </StackPanel>
                            <StackPanel Grid.Row="4" Grid.Column="1" Margin="10,0,0,10">
                                <TextBlock Text="КПП" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="TransmissionCombo" Height="36" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="АКПП"/>
                                    <ComboBoxItem Content="МКПП"/>
                                    <ComboBoxItem Content="Робот"/>
                                    <ComboBoxItem Content="Вариатор"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Row="5" Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Филиал (где стоит)" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                <ComboBox x:Name="BranchCombo" Height="36"
                                          DisplayMemberPath="Name" SelectedValuePath="Id"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══ СЕКЦИЯ 2: ПОКУПКА (продавец-физлицо) ═══ -->
                <Border Background="{DynamicResource BgCard}" CornerRadius="6" Padding="15"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="💰 Покупка (продавец — физлицо, данные для ДКП)" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                                <TextBlock Text="Цена покупки, ₽" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                <TextBox x:Name="PurchasePriceTextBox" Height="36" Padding="10,0"
                                         PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,10">
                                <TextBlock Text="ФИО продавца" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                <TextBox x:Name="SellerNameTextBox" Height="36" Padding="10,0" MaxLength="150"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Телефон продавца" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                <TextBox x:Name="SellerPhoneTextBox" Height="36" Padding="10,0" MaxLength="20"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Паспорт (серия + номер)" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                <TextBox x:Name="SellerPassportTextBox" Height="36" Padding="10,0" MaxLength="50"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══ СЕКЦИЯ 3: РЕМОНТ И ПРОДАЖА (только режим редактирования) ═══ -->
                <Border x:Name="RepairSection" Background="{DynamicResource BgCard}" CornerRadius="6" Padding="15"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Margin="0,0,0,12"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="🔧 Ремонт и продажа" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,8,10">
                                <TextBlock Text="Запчасти, ₽" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                <TextBox x:Name="PartsCostTextBox" Height="36" Padding="10,0"
                                         PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="8,0,8,10">
                                <TextBlock Text="Работы, ₽" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                <TextBox x:Name="LaborCostTextBox" Height="36" Padding="10,0"
                                         PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="8,0,0,10">
                                <TextBlock Text="Цена в объявлении, ₽" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                <TextBox x:Name="ListingPriceTextBox" Height="36" Padding="10,0"
                                         PreviewTextInput="DecimalOnly_PreviewTextInput"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="Цена продажи, ₽" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                <TextBox x:Name="SalePriceTextBox" Height="36" Padding="10,0"
                                         PreviewTextInput="DecimalOnly_PreviewTextInput"
                                         TextChanged="Money_TextChanged"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Margin="8,0,0,0">
                                <TextBlock Text="Маржа (продажа − покупка − ремонт)" FontSize="12"
                                           Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                <TextBlock x:Name="MarginLabel" Text="0 ₽" FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentGreen}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Что сделано / примечания по ремонту" FontSize="12"
                                   Foreground="{DynamicResource TextMuted}" Margin="0,10,0,4"/>
                        <TextBox x:Name="RepairNotesTextBox" Height="60" Padding="10,6"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

                        <TextBlock Text="🧾 Покупатель (физлицо, данные для ДКП)" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                <TextBlock Text="ФИО покупателя" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                <TextBox x:Name="BuyerNameTextBox" Height="36" Padding="10,0" MaxLength="150"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                <TextBlock Text="Телефон" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                <TextBox x:Name="BuyerPhoneTextBox" Height="36" Padding="10,0" MaxLength="20"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Margin="8,0,0,0">
                                <TextBlock Text="Паспорт" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                                <TextBox x:Name="BuyerPassportTextBox" Height="36" Padding="10,0" MaxLength="50"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ═══ СЕКЦИЯ 4: ДЕФЕКТЫ И ЗАМЕТКИ ═══ -->
                <Border Background="{DynamicResource BgCard}" CornerRadius="6" Padding="15"
                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="⚠️ Дефекты (осмотр при приёмке)" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
                        <TextBox x:Name="DefectsTextBox" Height="70" Padding="10,6"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        <TextBlock Text="Общие заметки" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,10,0,4"/>
                        <TextBox x:Name="NotesTextBox" Height="50" Padding="10,6"
                                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="💾 Сохранить" Style="{StaticResource SuccessBtn}" Click="Save_Click"/>
            <Button Content="✖ Отмена" Style="{StaticResource DangerBtn}" Click="Cancel_Click"/>
        </StackPanel>
    </Grid>
</Window>