<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:DaEtoZhe.Desktop.Models"
                    xmlns:controls="clr-namespace:DaEtoZhe.Desktop.Controls">

    <!-- ==================== ORDER CARD ==================== -->
    <Style x:Key="OrderCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BgCard}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{DynamicResource RadiusMD}"/>
        <Setter Property="Padding" Value="15"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Effect" Value="{DynamicResource CardShadow}"/>
        <Style.Triggers>
            <!-- Предварительная запись -->
            <DataTrigger Binding="{Binding IsAppointment}" Value="True">
                <Setter Property="Background" Value="{DynamicResource BgAppointment}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderAppointment}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </DataTrigger>

            <!-- Карточка выбрана -->
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource BgSelected}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </DataTrigger>

            <!-- Выбрана + запись -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsSelected}" Value="True"/>
                    <Condition Binding="{Binding IsAppointment}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource BgAppointmentSelected}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentOrange}"/>
                <Setter Property="BorderThickness" Value="1"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ==================== ORDER TEMPLATE ==================== -->
    <DataTemplate x:Key="OrderTemplate" DataType="{x:Type models:OrderDisplayItem}">
        <Border Style="{StaticResource OrderCardBorderStyle}"
                controls:OrderDragBehavior.IsEnabled="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CarNumber}"
                                   FontSize="{DynamicResource FontSizeXL}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMain}"
                                   VerticalAlignment="Center"/>

                        <Path Width="13"
                              Height="13"
                              Margin="7,0,0,0"
                              Stretch="Fill"
                              Fill="{DynamicResource AccentOrange}"
                              VerticalAlignment="Center"
                              ToolTip="Предварительная запись"
                              Data="M3,2 L5,2 L5,0 L7,0 L7,2 L13,2 L13,0 L15,0 L15,2 L17,2 C18.1,2 19,2.9 19,4 L19,17 C19,18.1 18.1,19 17,19 L3,19 C1.9,19 1,18.1 1,17 L1,4 C1,2.9 1.9,2 3,2 Z M3,6 L17,6 L17,17 L3,17 Z"
                              Visibility="{Binding IsAppointment, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{Binding Time, StringFormat={}{0:HH:mm}}"
                               FontSize="{DynamicResource FontSizeLG}"
                               FontWeight="Medium"
                               Foreground="{DynamicResource TextMuted}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                </Grid>

                <TextBlock Grid.Row="1"
                           Text="{Binding CarModel}"
                           FontSize="{DynamicResource FontSizeLG}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMain}"
                           Margin="0,0,0,4"/>

                <TextBlock Grid.Row="2" Margin="0,0,0,4">
                    <Run Text="Мойщик: "
                         Foreground="{DynamicResource TextLightMuted}"
                         FontSize="{DynamicResource FontSizeSM}"/>
                    <Run Text="{Binding WasherName}"
                         FontWeight="Medium"
                         FontSize="{DynamicResource FontSizeSM}"
                         Foreground="{DynamicResource TextMain}"/>
                </TextBlock>

                <TextBlock Grid.Row="3"
                           Text="{Binding ServicesList}"
                           FontSize="{DynamicResource FontSizeSM}"
                           Foreground="{DynamicResource TextMuted}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,8"
                           MaxWidth="340"
                           HorizontalAlignment="Left"/>

                <Separator Grid.Row="4"
                           Background="{DynamicResource SeparatorColor}"
                           Margin="0,2,0,10"/>

                <!-- Price + status -->
                <Grid Grid.Row="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding OriginalPriceDisplay}"
                                   FontSize="{DynamicResource FontSizeXS}"
                                   Foreground="{DynamicResource TextLightMuted}"
                                   TextDecorations="Strikethrough"
                                   Visibility="{Binding ShowOriginalPrice, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <TextBlock Text="{Binding FinalPrice, StringFormat={}{0:N0} ₽}"
                                   FontSize="{DynamicResource FontSizeLG}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentGreen}"/>

                        <TextBlock Text="{Binding DiscountDisplay}"
                                   FontSize="{DynamicResource FontSizeXS}"
                                   Foreground="{DynamicResource AccentRed}"
                                   FontWeight="SemiBold"
                                   Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}"
                                   Margin="0,2,0,0"/>

                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <Path Width="13"
                                  Height="9"
                                  Stretch="Fill"
                                  Fill="{DynamicResource AccentBlue}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,5,0"
                                  Data="M2,0 L18,0 C19.1,0 20,0.9 20,2 L20,10 C20,11.1 19.1,12 18,12 L2,12 C0.9,12 0,11.1 0,10 L0,2 C0,0.9 0.9,0 2,0 Z M0,3 L20,3 L20,5 L0,5 Z"/>
                            <TextBlock Text="{Binding PaymentMethod}"
                                       FontSize="{DynamicResource FontSizeXS}"
                                       Foreground="{DynamicResource AccentBlue}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">
                        <Border Background="{Binding StatusColorHex, Converter={StaticResource HexToBrushConverter}}"
                                CornerRadius="{DynamicResource RadiusXS}"
                                Padding="7,3">
                            <TextBlock Text="{Binding Status}"
                                       Foreground="{DynamicResource TextOnAccent}"
                                       FontSize="{DynamicResource FontSizeXS}"
                                       FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock Text="{Binding TimeInStatus}"
                                   FontSize="{DynamicResource FontSizeXS}"
                                   Foreground="{DynamicResource TextMuted}"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Right"
                                   Margin="0,3,0,0"
                                   Visibility="{Binding TimeInStatus, Converter={StaticResource ZeroToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>

                <!-- Доплаты -->
                <StackPanel Grid.Row="6"
                            Orientation="Horizontal"
                            Margin="0,8,0,0"
                            Visibility="{Binding ExtraCost, Converter={StaticResource ZeroToVisibilityConverter}}">
                    <Path Width="11"
                          Height="11"
                          Stretch="Fill"
                          Fill="{DynamicResource AccentOrange}"
                          VerticalAlignment="Top"
                          Margin="0,3,6,0"
                          Data="M9,1 L11,1 L11,9 L19,9 L19,11 L11,11 L11,19 L9,19 L9,11 L1,11 L1,9 L9,9 Z"/>
                    <StackPanel>
                        <TextBlock Text="{Binding ExtraCost, StringFormat={}{0:N0} ₽}"
                                   FontSize="{DynamicResource FontSizeSM}"
                                   Foreground="{DynamicResource AccentOrange}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ExtraCostReason}"
                                   FontSize="{DynamicResource FontSizeXS}"
                                   Foreground="{DynamicResource AccentOrange}"
                                   TextWrapping="Wrap"
                                   FontStyle="Italic"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>

    <!-- Неявный шаблон для OrderDisplayItem -->
    <DataTemplate DataType="{x:Type models:OrderDisplayItem}">
        <ContentPresenter Content="{Binding}"
                          ContentTemplate="{StaticResource OrderTemplate}"/>
    </DataTemplate>

    <!-- ==================== CLEAN LISTBOX ==================== -->
    <Style x:Key="CleanListBoxStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PaymentStatGridStyle" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

</ResourceDictionary>
