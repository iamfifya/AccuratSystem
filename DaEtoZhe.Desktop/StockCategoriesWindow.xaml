<Window x:Class="DaEtoZhe.Desktop.StockCategoriesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🏷 Категории склада" Height="450" Width="420"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BgMain}"
        Foreground="{DynamicResource TextMain}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="🏷 Категории номенклатуры" FontWeight="Bold" FontSize="18" Margin="0,0,0,16"/>

        <!-- Обернули ListBox в Border для скруглений, как в остальных карточках -->
        <Border Grid.Row="1" Background="{DynamicResource BgCard}" 
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="2" CornerRadius="6">
            <ListBox x:Name="CategoriesList" DisplayMemberPath="Name"
         SelectionChanged="CategoriesList_SelectionChanged"
         Margin="2"
         Background="Transparent" BorderThickness="0">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Border"
                                Background="Transparent"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                Margin="{TemplateBinding Margin}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentBlue}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource BgSelected}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Убраны Height и Padding, так как они заданы в AppStyles.xaml -->
            <TextBox x:Name="NameTextBox"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                <Button Content="💾" Style="{StaticResource SuccessBtn}" Click="Save_Click" ToolTip="Создать / переименовать"/>
                <Button Content="🗑" Style="{StaticResource DangerBtn}" Click="Delete_Click" ToolTip="Удалить (если не используется)"/>
            </StackPanel>
        </Grid>

        <Button Grid.Row="3" Content="✖ Закрыть" Style="{StaticResource DangerBtn}"
                HorizontalAlignment="Center" Click="Close_Click"/>
    </Grid>
</Window>