<Window x:Class="DaEtoZhe.Desktop.VehiclesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DaEtoZhe.Desktop.Controls"
        xmlns:local="clr-namespace:DaEtoZhe.Desktop"
        Title="🚗 Авто под ремонт и продажу"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        ResizeMode="CanResize"
        MinWidth="1200" MinHeight="700"
        Width="1400" Height="850"
        Background="{DynamicResource BgMain}"
        BorderBrush="{DynamicResource BorderColor}"
        BorderThickness="1"
        Foreground="{DynamicResource TextMain}">

    <!-- Единый отступ содержимого окна берём из токена WindowContentMargin -->
    <Grid Margin="{StaticResource WindowContentMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ==================== 1. ЗАГОЛОВОК СТРАНИЦЫ ==================== -->
        <StackPanel Grid.Row="0" Margin="{StaticResource CardGapMargin}">
            <TextBlock Text="🚗 Авто под ремонт и продажу"
                       Style="{StaticResource HeadingLargeStyle}"/>
            <TextBlock Text="Управление автомобилями для ремонта и перепродажи"
                       Style="{StaticResource TextSecondaryStyle}"
                       Margin="{StaticResource PageTitleMargin}"/>
        </StackPanel>

        <!-- ==================== 2. ФИЛЬТРЫ И ДЕЙСТВИЯ ==================== -->
        <Border Grid.Row="1"
                Style="{StaticResource CardFlatStyle}"
                Margin="{StaticResource CardGapMargin}">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Фильтр статуса: используем встроенный Header кастомного комбобокса -->
                <controls:CustomComboBox x:Name="StatusFilter"
                                         Grid.Column="0"
                                         Header="Статус"
                                         SelectionChanged="StatusFilter_SelectionChanged">
                    <ComboBoxItem Content="Все статусы" Tag=""/>
                    <ComboBoxItem Content="Новый" Tag="0"/>
                    <ComboBoxItem Content="Куплен" Tag="1"/>
                    <ComboBoxItem Content="Оценен" Tag="2"/>
                    <ComboBoxItem Content="В ремонте" Tag="3"/>
                    <ComboBoxItem Content="Предпродажная подготовка" Tag="4"/>
                    <ComboBoxItem Content="Выставлен на продажу" Tag="5"/>
                    <ComboBoxItem Content="Зарезервирован" Tag="6"/>
                    <ComboBoxItem Content="Продан" Tag="7"/>
                    <ComboBoxItem Content="Списан" Tag="8"/>
                </controls:CustomComboBox>

                <!-- Поиск: метка сверху, выровнена по нижней границе с полем комбобокса -->
                <StackPanel Grid.Column="1"
                            Style="{StaticResource FormFieldStackStyle}"
                            Margin="{StaticResource ControlGapLGMargin}"
                            VerticalAlignment="Bottom">
                    <TextBlock Text="Поиск" Style="{StaticResource FormLabelStyle}"/>
                    <TextBox x:Name="SearchBox"
                             TextChanged="SearchBox_TextChanged"/>
                </StackPanel>

                <!-- Кнопки действий: прижаты к правому краю, одинаковые зазоры из токенов -->
                <!-- Сбрасываем базовый ButtonMargin (0,0,8,8), чтобы ряд кнопок не «прыгал»
                     относительно полей фильтра — зазор задаём только горизонтальным токеном -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="➕ Добавить авто"
                            Click="AddVehicle_Click"
                            Style="{StaticResource PrimaryBtn}"
                            Margin="{StaticResource ButtonRowGapMargin}"/>
                    <Button Content="🔄 Обновить"
                            Click="RefreshButton_Click"
                            Style="{StaticResource SecondaryBtn}"
                            Margin="{StaticResource ButtonRowGapMargin}"/>
                    <Button Content="✖ Закрыть"
                            Click="CloseButton_Click"
                            Style="{StaticResource DangerBtn}"
                            Margin="0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 3. КАРТОЧКИ АВТО ==================== -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="VehiclesItemsControl">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardInteractiveStyle}"
                                Width="{StaticResource CardListWidth}"
                                Margin="{StaticResource ButtonMargin}">
                            <StackPanel>
                                <!-- Шапка карточки: марка/модель + бейдж статуса -->
                                <Grid Style="{StaticResource SectionBlockStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Make}" Style="{StaticResource HeadingSmallStyle}"/>
                                        <TextBlock Text="{Binding Model}" Style="{StaticResource TextSecondaryStyle}"/>
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Style="{StaticResource BadgeStyle}"
                                            Background="{Binding Status, Converter={StaticResource VehicleStatusToColorConverter}}">
                                        <TextBlock Text="{Binding Status, Converter={StaticResource VehicleStatusToTextConverter}}"
                                                   Style="{StaticResource BadgeTextStyle}"/>
                                    </Border>
                                </Grid>

                                <!-- Основные детали авто -->
                                <Grid Style="{StaticResource SectionBlockStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Гос. номер:" Style="{StaticResource TextSecondaryStyle}"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding LicensePlate}" Style="{StaticResource TextPrimaryStyle}" FontWeight="Bold"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Год / Пробег:" Style="{StaticResource TextSecondaryStyle}" Margin="{StaticResource FormLabelMargin}"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource TextPrimaryStyle}" Margin="{StaticResource FormLabelMargin}">
                                        <Run Text="{Binding Year}"/>
                                        <Run Text=" г., "/>
                                        <Run Text="{Binding Mileage, StringFormat=N0}"/>
                                        <Run Text=" км"/>
                                    </TextBlock>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Цена продажи:" Style="{StaticResource TextSecondaryStyle}" Margin="{StaticResource FormLabelMargin}"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ListingPrice, StringFormat={}{0:N0} ₽}"
                                               Style="{StaticResource TextPrimaryStyle}"
                                               Foreground="{DynamicResource AccentGreen}"
                                               FontWeight="Bold"
                                               Margin="{StaticResource FormLabelMargin}"/>
                                </Grid>

                                <!-- VIN и дата покупки -->
                                <DockPanel Style="{StaticResource SectionBlockStyle}">
                                    <TextBlock Text="{Binding Vin, StringFormat=VIN: {0}}" Style="{StaticResource TextCaptionStyle}"/>
                                    <TextBlock Text="{Binding PurchaseDate, StringFormat=от dd.MM.yyyy}" Style="{StaticResource TextCaptionStyle}" DockPanel.Dock="Right"/>
                                </DockPanel>

                                <!-- Кнопки действий карточки (IconButtonStyle + токен-зазоры) -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="✏️" ToolTip="Редактировать" Click="EditVehicle_Click"
                                            Style="{StaticResource IconButtonStyle}" Margin="{StaticResource ButtonGapMargin}"/>
                                    <Button Content="📋" ToolTip="Приёмка" Click="Acceptance_Click"
                                            Style="{StaticResource IconButtonStyle}" Margin="{StaticResource ButtonGapMargin}"/>
                                    <Button Content="🔧" ToolTip="Ремонт" Click="Repair_Click"
                                            Style="{StaticResource IconButtonStyle}" Margin="{StaticResource ButtonGapMargin}"/>
                                    <Button Content="🔄" ToolTip="Статус" Click="ChangeStatus_Click"
                                            Style="{StaticResource IconButtonStyle}" Margin="{StaticResource ButtonGapMargin}"/>
                                    <Button Content="🗑️" ToolTip="Удалить" Click="DeleteVehicle_Click"
                                            Style="{StaticResource IconButtonStyle}"
                                            Foreground="{DynamicResource AccentRed}"
                                            Margin="0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- ==================== 4. СТАТИСТИКА ==================== -->
        <Border Grid.Row="3"
                Style="{StaticResource StatCard}"
                Margin="{StaticResource FormSectionTopMargin}">
            <UniformGrid Columns="5">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Всего авто" Style="{StaticResource FilterLabelStyle}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TotalCountText" Style="{StaticResource StatMetricStyle}"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="В ремонте" Style="{StaticResource FilterLabelStyle}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="InRepairCountText" Style="{StaticResource StatMetricStyle}" Foreground="{DynamicResource AccentOrange}"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="На продаже" Style="{StaticResource FilterLabelStyle}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ForSaleCountText" Style="{StaticResource StatMetricStyle}" Foreground="{DynamicResource AccentBlue}"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Продано" Style="{StaticResource FilterLabelStyle}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="SoldCountText" Style="{StaticResource StatMetricStyle}" Foreground="{DynamicResource AccentGreen}"/>
                </StackPanel>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="Общая маржа" Style="{StaticResource FilterLabelStyle}" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="TotalMarginText" Style="{StaticResource StatMetricStyle}" Foreground="{DynamicResource AccentGreen}"/>
                </StackPanel>
            </UniformGrid>
        </Border>
    </Grid>
</Window>
