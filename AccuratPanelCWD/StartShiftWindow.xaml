<Window x:Class="AccuratPanelCWD.StartShiftWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AccuratPanelCWD"
        mc:Ignorable="d"
        Title="Начать смену"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Width="700" Height="850"
        Background="{DynamicResource BgMain}"
        BorderBrush="{DynamicResource BorderColor}"
        BorderThickness="1"
        WindowStyle="None"
        Foreground="{DynamicResource TextMain}">

    <Window.Resources>
        <!-- Стиль больших кнопок выбора типа смены -->
        <Style x:Key="ShiftTypeButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="110"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="10">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.15" Color="#000000"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Border" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="🚗 Новая смена" 
                   FontSize="26" 
                   FontWeight="Bold" 
                   Foreground="{DynamicResource TextMain}" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,25"/>

        <!-- =================================================================== -->
        <!-- ШАГ 1: ВЫБОР ТИПА СМЕНЫ -->
        <!-- =================================================================== -->
        <StackPanel x:Name="ShiftTypePanel" 
                    Grid.Row="1" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center">
            <TextBlock Text="Выберите тип смены:" 
                       FontSize="19" 
                       FontWeight="SemiBold" 
                       Foreground="{DynamicResource TextMain}" 
                       HorizontalAlignment="Center" 
                       Margin="0,0,0,25"/>

            <UniformGrid Columns="2" Width="450">
                <Button x:Name="DayShiftBtn" 
                        Content="☀️ Дневная" 
                        Click="ShiftType_Click" 
                        Style="{StaticResource ShiftTypeButtonStyle}"
                        Background="{DynamicResource AccentBlue}"/>

                <Button x:Name="NightShiftBtn" 
                        Content="🌙 Ночная" 
                        Click="ShiftType_Click" 
                        Style="{StaticResource ShiftTypeButtonStyle}"
                        Background="{DynamicResource TextMain}"/>
            </UniformGrid>

            <Button x:Name="ContinueToEmployeesBtn" 
                    Content="Далее ➡️" 
                    Click="ContinueToEmployees_Click" 
                    Style="{StaticResource SuccessBtn}"
                    Width="250"
                    Margin="0,35,0,0" 
                    FontSize="16"
                    IsEnabled="False"/>
        </StackPanel>

        <!-- =================================================================== -->
        <!-- ШАГ 2: ВЫБОР СОТРУДНИКОВ -->
        <!-- =================================================================== -->
        <Grid x:Name="EmployeeSelectionPanel" Grid.Row="1" Visibility="Collapsed">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,10,10">
                    <TextBlock Text="📅 Дата смены" 
                               FontSize="13" 
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMain}"
                               Margin="0,0,0,8"/>

                    <VirtualizingStackPanel HorizontalAlignment="Center">
                        <local:CustomDatePicker x:Name="ShiftDatePicker" 
                                                Height="45" 
                                                Width="350"
                                                SelectedDate="{Binding SelectedDate, Mode=TwoWay}"/>
                    </VirtualizingStackPanel>

                    <TextBlock Text="🔍 Поиск сотрудника" 
                               FontSize="13" 
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMain}"
                               Margin="0,20,0,8"/>
                    <TextBox x:Name="EmployeeSearchTextBox"
                             Height="45" 
                             Padding="15,0"
                             FontSize="14"
                             Margin="0,0,0,20"
                             TextChanged="EmployeeSearchTextBox_TextChanged"/>

                    <TextBlock Text="👥 Выберите сотрудников" 
                               FontSize="13" 
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMain}"
                               Margin="0,0,0,8"/>

                    <ListBox x:Name="EmployeesListBox" 
                             Margin="0,0,0,10"
                             ItemsSource="{Binding Employees}" 
                             SelectionMode="Multiple"
                             Background="{DynamicResource BgCard}"
                             BorderBrush="{DynamicResource BorderColor}"
                             BorderThickness="1"
                             Foreground="{DynamicResource TextMain}">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="12,10"/>
                                <Setter Property="MinHeight" Value="45"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Border"
                                                    Background="{DynamicResource BgCard}"
                                                    BorderBrush="{DynamicResource BorderColor}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}"
                                                    Margin="{TemplateBinding Margin}">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource TableRowHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentBlue}"/>
                                                    <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding FullName}" 
                                               Grid.Column="0" 
                                               VerticalAlignment="Center" 
                                               TextWrapping="Wrap"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/>
                                    <TextBlock Text="{Binding RoleDisplay}" 
                                               Grid.Column="1" 
                                               VerticalAlignment="Center" 
                                               Margin="15,0,0,0"
                                               FontSize="12" 
                                               Opacity="0.75"
                                               Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Кнопки внизу -->
        <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Grid.Row="2" 
                    Margin="0,20,0,15">
            <Button x:Name="StartShiftButton" 
                    Content="✅ Начать смену" 
                    Click="StartShiftButton_Click" 
                    Style="{StaticResource SuccessBtn}"
                    Margin="0,0,10,0"
                    FontSize="14"
                    Visibility="Collapsed"/>
            <Button Content="✖ Отмена" 
                    Click="CloseButton_Click" 
                    Style="{StaticResource DangerBtn}"
                    FontSize="14"/>
        </StackPanel>
    </Grid>
</Window>