<Window x:Class="AccuratPanelCWD.MainWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AccuratPanelCWD"
        xmlns:controls="clr-namespace:AccuratPanelCWD.Controls"
        xmlns:models="clr-namespace:AccuratPanelCWD.Models"
        mc:Ignorable="d"
        Title="AccuratSystem - Панель управления" 
        Width="1920" Height="1080"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource BgMain}"
        BorderBrush="{DynamicResource BorderColor}"
        BorderThickness="1"
        WindowStyle="None"
        Foreground="{DynamicResource TextMain}"
        Focusable="True">

    <Grid>
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 1. ТАБЫ ФИЛИАЛОВ -->
            <TabControl Grid.Row="0" 
                        ItemsSource="{Binding BranchTabs}" 
                        SelectedItem="{Binding SelectedBranchTab, Mode=TwoWay}"
                        Margin="0,0,0,10">
                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                        <Setter Property="Padding" Value="10,5"/>
                    </Style>
                </TabControl.ItemContainerStyle>
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding BranchName}" FontSize="12" FontWeight="Bold"/>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate/>
                </TabControl.ContentTemplate>
            </TabControl>

            <!-- 2. ВЕРХНЯЯ ПАНЕЛЬ -->
            <Grid Grid.Row="1" Margin="10,0,10,10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border CornerRadius="6" 
                        Padding="10" 
                        Background="Transparent" 
                        BorderBrush="{DynamicResource BorderColor}" 
                        BorderThickness="1" 
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Главная страница" 
                                       FontSize="22" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource TextMain}" 
                                       VerticalAlignment="Center"/>
                            <TextBlock Text=" | " 
                                       FontSize="20" 
                                       Foreground="{DynamicResource TextLightMuted}" 
                                       VerticalAlignment="Center" 
                                       Margin="5,0"/>
                            <TextBlock Text="{Binding CurrentShiftInfo}" 
                                       FontSize="16" 
                                       Foreground="{DynamicResource TextMuted}" 
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <Border Grid.Column="1" 
                                CornerRadius="6" 
                                Background="Transparent" 
                                BorderBrush="{DynamicResource BorderColor}" 
                                BorderThickness="1" 
                                Padding="5">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{DynamicResource AccentBlue}" 
                                        CornerRadius="6" 
                                        Width="36" 
                                        Height="36" 
                                        Margin="0,0,10,0">
                                    <TextBlock Text="👤" 
                                               FontSize="18" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,15,0">
                                    <TextBlock Text="{Binding ActiveUserInfo}" 
                                               FontSize="13" 
                                               FontWeight="SemiBold" 
                                               Foreground="{DynamicResource TextMain}"/>
                                    <TextBlock Text="{Binding CurrentBranchDisplay}" 
                                               FontSize="11" 
                                               Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                                <Button Content="🔄" 
                                        Click="ChangeUserButton_Click" 
                                        Background="Transparent" 
                                        Foreground="{DynamicResource AccentBlue}" 
                                        FontSize="20" 
                                        Cursor="Hand" 
                                        FontWeight="Bold" 
                                        BorderThickness="0" 
                                        ToolTip="Сменить пользователя"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- ПАНЕЛЬ КНОПОК -->
                <WrapPanel Grid.Row="1" Orientation="Horizontal">
                    <Button Content="👑 Панель Разработчика" 
                            Click="DevPanelButton_Click" 
                            Style="{StaticResource PurpleBtn}" 
                            Visibility="{Binding IsDeveloper, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button x:Name="AddButton" 
                            Content="➕ Добавить заказ" 
                            Click="AddButton_Click" 
                            Style="{StaticResource PrimaryBtn}"/>
                    <Button x:Name="ManagerDeskButton" 
                            Content="💼 Стол управляющего" 
                            Click="ManagerDeskButton_Click" 
                            Style="{StaticResource PrimaryBtn}" 
                            Visibility="{Binding IsAdminOrDirector, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <Border Width="10"/>

                    <Button x:Name="StartShiftButton" 
                            Content="📅 Начать смену" 
                            Click="StartShiftButton_Click" 
                            Style="{StaticResource SuccessBtn}" 
                            Visibility="{Binding IsAdminOrDirector, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button x:Name="CloseShiftButton" 
                            Content="🔒 Закрыть смену" 
                            Click="CloseShiftButton_Click" 
                            Style="{StaticResource DangerBtn}" 
                            Visibility="{Binding IsAdminOrDirector, Converter={StaticResource BoolToVisibilityConverter}}"/>

                    <Border Width="10"/>

                    <Button x:Name="CashboxButton" 
                            Content="💰 Трансфер сумм" 
                            Click="CashboxButton_Click" 
                            Style="{StaticResource PrimaryBtn}" 
                            Visibility="{Binding IsAdminOrDirector, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <Button x:Name="CalcButton" 
                            Content="🧮 Калькулятор" 
                            Click="CalcButton_Click" 
                            Style="{StaticResource PrimaryBtn}"/>
                    <Button x:Name="AppointmentsBoardButton" 
                            Content="📋 Доска записей" 
                            Click="AppointmentsBoardButton_Click" 
                            Style="{StaticResource WarningBtn}"/>
                    <Button x:Name="HistoryButton" 
                            Content="📊 История" 
                            Click="HistoryButton_Click" 
                            Style="{StaticResource WarningBtn}"/>

                    <TextBox x:Name="SearchFilterTextBox" 
                             Text="🔍 Поиск по гос. номеру или модели..." 
                             KeyUp="SearchFilterTextBox_KeyUp" 
                             GotFocus="SearchFilterTextBox_GotFocus" 
                             LostFocus="SearchFilterTextBox_LostFocus" 
                             Padding="15,0" 
                             Width="280" 
                             Height="45" 
                             Margin="8,0"
                             FontSize="13"
                             VerticalContentAlignment="Center" 
                             VerticalAlignment="Top"/>

                    <Button Content="🌓 Тема" 
                            Click="ToggleThemeButton_Click" 
                            Style="{StaticResource PrimaryBtn}" 
                            Margin="0,0,8,0"/>
                    <Button Content="🚪 Выход" 
                            Click="ExitButton_Click" 
                            Style="{StaticResource DangerBtn}"/>
                </WrapPanel>
            </Grid>

            <!-- 3. РАБОЧАЯ ОБЛАСТЬ -->
            <Grid Grid.Row="2" Margin="0,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0" 
                              Padding="10,0" 
                              VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <!-- МОЕЧНАЯ ЗОНА -->
                        <StackPanel Visibility="{Binding SelectedBranchTab.HasWashZones, Converter={StaticResource BoolToVisibilityConverter}}" 
                                    Margin="0,0,0,20">
                            <TextBlock Text="💦 МОЕЧНАЯ ЗОНА" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource TextMain}" 
                                       Margin="5,0,0,15" 
                                       Opacity="0.9"/>
                            <ItemsControl ItemsSource="{Binding SelectedBranchTab.WashZones}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <GroupBox Header="{Binding ZoneName}" 
                                                  Width="350" 
                                                  MinHeight="400" 
                                                  Margin="5,0,15,15" 
                                                  FontSize="14" 
                                                  FontWeight="Bold" 
                                                  Foreground="{DynamicResource TextMain}">
                                            <GroupBox.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="✏ Редактировать заказ" Click="EditOrderMenuItem_Click"/>
                                                    <MenuItem Header="🗑 Удалить заказ" Click="DeleteOrderMenuItem_Click"/>
                                                </ContextMenu>
                                            </GroupBox.ContextMenu>
                                            <ListBox ItemsSource="{Binding Orders}" 
                                                     AllowDrop="True" 
                                                     Drop="Order_Drop"
                                                     SelectedItem="{Binding DataContext.SelectedItem, RelativeSource={RelativeSource AncestorType=local:MainWindow}, Mode=TwoWay}"
                                                     ItemTemplate="{StaticResource OrderTemplate}" 
                                                     Style="{StaticResource CleanListBoxStyle}"
                                                     MouseDoubleClick="BoxItemsControl_MouseDoubleClick" 
                                                     Margin="5,10,5,5"/>
                                        </GroupBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- СЕРВИСНАЯ ЗОНА -->
                        <StackPanel Visibility="{Binding SelectedBranchTab.HasServiceZones, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="🔧 СЕРВИСНАЯ ЗОНА" 
                                       FontSize="18" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource TextMain}" 
                                       Margin="5,0,0,15" 
                                       Opacity="0.9"/>
                            <ItemsControl ItemsSource="{Binding SelectedBranchTab.ServiceZones}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <GroupBox Header="{Binding ZoneName}" 
                                                  Width="350" 
                                                  MinHeight="400" 
                                                  Margin="5,0,15,15" 
                                                  FontSize="14" 
                                                  FontWeight="Bold" 
                                                  Foreground="{DynamicResource TextMain}">
                                            <GroupBox.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="✏ Редактировать заказ" Click="EditOrderMenuItem_Click"/>
                                                    <MenuItem Header="🗑 Удалить заказ" Click="DeleteOrderMenuItem_Click"/>
                                                </ContextMenu>
                                            </GroupBox.ContextMenu>
                                            <ListBox ItemsSource="{Binding Orders}" 
                                                     AllowDrop="True" 
                                                     Drop="Order_Drop"
                                                     SelectedItem="{Binding DataContext.SelectedItem, RelativeSource={RelativeSource AncestorType=local:MainWindow}, Mode=TwoWay}"
                                                     ItemTemplate="{StaticResource OrderTemplate}" 
                                                     Style="{StaticResource CleanListBoxStyle}"
                                                     MouseDoubleClick="BoxItemsControl_MouseDoubleClick" 
                                                     Margin="5,10,5,5"/>
                                        </GroupBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- БОКОВАЯ ПАНЕЛЬ СТАТИСТИКИ -->
                <Border Grid.Column="1" 
                    Style="{StaticResource StatCard}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="👥 Статистика сотрудников:" 
                                       FontSize="14" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource TextMain}" 
                                       Margin="0,0,0,10"/>
                            <ItemsControl ItemsSource="{Binding WashersStats}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource BgMain}" 
                                                CornerRadius="6" 
                                                Padding="10" 
                                                Margin="0,0,0,10" 
                                                BorderBrush="{DynamicResource BorderColor}" 
                                                BorderThickness="1">
                                            <StackPanel>
                                                <TextBlock Text="{Binding WasherName}" 
                                                           FontSize="13" 
                                                           FontWeight="Bold" 
                                                           Foreground="{DynamicResource TextMain}" 
                                                           Margin="0,0,0,6"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" 
                                                               FontSize="12" 
                                                               Foreground="{DynamicResource TextMuted}">
                                                        <Run Text="🚗 "/> 
                                                        <Run Text="{Binding CarsCount, StringFormat={}{0} маш.}"/>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="1" 
                                                               FontSize="12" 
                                                               FontWeight="Bold" 
                                                               Foreground="{DynamicResource AccentOrange}" 
                                                               HorizontalAlignment="Right">
                                                        <Run Text="📊 "/> 
                                                        <Run Text="{Binding Percentage, StringFormat={}{0:F1}%}"/>
                                                    </TextBlock>
                                                </Grid>
                                                <TextBlock Margin="0,6,0,0" 
                                                           FontSize="13" 
                                                           FontWeight="Bold" 
                                                           Foreground="{DynamicResource AccentGreen}">
                                                    <Run Text="💰 "/>
                                                    <Run Text="{Binding Earnings, StringFormat={}{0:N0} ₽}"/>
                                                </TextBlock>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Separator Margin="0,10" Background="{DynamicResource BorderColor}"/>
                            <TextBlock Text="💳 Способы оплаты:" 
                                       FontSize="14" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource TextMain}" 
                                       Margin="0,0,0,10"/>

                            <Border Background="{DynamicResource BgMain}" 
                                    CornerRadius="6" 
                                    Padding="12" 
                                    BorderBrush="{DynamicResource BorderColor}" 
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center"/>
                                        </Style>
                                    </Grid.Resources>

                                    <!-- Наличные -->
                                    <Grid Grid.Row="0" Style="{StaticResource PaymentStatGridStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="25"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="💵" FontSize="16"/>
                                        <TextBlock Grid.Column="1" Text="Наличные" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
                                        <TextBlock Grid.Column="2" Foreground="{DynamicResource TextMuted}" FontSize="12">
                                            <Run Text="{Binding CashCount, StringFormat={}{0} шт.}"/> 
                                            <Run Text=" / "/>
                                            <Run Text="{Binding CashAmount, StringFormat={}{0:N0} ₽}" FontWeight="Bold" Foreground="{DynamicResource AccentGreen}"/>
                                        </TextBlock>
                                    </Grid>

                                    <!-- Карта -->
                                    <Grid Grid.Row="1" Style="{StaticResource PaymentStatGridStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="25"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="💳" FontSize="16"/>
                                        <TextBlock Grid.Column="1" Text="Карта" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
                                        <TextBlock Grid.Column="2" Foreground="{DynamicResource TextMuted}" FontSize="12">
                                            <Run Text="{Binding CardCount, StringFormat={}{0} шт.}"/> 
                                            <Run Text=" / "/>
                                            <Run Text="{Binding CardAmount, StringFormat={}{0:N0} ₽}" FontWeight="Bold" Foreground="{DynamicResource AccentGreen}"/>
                                        </TextBlock>
                                    </Grid>

                                    <!-- Перевод -->
                                    <Grid Grid.Row="2" Style="{StaticResource PaymentStatGridStyle}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="25"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="📱" FontSize="16"/>
                                        <TextBlock Grid.Column="1" Text="Перевод" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
                                        <TextBlock Grid.Column="2" Foreground="{DynamicResource TextMuted}" FontSize="12">
                                            <Run Text="{Binding TransferCount, StringFormat={}{0} шт.}"/> 
                                            <Run Text=" / "/>
                                            <Run Text="{Binding TransferAmount, StringFormat={}{0:N0} ₽}" FontWeight="Bold" Foreground="{DynamicResource AccentGreen}"/>
                                        </TextBlock>
                                    </Grid>

                                    <!-- QR -->
                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="25"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🔲" FontSize="16"/>
                                        <TextBlock Grid.Column="1" Text="QR-код" FontWeight="SemiBold" Foreground="{DynamicResource TextMain}"/>
                                        <TextBlock Grid.Column="2" Foreground="{DynamicResource TextMuted}" FontSize="12">
                                            <Run Text="{Binding QrCount, StringFormat={}{0} шт.}"/> 
                                            <Run Text=" / "/>
                                            <Run Text="{Binding QrAmount, StringFormat={}{0:N0} ₽}" FontWeight="Bold" Foreground="{DynamicResource AccentGreen}"/>
                                        </TextBlock>
                                    </Grid>
                                </Grid>
                            </Border>

                            <Separator Margin="0,15" Background="{DynamicResource BorderColor}"/>

                            <!-- Итоговые суммы -->
                            <StackPanel Margin="0,0,0,15">
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="🏢 Компания:" 
                                               FontSize="14" 
                                               FontWeight="Bold" 
                                               Foreground="{DynamicResource TextMain}"/>
                                    <TextBlock Text="{Binding CompanyEarnings, StringFormat={}{0:N0} ₽}" 
                                               FontSize="15" 
                                               FontWeight="Bold" 
                                               Foreground="{DynamicResource AccentGreen}" 
                                               HorizontalAlignment="Right"/>
                                </DockPanel>
                                <DockPanel>
                                    <TextBlock Text="💵 Общая выручка:" 
                                               FontSize="14" 
                                               FontWeight="Bold" 
                                               Foreground="{DynamicResource TextMain}"/>
                                    <TextBlock Text="{Binding TotalRevenue, StringFormat={}{0:N0} ₽}" 
                                               FontSize="15" 
                                               FontWeight="Bold" 
                                               Foreground="{DynamicResource AccentBlue}" 
                                               HorizontalAlignment="Right"/>
                                </DockPanel>
                            </StackPanel>

                            <!-- Инвертированная панель "Итого заказов" -->
                            <Border Background="{DynamicResource TextMain}" 
                                    CornerRadius="6" 
                                    Padding="15" 
                                    Margin="0,0,0,20">
                                <TextBlock Text="{Binding TotalOrdersInfo}" 
                                           FontSize="14" 
                                           FontWeight="Bold" 
                                           Foreground="{DynamicResource BgCard}" 
                                           TextWrapping="Wrap"/>
                            </Border>

                            <StackPanel VerticalAlignment="Bottom" 
                                        HorizontalAlignment="Center" 
                                        Margin="0,10,0,0">
                                <Button Content="📤 Экспорт данных" 
                                        Click="ExportButton_Click" 
                                        Style="{StaticResource PurpleBtn}" 
                                        Width="200" 
                                        Margin="0,0,0,5"/>
                                <TextBlock Text="Важно при возникновении ошибок" 
                                           HorizontalAlignment="Center" 
                                           FontSize="11" 
                                           Foreground="{DynamicResource TextLightMuted}"/>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>

        <!-- Оверлеи (без изменений) -->
        <controls:AppointmentsOverlay x:Name="AppointmentsOverlay" Visibility="Collapsed" Panel.ZIndex="9999"/>
        <controls:ManagerDeskOverlay x:Name="DeskOverlay" 
                                     CashboxRequested="DeskOverlay_CashboxRequested" 
                                     CompanySettingsRequested="DeskOverlay_CompanySettingsRequested" 
                                     Visibility="Collapsed" 
                                     Panel.ZIndex="150"/>
        <controls:CashboxOverlay x:Name="CashboxPanel" Visibility="Collapsed" Panel.ZIndex="160"/>
        <controls:CalculatorOverlay x:Name="CalculatorOverlay" Visibility="Collapsed" Panel.ZIndex="200"/>
        <controls:CompanyManagementOverlay x:Name="CompanySettingsPanel" Visibility="Collapsed" Panel.ZIndex="200"/>
    </Grid>
</Window>