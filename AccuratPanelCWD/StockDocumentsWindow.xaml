<Window x:Class="AccuratPanelCWD.StockDocumentsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AccuratPanelCWD"
        xmlns:controls="clr-namespace:AccuratPanelCWD.Controls"
        Title="📄 Документы склада" Height="700" Width="1000"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BgMain}"
        Foreground="{DynamicResource TextMain}">
    <Window.Resources>
        <local:StockDocTypeRuConverter x:Key="DocTypeRu"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>

        <TextBlock Text="📄 Документы склада" FontWeight="Bold" FontSize="22" Margin="0,0,0,16"/>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <controls:CustomComboBox x:Name="BranchCombo" Header="Филиал"
                                     DisplayMemberPath="Name" SelectedValuePath="Id"
                                     SelectionChanged="Filters_Changed"/>

            <controls:CustomComboBox x:Name="TypeFilterCombo" Grid.Column="1" Header="Тип"
                                     DisplayMemberPath="Name" SelectedValuePath="Value"
                                     Margin="15,0,0,0" SelectionChanged="Filters_Changed"/>

            <Button Grid.Column="2" Content="➕ Новый документ" Style="{StaticResource SuccessBtn}"
                    Margin="15,0,0,0" VerticalAlignment="Bottom" Click="NewDocument_Click"/>
        </Grid>

        <DataGrid x:Name="DocsGrid" Grid.Row="2" Style="{StaticResource AuditDataGridStyle}" 
                  SelectionChanged="DocsGrid_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер" Binding="{Binding Number}" Width="100"/>
                <DataGridTextColumn Header="Тип" Binding="{Binding Type, Converter={StaticResource DocTypeRu}}" Width="120"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt, StringFormat=dd.MM.yyyy HH:mm}" Width="140"/>
                <DataGridTextColumn Header="Поставщик" Binding="{Binding SupplierName}" Width="*"/>
                <DataGridTextColumn Header="Кто создал" Binding="{Binding CreatedBy}" Width="160"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Text="Позиции выбранного документа" FontWeight="SemiBold" FontSize="14" 
                   Foreground="{DynamicResource TextMain}" Margin="0,16,0,8"/>

        <DataGrid x:Name="LinesGrid" Grid.Row="4" Style="{StaticResource AuditDataGridStyle}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Позиция" Binding="{Binding Item.Name}" Width="*"/>
                <DataGridTextColumn Header="Кол-во" Binding="{Binding Quantity, StringFormat=N3}" Width="120"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding CostPrice, StringFormat=N2}" Width="120"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding LineSum, StringFormat=N0}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Window>