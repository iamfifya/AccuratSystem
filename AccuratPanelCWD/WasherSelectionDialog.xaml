<Window x:Class="AccuratPanelCWD.WasherSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AccuratPanelCWD.Controls"
        Title="Выбор мойщика"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Width="550" 
        Height="400"
        Background="{DynamicResource BgMain}"
        BorderBrush="{DynamicResource BorderColor}"
        BorderThickness="1"
        WindowStyle="SingleBorderWindow"
        Foreground="{DynamicResource TextMain}">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="👤 Выберите мойщика" 
                   FontSize="22" 
                   FontWeight="Bold" 
                   Foreground="{DynamicResource TextMain}" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,25"/>

        <!-- Подпись -->
        <TextBlock Text="Мойщик" 
                   Grid.Row="1" 
                   FontSize="13" 
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextMain}"
                   Margin="0,0,0,8"/>

        <!-- ComboBox выбора -->
        <controls:CustomComboBox x:Name="WasherComboBox" 
                                 Grid.Row="2" 
                                 Margin="0,0,0,20" 
                                 Height="45"
                                 DisplayMemberPath="FullName"
                                 SelectedValuePath="Id"
                                 Placeholder="Выберите из списка"
                                 IsEditable="True"/>

        <!-- Предупреждение -->
        <Border Grid.Row="3" 
                Background="{DynamicResource UpsellBannerBg}"
                BorderBrush="{DynamicResource UpsellBannerBorder}"
                BorderThickness="2"
                CornerRadius="6"
                Padding="15"
                Margin="0,5,0,0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="⚠️" 
                           FontSize="18" 
                           Foreground="{DynamicResource AccentOrange}"
                           VerticalAlignment="Top"
                           Margin="0,0,10,0"/>
                <TextBlock Text="Если мойщик не в смене, он будет учтён в статистике и добавлен в смену автоматически" 
                           FontSize="13" 
                           Foreground="{DynamicResource TextMain}" 
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="4" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,25,0,0">
            <Button Content="✅ Выбрать" 
                    Click="OkButton_Click" 
                    Style="{StaticResource SuccessBtn}"
                    Margin="0,0,10,0"/>
            <Button Content="✖ Отмена" 
                    Click="CancelButton_Click" 
                    Style="{StaticResource DangerBtn}"/>
        </StackPanel>
    </Grid>
</Window>