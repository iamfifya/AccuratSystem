<Window x:Class="AccuratPanelCWD.ServiceManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AccuratPanelCWD"
        xmlns:controls="clr-namespace:AccuratPanelCWD.Controls"
        mc:Ignorable="d"
        Title="Управление услугами"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinWidth="1000" MinHeight="500"
        Background="{DynamicResource BgMain}"
        BorderBrush="{DynamicResource BorderColor}"
        BorderThickness="1"
        WindowStyle="None"
        WindowState="Maximized"
        Foreground="{DynamicResource TextMain}">

    <Window.Resources>
        <!-- Стиль для карточки услуги в ListBox (с поддержкой тем) -->
        <Style x:Key="ServiceCardStyle" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="CardBorder"
                                BorderThickness="1" 
                                BorderBrush="{DynamicResource BorderColor}" 
                                CornerRadius="6" 
                                Background="{DynamicResource BgCard}" 
                                Width="280" 
                                MinHeight="180" 
                                Margin="8"
                                HorizontalAlignment="Center"
                                Cursor="Hand">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1" Color="#000000"/>
                            </Border.Effect>
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                <Setter TargetName="CardBorder" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource TableRowSelected}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                <Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource TableRowHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" 
                   Text="🛠️ Управление услугами" 
                   FontSize="26" 
                   FontWeight="Bold" 
                   Foreground="{DynamicResource TextMain}" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20"/>

        <!-- Панель управления -->
        <StackPanel Grid.Row="1" 
                    Orientation="Horizontal" 
                    Margin="0,0,0,12" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Center">
            <Button Content="➕ Добавить услугу" 
                    Click="AddButton_Click" 
                    Style="{StaticResource SuccessBtn}"/>
            <Button Content="✏ Редактировать" 
                    Click="EditButton_Click" 
                    Style="{StaticResource PrimaryBtn}"
                    Margin="0,0,8,0"/>
            <Button Content="🗑️ Удалить" 
                    Click="DeleteButton_Click" 
                    Style="{StaticResource DangerBtn}"
                    Margin="0,0,8,0"/>
            <Button Content="🛠️ Управление доп.продажами" 
                    x:Name="UpsellButton" 
                    Click="UpsellButton_Click" 
                    Visibility="{Binding IsAdminOrDirector, Converter={StaticResource BoolToVisibilityConverter}}" 
                    Style="{StaticResource PurpleBtn}"/>

            <Border Width="1" Background="{DynamicResource BorderColor}" Margin="15,5"/>

            <TextBlock Text="🔍 Поиск" 
                       VerticalAlignment="Center" 
                       Foreground="{DynamicResource TextMain}"
                       FontWeight="SemiBold"
                       Margin="0,0,8,0"/>
            <TextBox x:Name="SearchTextBox" 
                     Width="300" 
                     Height="45" 
                     Padding="15,0"
                     FontSize="14"
                     TextChanged="SearchTextBox_TextChanged"/>
        </StackPanel>

        <!-- Фильтр по категории услуги -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    Margin="0,0,0,15" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Center">
            <TextBlock Text="📂 Категория" 
                       VerticalAlignment="Center" 
                       Foreground="{DynamicResource TextMain}"
                       FontWeight="SemiBold"
                       Margin="0,0,10,0"/>
            <controls:CustomComboBox x:Name="CategoryFilterCombo" 
                                     Width="400" 
                                     Height="45"
                                     Placeholder="Выберите категорию"
                                     SelectedValuePath="Tag"
                                     SelectionChanged="CategoryFilterCombo_SelectionChanged">
                <controls:CustomComboBox.Items>
                    <ComboBoxItem Content="🔄 Все услуги" Tag="{x:Null}" IsSelected="True"/>
                    <ComboBoxItem Content="💦 Мойка" Tag="0"/>
                    <ComboBoxItem Content="🔧 Сервис" Tag="1"/>
                </controls:CustomComboBox.Items>
            </controls:CustomComboBox>
        </StackPanel>

        <!-- Список услуг (карточки) -->
        <ListBox x:Name="ServicesListBox"
                 Grid.Row="3"
                 Background="Transparent"
                 BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 SelectionMode="Single"
                 Margin="5"
                 HorizontalContentAlignment="Center"
                 MouseLeftButtonDown="ServicesListBox_MouseLeftButtonDown"
                 MouseDoubleClick="ServicesListBox_MouseDoubleClick">

            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" 
                               HorizontalAlignment="Center"
                               VerticalAlignment="Top"
                               IsItemsHost="True"
                               Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}"/>
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>

            <ListBox.ItemContainerStyle>
                <StaticResource ResourceKey="ServiceCardStyle"/>
            </ListBox.ItemContainerStyle>

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="12" ContextMenuService.IsEnabled="True" Width="280">
                        <Grid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="✏ Редактировать" Click="EditMenuItem_Click"/>
                                <MenuItem Header="🗑️ Удалить" Click="DeleteMenuItem_Click"/>
                                <Separator/>
                                <MenuItem Header="📋 Копировать название" Click="CopyNameMenuItem_Click"/>
                            </ContextMenu>
                        </Grid.ContextMenu>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Название услуги -->
                        <TextBlock Grid.Row="0" 
                                   FontSize="17" 
                                   FontWeight="Bold" 
                                   Text="{Binding Name}" 
                                   HorizontalAlignment="Center"
                                   Foreground="{DynamicResource TextMain}" 
                                   TextWrapping="Wrap" 
                                   TextAlignment="Center"/>

                        <!-- Цены по категориям кузова -->
                        <ItemsControl Grid.Row="1" 
                                      Margin="0,12,0,0" 
                                      ItemsSource="{Binding PriceByBodyType}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontSize="12" 
                                               Foreground="{DynamicResource TextMuted}" 
                                               HorizontalAlignment="Center">
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="Кат. {0}: {1:N0}₽">
                                                <Binding Path="Key" />
                                                <Binding Path="Value" />
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Длительность -->
                        <TextBlock Grid.Row="2" 
                                   FontSize="12" 
                                   Text="{Binding DurationMinutes, StringFormat=⏱️ Длительность: {0} мин}" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextMuted}"/>

                        <!-- Описание -->
                        <TextBlock Grid.Row="3" 
                                   FontSize="11" 
                                   Text="{Binding Description}" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,8,0,0"
                                   Foreground="{DynamicResource TextLightMuted}" 
                                   TextWrapping="Wrap" 
                                   TextAlignment="Center"
                                   MaxHeight="50"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Кнопки внизу -->
        <StackPanel Grid.Row="4" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,15,0,10">
            <Button Content="🔧 Проверить" 
                    Click="CheckIntegrityButton_Click" 
                    Style="{StaticResource WarningBtn}"
                    Visibility="{Binding IsDeveloper, Converter={StaticResource BoolToVisibilityConverter}}"
                    Margin="0,0,10,0"/>
            <Button Content="✖ Закрыть" 
                    Click="CloseButton_Click" 
                    Style="{StaticResource DangerBtn}"/>
        </StackPanel>
    </Grid>
</Window>