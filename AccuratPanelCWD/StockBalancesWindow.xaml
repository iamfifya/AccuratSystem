<Window x:Class="AccuratPanelCWD.StockBalancesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AccuratPanelCWD.Controls"
        Title="📊 Остатки по филиалу" Height="650" Width="900"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BgMain}"
        Foreground="{DynamicResource TextMain}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="📊 Остатки склада" FontWeight="Bold" FontSize="22" Margin="0,0,0,16"/>

        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <controls:CustomComboBox x:Name="BranchCombo" Header="Филиал"
                                     DisplayMemberPath="Name" SelectedValuePath="Id"
                                     SelectionChanged="BranchCombo_Changed" />

            <Button Grid.Column="1" Content="🔄 Обновить" Style="{StaticResource PrimaryBtn}"
                    Margin="15,0,0,0" Click="Refresh_Click" ToolTip="Обновить данные" VerticalAlignment="Bottom"/>
        </Grid>

        <!-- Используем глобальный стиль AuditDataGridStyle -->
        <DataGrid x:Name="BalancesGrid" Grid.Row="2" Style="{StaticResource AuditDataGridStyle}"
                  LoadingRow="BalancesGrid_LoadingRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Item.Name}" Width="*"/>
                <DataGridTextColumn Header="Артикул" Binding="{Binding Item.Article}" Width="100"/>
                <DataGridTextColumn Header="Остаток" Binding="{Binding Quantity, StringFormat=N3}" Width="100"/>
                <DataGridTextColumn Header="Ср. цена" Binding="{Binding AvgCost, StringFormat=N2}" Width="100"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding TotalValue, StringFormat=N0}" Width="120"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock Grid.Row="3" Margin="0,15,0,0" FontSize="12" Foreground="{DynamicResource TextMuted}"
                   Text="ℹ Красная строка — отрицательный остаток. Оранжевая — ниже минимального."/>
    </Grid>
</Window>