<Window x:Class="AccuratPanelCWD.ScheduleWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AccuratPanelCWD"
        xmlns:controls="clr-namespace:AccuratPanelCWD.Controls"
        Title="График работы"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinWidth="1100" MinHeight="600"
        Width="1200" Height="750"
        Background="{DynamicResource BgMain}"
        BorderBrush="{DynamicResource BorderColor}"
        BorderThickness="1"
        WindowStyle="SingleBorderWindow"
        WindowState="Maximized"
        Foreground="{DynamicResource TextMain}">

    <Window.Resources>
        <Style x:Key="HeaderCellStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="DayHeaderCellStyle" TargetType="TextBlock" BasedOn="{StaticResource HeaderCellStyle}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="5,8"/>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Вкладки филиалов -->
        <TabControl Grid.Row="0" 
                    ItemsSource="{Binding BranchTabs}" 
                    SelectedItem="{Binding SelectedBranchTab, Mode=TwoWay}"
                    Margin="0,0,0,15">

            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                    <Setter Property="Visibility" Value="{Binding DataContext.IsDirector, ElementName=RootWindow, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </Style>
            </TabControl.ItemContainerStyle>

            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding BranchName}" FontSize="12" FontWeight="Bold"/>
                </DataTemplate>
            </TabControl.ItemTemplate>

            <TabControl.ContentTemplate>
                <DataTemplate/>
            </TabControl.ContentTemplate>
        </TabControl>

        <!-- 2. Заголовок -->
        <TextBlock Grid.Row="1" 
                   Text="ГРАФИК РАБОТЫ СОТРУДНИКОВ" 
                   FontSize="22" 
                   FontWeight="Black" 
                   Foreground="{DynamicResource TextMain}" 
                   Margin="0,0,0,20" 
                   HorizontalAlignment="Center"/>

        <!-- 3. Навигация по месяцам -->
        <DockPanel Grid.Row="2" Margin="0,0,0,20" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button Content="◀" 
                        Click="PrevMonth_Click" 
                        Width="40" 
                        Height="40" 
                        FontSize="16" 
                        FontWeight="Bold" 
                        Style="{StaticResource PrimaryBtn}"/>
                <Border Background="{DynamicResource BgCard}" 
                        BorderBrush="{DynamicResource BorderColor}" 
                        BorderThickness="1" 
                        Padding="15,0" 
                        Margin="8,0" 
                        Width="220" 
                        Height="40"
                        CornerRadius="6">
                    <TextBlock x:Name="MonthYearText" 
                               TextAlignment="Center" 
                               Text="Апрель 2026" 
                               FontSize="16" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource TextMain}"
                               VerticalAlignment="Center"/>
                </Border>
                <Button Content="▶" 
                        Click="NextMonth_Click" 
                        Width="40" 
                        Height="40" 
                        FontSize="16" 
                        FontWeight="Bold" 
                        Style="{StaticResource PrimaryBtn}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="🔧 Создать по шаблону" 
                        Click="TemplateButton_Click" 
                        Style="{StaticResource WarningBtn}"/>
            </StackPanel>
        </DockPanel>

        <!-- 4. Легенда -->
        <Border Grid.Row="3" 
                Background="{DynamicResource BgCard}" 
                CornerRadius="6" 
                Padding="15" 
                Margin="0,0,0,15"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Легенда (Левый клик - переключить, Правый клик - очистить):" 
                           FontWeight="Medium" 
                           Foreground="{DynamicResource TextMain}"
                           Margin="0,0,20,0" 
                           VerticalAlignment="Center"/>
                <Border Width="20" Height="20" Background="{DynamicResource ScheduleWorkDay}" CornerRadius="6" Margin="0,0,8,0"/>
                <TextBlock Text="Р - Рабочий" 
                           Foreground="{DynamicResource TextMain}"
                           VerticalAlignment="Center" 
                           Margin="0,0,20,0"/>
                <Border Width="20" Height="20" Background="{DynamicResource ScheduleDayOff}" CornerRadius="6" Margin="0,0,8,0"/>
                <TextBlock Text="В - Выходной" 
                           Foreground="{DynamicResource TextMain}"
                           VerticalAlignment="Center" 
                           Margin="0,0,20,0"/>
                <Border Width="20" Height="20" Background="{DynamicResource ScheduleSkip}" CornerRadius="6" Margin="0,0,8,0" Opacity="0.3"/>
                <TextBlock Text="П - Пропуск" 
                           Foreground="{DynamicResource TextMain}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- 5. Шапка таблицы -->
        <Border Grid.Row="4" 
                Background="{DynamicResource TextMain}" 
                Height="45" 
                CornerRadius="6,6,0,0">
            <Grid x:Name="HeaderGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" MinWidth="150"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Сотрудник / День" 
                           Style="{StaticResource HeaderCellStyle}" 
                           HorizontalAlignment="Center" 
                           VerticalAlignment="Center" 
                           Padding="10,8"
                           FontSize="14"/>
            </Grid>
        </Border>

        <!-- 6. Сама таблица -->
        <ScrollViewer Grid.Row="5" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Auto">
            <Grid x:Name="ScheduleGrid" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" MinWidth="150"/>
                </Grid.ColumnDefinitions>
            </Grid>
        </ScrollViewer>

        <!-- 7. Кнопки -->
        <StackPanel Grid.Row="6" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,20,0,15">
            <Button x:Name="SaveButton" 
                    Content="💾 Сохранить" 
                    Click="SaveButton_Click" 
                    Style="{StaticResource SuccessBtn}"
                    Margin="0,0,10,0"
                    IsEnabled="False"/>
            <Button Content="✖ Закрыть" 
                    Click="CloseButton_Click" 
                    Style="{StaticResource DangerBtn}"/>
        </StackPanel>
    </Grid>
</Window>