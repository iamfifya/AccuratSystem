<UserControl x:Class="AccuratPanelCWD.CustomDatePicker"
             x:Name="RootPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="40"
             d:DesignWidth="400"
             PreviewKeyDown="Root_PreviewKeyDown">

    <UserControl.Resources>
        <!-- Calendar day button is fully defined in XAML. -->
        <Style x:Key="CalendarDayButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource BgCard}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeMD}"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource RadiusSM}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource CalendarDayHoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource BgSelected}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource TextLightMuted}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BgSelected}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBlue}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                        <Condition Binding="{Binding IsSelected}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource BgHover}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="40"/>
        </Grid.ColumnDefinitions>

        <Border Grid.ColumnSpan="2"
                Background="{DynamicResource InputBackground}"
                BorderBrush="{DynamicResource InputBorder}"
                BorderThickness="1"
                CornerRadius="{DynamicResource RadiusSM}"
                SnapsToDevicePixels="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="DateTextBox"
                         Grid.Column="0"
                         Style="{x:Null}"
                         Height="{DynamicResource ControlHeightMD}"
                         Padding="{DynamicResource ControlPaddingLG}"
                         IsReadOnly="True"
                         Background="Transparent"
                         Foreground="{DynamicResource InputText}"
                         Cursor="Hand"
                         PreviewMouseLeftButtonDown="DateTextBox_MouseLeftButtonDown"
                         BorderThickness="0"
                         HorizontalContentAlignment="Left"
                         VerticalContentAlignment="Center"
                         FontFamily="Segoe UI"
                         FontSize="{DynamicResource FontSizeMD}"
                         Focusable="True"
                         PreviewKeyDown="DateTextBox_PreviewKeyDown"
                         ToolTip="Открыть календарь">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          HorizontalScrollBarVisibility="Hidden"
                                          VerticalScrollBarVisibility="Hidden"/>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>

                <Button x:Name="CalendarButton"
                        Style="{x:Null}"
                        Grid.Column="1"
                        Width="40"
                        Height="40"
                        Background="{DynamicResource AccentBlue}"
                        Foreground="{DynamicResource TextOnAccent}"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="CalendarButton_Click"
                        ToolTip="Открыть календарь">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="Chrome"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="{DynamicResource InputRightRadius}">
                                    <Path Width="16"
                                          Height="16"
                                          Stretch="Fill"
                                          Fill="{TemplateBinding Foreground}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="M3,2 L5,2 L5,0 L7,0 L7,2 L13,2 L13,0 L15,0 L15,2 L17,2 C18.1,2 19,2.9 19,4 L19,18 C19,19.1 18.1,20 17,20 L3,20 C1.9,20 1,19.1 1,18 L1,4 C1,2.9 1.9,2 3,2 Z M3,5 L17,5 L17,7 L3,7 Z M3,9 L7,9 L7,13 L3,13 Z M9,9 L13,9 L13,13 L9,13 Z M15,9 L17,9 L17,13 L15,13 Z"/>
                                </Border>
                                <Border x:Name="HoverOverlay"
                                        Background="{DynamicResource HoverOverlayBrush}"
                                        CornerRadius="{DynamicResource InputRightRadius}"
                                        Opacity="0"
                                        IsHitTestVisible="False"/>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HoverOverlay" Property="Opacity" Value="1"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="HoverOverlay" Property="Opacity" Value="0.7"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Chrome" Property="Opacity" Value="0.5"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <Popup x:Name="CalendarPopup"
               PlacementTarget="{Binding ElementName=DateTextBox}"
               Placement="Bottom"
               StaysOpen="False"
               PopupAnimation="Fade"
               AllowsTransparency="True"
               VerticalOffset="6"
>
            <Border Background="{DynamicResource BgElevated}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource RadiusLG}"
                    Padding="16"
                    MinWidth="{DynamicResource CalendarPopupMinWidth}"
                    Effect="{DynamicResource PopupShadow}"
                    PreviewKeyDown="CalendarPopup_PreviewKeyDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Month navigation -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="36"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="PrevMonthButton"
                        Style="{x:Null}"
                                Grid.Column="0"
                                Width="32"
                                Height="32"
                                Background="Transparent"
                                Foreground="{DynamicResource TextMuted}"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="PrevMonth_Click"
                                ToolTip="Предыдущий месяц">
                            <Path Width="7"
                                  Height="12"
                                  Stretch="Fill"
                                  Fill="{DynamicResource TextMuted}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M7,0 L0,6 L7,12 L8,10 L3,6 L8,2 Z"/>
                        </Button>

                        <TextBlock x:Name="MonthYearText"
                                   Grid.Column="1"
                                   FontFamily="Segoe UI"
                                   FontSize="{DynamicResource FontSizeLG}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMain}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        <Button x:Name="NextMonthButton"
                        Style="{x:Null}"
                                Grid.Column="2"
                                Width="32"
                                Height="32"
                                Background="Transparent"
                                Foreground="{DynamicResource TextMuted}"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="NextMonth_Click"
                                ToolTip="Следующий месяц">
                            <Path Width="7"
                                  Height="12"
                                  Stretch="Fill"
                                  Fill="{DynamicResource TextMuted}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M1,0 L8,6 L1,12 L0,10 L5,6 L0,2 Z"/>
                        </Button>
                    </Grid>

                    <!-- Weekdays -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Пн" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeXS}" Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock Grid.Column="1" Text="Вт" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeXS}" Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock Grid.Column="2" Text="Ср" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeXS}" Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock Grid.Column="3" Text="Чт" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeXS}" Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock Grid.Column="4" Text="Пт" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeXS}" Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock Grid.Column="5" Text="Сб" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeXS}" Foreground="{DynamicResource AccentRed}"/>
                        <TextBlock Grid.Column="6" Text="Вс" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeXS}" Foreground="{DynamicResource AccentRed}"/>
                    </Grid>

                    <ItemsControl x:Name="CalendarItems"
                                  Grid.Row="2"
                                  ItemsSource="{Binding CalendarDays, ElementName=RootPicker}"
                                  KeyboardNavigation.DirectionalNavigation="Continue">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7" Rows="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource CalendarDayButtonStyle}"
                                        IsEnabled="{Binding IsEnabled}"
                                        ToolTip="{Binding DisplayToolTip}"
                                        Click="DayButton_Click">
                                    <TextBlock Text="{Binding Date.Day}"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                               FontSize="{DynamicResource FontSizeMD}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button x:Name="TodayButton"
                        Style="{x:Null}"
                            Grid.Row="3"
                            Height="32"
                            HorizontalAlignment="Center"
                            Margin="0,14,0,0"
                            Padding="10,4"
                            Background="Transparent"
                            Foreground="{DynamicResource AccentBlue}"
                            BorderThickness="0"
                            FontFamily="Segoe UI"
                            FontSize="{DynamicResource FontSizeSM}"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="Today_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Chrome"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="{DynamicResource RadiusSM}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource BgHover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
