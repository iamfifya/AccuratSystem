<Window x:Class="AccuratPanelCWD.UpsellManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AccuratPanelCWD.Controls"
        Title="Настройка умного кассира" 
        Height="750" 
        Width="900"
        WindowStartupLocation="CenterScreen" 
        Background="{DynamicResource BgMain}" 
        WindowStyle="SingleBorderWindow"
        Foreground="{DynamicResource TextMain}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="🧠 Настройка Умного Кассира (Upsell)" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Foreground="{DynamicResource AccentOrange}" 
                   Margin="0,0,0,20"/>

        <!-- Блок создания правила -->
        <Border Grid.Row="1" 
                Background="{DynamicResource BgCard}" 
                CornerRadius="6"
                Padding="20" 
                Margin="0,0,0,20" 
                BorderBrush="{DynamicResource BorderColor}" 
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="➕ Создать новое правило допродажи" 
                           FontWeight="Bold" 
                           FontSize="16" 
                           Foreground="{DynamicResource TextMain}"
                           Margin="0,0,0,15"/>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="30"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Если клиент выбрал эту услугу:" 
                                   Foreground="{DynamicResource TextMuted}" 
                                   FontSize="12"
                                   Margin="0,0,0,8"/>
                        <controls:CustomComboBox x:Name="TriggerServiceCombo" 
                                                 Height="45" 
                                                 DisplayMemberPath="Name" 
                                                 SelectedValuePath="Id" 
                                                 Placeholder="Выберите триггер..."/>
                    </StackPanel>

                    <TextBlock Grid.Column="1" 
                               Text="👉" 
                               VerticalAlignment="Center" 
                               HorizontalAlignment="Center" 
                               FontSize="20"/>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Предложить ему купить эту:" 
                                   Foreground="{DynamicResource TextMuted}" 
                                   FontSize="12"
                                   Margin="0,0,0,8"/>
                        <controls:CustomComboBox x:Name="SuggestedServiceCombo" 
                                                 Height="45" 
                                                 DisplayMemberPath="Name" 
                                                 SelectedValuePath="Id" 
                                                 Placeholder="Выберите допродажу..."/>
                    </StackPanel>
                </Grid>

                <TextBlock Text="Текст подсказки для кассира:" 
                           Foreground="{DynamicResource TextMuted}" 
                           FontSize="12"
                           Margin="0,0,0,8"/>
                <TextBox x:Name="MessageTextBox" 
                         Height="45" 
                         Padding="15,0" 
                         VerticalContentAlignment="Center" 
                         FontSize="14"
                         Margin="0,0,0,15" 
                         Text="Например: Предложите антидождь, сейчас на него акция!"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Премия (бонус) кассиру за продажу:" 
                               VerticalAlignment="Center" 
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextMain}"
                               FontSize="13"/>
                    <TextBox x:Name="BonusTextBox" 
                             Grid.Column="1" 
                             Height="45" 
                             Padding="15,0" 
                             Margin="10,0" 
                             Text="50"
                             FontSize="14"
                             FontWeight="Bold"/>
                    <Button Grid.Column="2" 
                            Content="Сохранить правило" 
                            Click="AddRuleButton_Click" 
                            Style="{StaticResource SuccessBtn}"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Список правил -->
        <Border Grid.Row="2" 
                Background="{DynamicResource BgCard}" 
                CornerRadius="6"
                Padding="15" 
                BorderBrush="{DynamicResource BorderColor}" 
                BorderThickness="1">
            <ListBox x:Name="RulesListBox" 
                     Background="Transparent" 
                     BorderThickness="0" 
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource UpsellBannerBg}" 
                                BorderBrush="{DynamicResource UpsellBannerBorder}" 
                                BorderThickness="2" 
                                CornerRadius="6" 
                                Padding="15" 
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding TriggerServiceName, StringFormat='Если: {0}'}" 
                                               FontWeight="SemiBold" 
                                               FontSize="14"
                                               Foreground="{DynamicResource TextMain}"/>
                                    <TextBlock Text="{Binding SuggestedServiceName, StringFormat='Предложить: {0}'}" 
                                               Foreground="{DynamicResource AccentOrange}" 
                                               FontWeight="Bold" 
                                               FontSize="15" 
                                               Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding Rule.Message, StringFormat='Подсказка: &quot;{0}&quot;'}" 
                                               FontStyle="Italic" 
                                               Foreground="{DynamicResource TextMuted}" 
                                               FontSize="12"
                                               Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding Rule.BonusAmount, StringFormat='Бонус: {0:N0} ₽'}" 
                                               Foreground="{DynamicResource AccentGreen}" 
                                               FontWeight="Bold" 
                                               FontSize="13"
                                               Margin="0,8,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" 
                                        Content="🗑 Удалить" 
                                        Click="DeleteRuleButton_Click" 
                                        Style="{StaticResource DangerBtn}"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</Window>