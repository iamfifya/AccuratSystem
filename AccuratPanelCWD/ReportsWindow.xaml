<Window x:Class="AccuratPanelCWD.ReportsWindow"
        x:Name="RootWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отчеты по сменам"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinWidth="900" MinHeight="550"
        Width="1080" Height="800"
        Background="{DynamicResource BgMain}"
        BorderBrush="{DynamicResource BorderColor}"
        BorderThickness="1"
        WindowStyle="None"
        WindowState="Maximized"
        Foreground="{DynamicResource TextMain}">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок + табы филиалов -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" 
                       Text="📊 Ежедневные отчеты" 
                       FontSize="26" 
                       FontWeight="Bold" 
                       Foreground="{DynamicResource TextMain}" 
                       VerticalAlignment="Center" 
                       Margin="0,0,25,0"/>

            <TabControl Grid.Column="1" 
                        ItemsSource="{Binding BranchTabs}" 
                        SelectedItem="{Binding SelectedBranchTab, Mode=TwoWay}"
                        VerticalAlignment="Center">

                <TabControl.ItemContainerStyle>
                    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                        <Setter Property="Visibility" Value="{Binding DataContext.IsDirector, ElementName=RootWindow, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </Style>
                </TabControl.ItemContainerStyle>

                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding BranchName}" FontSize="12" FontWeight="Bold"/>
                    </DataTemplate>
                </TabControl.ItemTemplate>

                <TabControl.ContentTemplate>
                    <DataTemplate/>
                </TabControl.ContentTemplate>
            </TabControl>
        </Grid>

        <!-- Основной контент -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Левая панель: список смен -->
            <Border Grid.Column="0" 
                    Background="{DynamicResource BgMain}" 
                    CornerRadius="6"
                    Padding="15"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="📁 Закрытые смены" 
                               FontSize="17" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource TextMain}"
                               Margin="0,0,0,12"/>
                    <ListBox x:Name="ReportsListBox" 
                             MinHeight="400" 
                             SelectionChanged="ReportSelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" 
                             Background="Transparent"
                             BorderThickness="0"
                             HorizontalContentAlignment="Stretch">

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="RowBorder"
                                                    Background="{DynamicResource BgCard}"
                                                    BorderBrush="{DynamicResource BorderColor}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="10,8">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource TableRowHover}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource TableRowSelected}"/>
                                                    <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource TableRowSelectedBorder}"/>
                                                    <Setter TargetName="RowBorder" Property="BorderThickness" Value="2"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" 
                                               FontWeight="Bold" 
                                               Text="{Binding Date, StringFormat=📅 {0:dd.MM.yyyy}}" 
                                               FontSize="14" 
                                               VerticalAlignment="Center" 
                                               Foreground="{DynamicResource TextMain}"/>

                                    <TextBlock Grid.Column="1" 
                                               Text="{Binding TotalCars, StringFormat=🚗 {0}}" 
                                               HorizontalAlignment="Center" 
                                               FontSize="14" 
                                               VerticalAlignment="Center" 
                                               Foreground="{DynamicResource TextMuted}"/>

                                    <TextBlock Grid.Column="2" 
                                               Text="{Binding TotalRevenue, StringFormat=💰 {0:N0} ₽}" 
                                               Foreground="{DynamicResource AccentGreen}" 
                                               FontSize="14" 
                                               FontWeight="SemiBold" 
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- Правая панель: детали смены -->
            <Border Grid.Column="1" 
                    Background="{DynamicResource BgMain}" 
                    CornerRadius="6"
                    Padding="20" 
                    Margin="15,0,0,0"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="📋 Детали смены" 
                                   FontSize="17" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource TextMain}"
                                   HorizontalAlignment="Center" 
                                   Margin="0,0,0,15"/>

                        <!-- Основная карточка -->
                        <Border Background="{DynamicResource BgCard}" 
                                CornerRadius="6" 
                                Padding="20" 
                                Margin="0,5"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedReport.Date, StringFormat=📅 Дата: {0:dd.MM.yyyy}}"
                                           Foreground="{DynamicResource TextMain}" FontSize="14"/>
                                <TextBlock Text="{Binding SelectedReport.StartTime, StringFormat=🕐 Начало: {0:HH:mm:ss}}" 
                                           Foreground="{DynamicResource TextMain}" FontSize="14" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding SelectedReport.EndTime, StringFormat=🕒 Конец: {0:HH:mm:ss}}" 
                                           Foreground="{DynamicResource TextMain}" FontSize="14" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding SelectedReport.TotalCars, StringFormat=🚗 Всего заказов (машин): {0}}" 
                                           Foreground="{DynamicResource TextMain}" FontSize="14" Margin="0,6,0,0"/>

                                <TextBlock Text="{Binding SelectedReport.TotalRevenue, StringFormat=💰 Общая выручка: {0:N0} ₽}" 
                                           FontWeight="Bold" 
                                           Foreground="{DynamicResource AccentGreen}" 
                                           FontSize="15"
                                           Margin="0,8,0,0" 
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="{Binding SelectedReport.TotalWasherEarnings, StringFormat=👥 ФОТ сотрудников (Оклад + % + Бонусы): {0:N0} ₽}" 
                                           Foreground="{DynamicResource ReportToPayText}" 
                                           Margin="0,6,0,0" 
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="{Binding SelectedReport.TotalCompanyEarnings, StringFormat=🏢 Компании (Грязными): {0:N0} ₽}" 
                                           Foreground="{DynamicResource TextMain}" 
                                           Margin="0,4,0,0" 
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="{Binding SelectedReport.TotalExpenses, StringFormat=📉 Расходы за смену: {0:N0} ₽}" 
                                           Foreground="{DynamicResource AccentRed}" 
                                           Margin="0,12,0,0" 
                                           FontWeight="SemiBold" 
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedReport.TotalAdvances, StringFormat=💸 Выдано авансов: {0:N0} ₽}" 
                                           Foreground="{DynamicResource AccentYellow}" 
                                           Margin="0,4,0,0" 
                                           FontWeight="SemiBold" 
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding SelectedReport.NetProfit, StringFormat=💎 Чистая прибыль (ЧПКО): {0:N0} ₽}" 
                                           Foreground="{DynamicResource ReportNetProfitValue}" 
                                           Margin="0,6,0,0" 
                                           FontWeight="Bold" 
                                           FontSize="15" 
                                           TextWrapping="Wrap"/>

                                <TextBlock Text="{Binding SelectedReport.Notes, StringFormat=📝 Примечание: {0}}" 
                                           FontSize="12" 
                                           Foreground="{DynamicResource TextMuted}" 
                                           Margin="0,12,0,0" 
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Способы оплаты -->
                        <TextBlock Text="💳 Способы оплаты" 
                                   FontSize="15" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource TextMain}"
                                   Margin="0,15,0,8"/>
                        <Border Background="{DynamicResource BgCard}" 
                                CornerRadius="6" 
                                Padding="20" 
                                Margin="0,0,0,15"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,12">
                                    <TextBlock Text="💵 Наличные" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding SelectedReport.CashAmount, StringFormat={}{0:N0} ₽}" 
                                                   FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextMain}"/>
                                        <TextBlock Text="{Binding SelectedReport.CashCount, StringFormat=' ({0} шт.)'}" 
                                                   FontSize="12" Foreground="{DynamicResource TextLightMuted}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                                    <TextBlock Text="💳 Карта" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding SelectedReport.CardAmount, StringFormat={}{0:N0} ₽}" 
                                                   FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextMain}"/>
                                        <TextBlock Text="{Binding SelectedReport.CardCount, StringFormat=' ({0} шт.)'}" 
                                                   FontSize="12" Foreground="{DynamicResource TextLightMuted}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0">
                                    <TextBlock Text="📱 Перевод" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding SelectedReport.TransferAmount, StringFormat={}{0:N0} ₽}" 
                                                   FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextMain}"/>
                                        <TextBlock Text="{Binding SelectedReport.TransferCount, StringFormat=' ({0} шт.)'}" 
                                                   FontSize="12" Foreground="{DynamicResource TextLightMuted}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1">
                                    <TextBlock Text="🔲 QR-код" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding SelectedReport.QrAmount, StringFormat={}{0:N0} ₽}" 
                                                   FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextMain}"/>
                                        <TextBlock Text="{Binding SelectedReport.QrCount, StringFormat=' ({0} шт.)'}" 
                                                   FontSize="12" Foreground="{DynamicResource TextLightMuted}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Separator Margin="0,15" Height="1" Background="{DynamicResource BorderColor}"/>

                        <!-- Работа сотрудников -->
                        <TextBlock Text="👥 Работа сотрудников (Зарплата)" 
                                   FontSize="15" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource TextMain}"
                                   Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding SelectedReport.EmployeesWork}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource BgCard}" 
                                            CornerRadius="6" 
                                            Padding="12" 
                                            Margin="0,0,0,6"
                                            BorderBrush="{DynamicResource BorderColor}"
                                            BorderThickness="1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding EmployeeName}" 
                                                       FontWeight="SemiBold" 
                                                       Foreground="{DynamicResource TextMain}"
                                                       TextWrapping="Wrap" 
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" 
                                                       Text="{Binding CarsWashed, StringFormat=🚗 Заказов: {0}}" 
                                                       Foreground="{DynamicResource TextMuted}"
                                                       Margin="12,0" 
                                                       TextWrapping="Wrap" 
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" 
                                                       Text="{Binding Earnings, StringFormat=💰 Начислено: {0:N0} ₽}" 
                                                       Foreground="{DynamicResource AccentGreen}" 
                                                       Margin="12,0" 
                                                       TextWrapping="Wrap" 
                                                       VerticalAlignment="Center" 
                                                       ToolTip="Оклад + Процент + Бонусы"/>
                                            <TextBlock Grid.Column="3" 
                                                       Text="{Binding Advances, StringFormat=🔻 Авансы: {0:N0} ₽}" 
                                                       Foreground="{DynamicResource AccentRed}" 
                                                       Margin="12,0" 
                                                       TextWrapping="Wrap" 
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" 
                                                       Text="{Binding ToPay, StringFormat=💳 НА РУКИ: {0:N0} ₽}" 
                                                       Foreground="{DynamicResource ReportToPayText}" 
                                                       Margin="12,0" 
                                                       FontWeight="Bold" 
                                                       TextWrapping="Wrap" 
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Кнопки действий (БЕЗ Width/Height — из AppStyles) -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,20,0,15">
            <Button Content="📅 Интервальный отчет" 
                    Click="CustomReportButton_Click" 
                    Style="{StaticResource PrimaryBtn}"
                    Margin="0,0,8,0"/>
            <Button Content="📄 Экспорт смены" 
                    Click="ExportButton_Click" 
                    Style="{StaticResource SuccessBtn}"
                    Margin="0,0,8,0"/>
            <Button Content="✖ Закрыть" 
                    Click="CloseButton_Click" 
                    Style="{StaticResource DangerBtn}"/>
        </StackPanel>
    </Grid>
</Window>