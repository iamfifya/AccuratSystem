<Window x:Class="AccuratPanelCWD.StockCategoriesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🏷 Категории склада" Height="450" Width="420"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource BgMain}"
        Foreground="{DynamicResource TextMain}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="🏷 Категории номенклатуры" FontWeight="Bold" FontSize="18" Margin="0,0,0,16"/>

        <!-- Обернули ListBox в Border для скруглений, как в остальных карточках -->
        <Border Grid.Row="1" Background="{DynamicResource BgCard}" 
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="2" CornerRadius="6">
            <ListBox x:Name="CategoriesList" DisplayMemberPath="Name"
                     SelectionChanged="CategoriesList_SelectionChanged"
                     Style="{StaticResource CleanListBoxStyle}" Margin="2"/>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Убраны Height и Padding, так как они заданы в AppStyles.xaml -->
            <TextBox x:Name="NameTextBox"/>

            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                <Button Content="💾" Style="{StaticResource SuccessBtn}" Click="Save_Click" ToolTip="Создать / переименовать"/>
                <Button Content="🗑" Style="{StaticResource DangerBtn}" Margin="0" Click="Delete_Click" ToolTip="Удалить (если не используется)"/>
            </StackPanel>
        </Grid>

        <Button Grid.Row="3" Content="✖ Закрыть" Style="{StaticResource DangerBtn}"
                HorizontalAlignment="Center" Margin="0,20,0,0" Click="Close_Click"/>
    </Grid>
</Window>