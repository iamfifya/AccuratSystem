<Window x:Class="AccuratPanelCWD.AddEditClientWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AccuratPanelCWD"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Width="700" Height="950"
        Background="{DynamicResource BgMain}"
        BorderBrush="{DynamicResource BorderColor}"
        BorderThickness="1"
        WindowStyle="SingleBorderWindow"
        Foreground="{DynamicResource TextMain}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,20">

                <!-- Заголовок -->
                <TextBlock Text="{Binding WindowTitle}" 
                           FontSize="22" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource TextMain}" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,25"/>

                <!-- ФИО -->
                <TextBlock Text="ФИО" 
                           FontSize="13" 
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMain}"
                           Margin="0,0,0,8"/>
                <TextBox Text="{Binding CurrentClient.FullName, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,0,0,20" 
                         Height="45" 
                         Padding="15,0"
                         FontSize="14"/>

                <!-- Телефон -->
                <TextBlock Text="Телефон" 
                           FontSize="13" 
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMain}"
                           Margin="0,0,0,8"/>
                <TextBox Text="{Binding CurrentClient.Phone, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,0,0,20" 
                         Height="45" 
                         Padding="15,0"
                         FontSize="14"/>

                <!-- Марка/Модель авто -->
                <TextBlock Text="Марка/Модель авто" 
                           FontSize="13" 
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMain}"
                           Margin="0,0,0,8"/>
                <TextBox Text="{Binding CurrentClient.CarModel, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,0,0,20" 
                         Height="45" 
                         Padding="15,0"
                         FontSize="14"/>

                <!-- Государственный номер -->
                <TextBlock Text="Государственный номер" 
                           FontSize="13" 
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMain}"
                           Margin="0,0,0,8"/>
                <TextBox Text="{Binding CurrentClient.CarNumber, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,0,0,20" 
                         Height="45" 
                         Padding="15,0"
                         FontSize="14"/>

                <!-- Примечание -->
                <TextBlock Text="Примечание" 
                           FontSize="13" 
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMain}"
                           Margin="0,0,0,8"/>
                <TextBox Text="{Binding CurrentClient.Notes, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,0,0,20" 
                         Height="80" 
                         Padding="15,10" 
                         TextWrapping="Wrap" 
                         AcceptsReturn="True"
                         FontSize="13"/>

                <Separator Margin="0,15" Background="{DynamicResource BorderColor}"/>

                <!-- Персональная скидка клиента -->
                <Border Background="{DynamicResource BgCard}" 
                        CornerRadius="6" 
                        Padding="20" 
                        Margin="0,10,0,0"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="💰 Персональная скидка"
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource TextMain}" 
                                   Margin="0,0,0,15"/>

                        <StackPanel Orientation="Horizontal" Margin="0,5">
                            <TextBlock Text="Скидка:" 
                                       Width="80" 
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMain}"
                                       FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="DiscountPercentTextBox" 
                                         Text="{Binding CurrentClient.DefaultDiscountPercent, UpdateSourceTrigger=PropertyChanged}"
                                         Width="100" 
                                         Height="45" 
                                         Padding="10,0" 
                                         HorizontalContentAlignment="Center"
                                         FontSize="16"
                                         FontWeight="Bold"
                                         PreviewTextInput="DiscountPercentTextBox_PreviewTextInput"/>
                                <TextBlock Text="%" 
                                           VerticalAlignment="Center" 
                                           Margin="8,0" 
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextMain}"/>
                                <TextBlock Text="(0-100)" 
                                           Foreground="{DynamicResource TextMuted}" 
                                           FontSize="12" 
                                           VerticalAlignment="Center" 
                                           Margin="15,0"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="Эта скидка будет автоматически подставляться при выборе клиента в заказе" 
                                   FontSize="11" 
                                   Foreground="{DynamicResource TextMuted}" 
                                   Margin="88,10,0,0" 
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

            </StackPanel>

        </ScrollViewer>

        <!-- Кнопки действий -->
        <StackPanel Grid.Row="1" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,20">
            <Button Content="✅ Сохранить" 
                    Click="SaveButton_Click" 
                    Style="{StaticResource SuccessBtn}"/>
            <Button Content="✖ Отмена" 
                    Click="CloseButton_Click" 
                    Style="{StaticResource DangerBtn}"/>
        </StackPanel>
    </Grid>
</Window>