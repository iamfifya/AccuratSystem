<UserControl x:Class="AccuratPanelCWD.Controls.AppointmentsOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AccuratPanelCWD"
             xmlns:controls="clr-namespace:AccuratPanelCWD.Controls"
             xmlns:models="clr-namespace:AccuratPanelCWD.Models"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>
        <!-- Анимация появления -->
        <Storyboard x:Key="ShowAnimation">
            <DoubleAnimation Storyboard.TargetName="OverlayBackground" 
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.25"/>
            <DoubleAnimation Storyboard.TargetName="PopupPanel" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="0.8" To="1" Duration="0:0:0.25"/>
            <DoubleAnimation Storyboard.TargetName="PopupPanel" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="0.8" To="1" Duration="0:0:0.25"/>
            <DoubleAnimation Storyboard.TargetName="PopupPanel" 
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.2"/>
        </Storyboard>

        <!-- Анимация скрытия -->
        <Storyboard x:Key="HideAnimation">
            <DoubleAnimation Storyboard.TargetName="OverlayBackground" 
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="PopupPanel" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                             From="1" To="0.9" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="PopupPanel" 
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                             From="1" To="0.9" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="PopupPanel" 
                             Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.15"/>
        </Storyboard>
    </UserControl.Resources>

    <!-- Затемняющий фон -->
    <Border x:Name="OverlayBackground" 
            Background="#80000000" 
            Visibility="Collapsed"
            Opacity="0">

        <!-- Основная панель с записями -->
        <Border x:Name="PopupPanel"
                Background="{DynamicResource BgMain}" 
                CornerRadius="6" 
                Margin="60,40,60,40" 
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                Opacity="0">

            <!-- RenderTransform для анимации масштаба -->
            <Border.RenderTransform>
                <ScaleTransform ScaleX="0.8" ScaleY="0.8"/>
            </Border.RenderTransform>

            <Grid Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Заголовок и кнопка закрытия -->
                <Grid Grid.Row="0" Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="📅 Предварительные записи" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource TextMain}" 
                               HorizontalAlignment="Center" 
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1" 
                            Content="✖"
                            Style="{StaticResource DangerBtn}"
                            FontWeight="Bold"
                            Click="CloseButton_Click"/>
                </Grid>

                <!-- Фильтр по дате и кнопки действий -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
                    <TextBlock Text="📅 Показать записи за:" 
                               VerticalAlignment="Center" 
                               Foreground="{DynamicResource TextMain}"
                               FontWeight="SemiBold"
                               Margin="0,0,10,0"/>
                    <local:CustomDatePicker x:Name="FilterDatePicker" 
                                            Height="45" 
                                            Width="300" 
                                            Margin="0,0,15,0"/>
                    <Button Content="➕ Новая запись" 
                            Click="NewAppointmentButton_Click" 
                            Style="{StaticResource PrimaryBtn}"
                            Margin="0,0,8,0"/>
                    <Button Content="✏ Редактировать" 
                            Click="EditButton_Click" 
                            Style="{StaticResource WarningBtn}"
                            Margin="0,0,8,0"/>
                    <Button Content="🗑 Удалить" 
                            Click="DeleteButton_Click" 
                            Style="{StaticResource DangerBtn}"/>
                </StackPanel>

                <!-- Три бокса -->
                <TabControl Grid.Row="2" 
                            ItemsSource="{Binding BranchTabs}" 
                            SelectedItem="{Binding SelectedBranchTab, Mode=TwoWay}">
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding BranchName}" FontSize="14" FontWeight="Bold"/>
                        </DataTemplate>
                    </TabControl.ItemTemplate>

                    <TabControl.ContentTemplate>
                        <DataTemplate>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" 
                                          HorizontalScrollBarVisibility="Disabled" 
                                          Padding="0,0,15,0">
                                <StackPanel>

                                    <StackPanel Visibility="{Binding HasWashZones, Converter={StaticResource BoolToVisibilityConverter}}" 
                                                Margin="0,0,0,20">
                                        <TextBlock Text="💦 МОЕЧНАЯ ЗОНА" 
                                                   FontSize="18" 
                                                   FontWeight="Bold" 
                                                   Foreground="{DynamicResource TextMain}" 
                                                   Margin="5,0,0,10" 
                                                   Opacity="0.9"/>
                                        <ItemsControl ItemsSource="{Binding WashZones}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <GroupBox Header="{Binding ZoneName}" 
                                                              Width="360" 
                                                              MinHeight="400" 
                                                              Margin="5,0,15,15">
                                                        <ListBox ItemsSource="{Binding Orders}"
                                                                 SelectedItem="{Binding DataContext.SelectedItem, RelativeSource={RelativeSource AncestorType=controls:AppointmentsOverlay}, Mode=TwoWay}"
                                                                 ItemTemplate="{StaticResource OrderTemplate}"
                                                                 Style="{StaticResource CleanListBoxStyle}"
                                                                 MouseDoubleClick="AppointmentList_MouseDoubleClick"
                                                                 PreviewMouseLeftButtonDown="ListBox_PreviewMouseLeftButtonDown"
                                                                 Margin="5">
                                                            <ListBox.ContextMenu>
                                                                <ContextMenu>
                                                                    <MenuItem Header="✏ Редактировать" Click="EditButton_Click"/>
                                                                    <MenuItem Header="🔄 Преобразовать в заказ" Click="ConvertToOrderButton_Click"/>
                                                                    <Separator/>
                                                                    <MenuItem Header="🗑 Удалить" Click="DeleteButton_Click" Foreground="{DynamicResource AccentRed}"/>
                                                                </ContextMenu>
                                                            </ListBox.ContextMenu>
                                                        </ListBox>
                                                    </GroupBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding HasServiceZones, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="🔧 СЕРВИСНАЯ ЗОНА" 
                                                   FontSize="18" 
                                                   FontWeight="Bold" 
                                                   Foreground="{DynamicResource TextMain}" 
                                                   Margin="5,0,0,10" 
                                                   Opacity="0.9"/>
                                        <ItemsControl ItemsSource="{Binding ServiceZones}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <GroupBox Header="{Binding ZoneName}" 
                                                              Width="360" 
                                                              MinHeight="400" 
                                                              Margin="5,0,15,15">
                                                        <ListBox ItemsSource="{Binding Orders}"
                                                                 SelectedItem="{Binding DataContext.SelectedItem, RelativeSource={RelativeSource AncestorType=controls:AppointmentsOverlay}, Mode=TwoWay}"
                                                                 ItemTemplate="{StaticResource OrderTemplate}"
                                                                 Style="{StaticResource CleanListBoxStyle}"
                                                                 MouseDoubleClick="AppointmentList_MouseDoubleClick"
                                                                 PreviewMouseLeftButtonDown="ListBox_PreviewMouseLeftButtonDown"
                                                                 Margin="5">
                                                            <ListBox.ContextMenu>
                                                                <ContextMenu>
                                                                    <MenuItem Header="✏ Редактировать" Click="EditButton_Click"/>
                                                                    <MenuItem Header="🔄 Преобразовать в заказ" Click="ConvertToOrderButton_Click"/>
                                                                    <Separator/>
                                                                    <MenuItem Header="🗑 Удалить" Click="DeleteButton_Click" Foreground="{DynamicResource AccentRed}"/>
                                                                </ContextMenu>
                                                            </ListBox.ContextMenu>
                                                        </ListBox>
                                                    </GroupBox>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                </StackPanel>
                            </ScrollViewer>
                        </DataTemplate>
                    </TabControl.ContentTemplate>
                </TabControl>

                <!-- Кнопка закрытия внизу -->
                <StackPanel Grid.Row="3" 
                            Orientation="Horizontal" 
                            HorizontalAlignment="Center" 
                            Margin="0,20,0,0">
                    <Button Content="✖ Закрыть" 
                            Click="CloseButton_Click" 
                            Style="{StaticResource DangerBtn}"
                            FontSize="14"/>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</UserControl>