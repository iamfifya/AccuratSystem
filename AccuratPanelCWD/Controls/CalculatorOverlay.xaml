<UserControl x:Class="AccuratPanelCWD.Controls.CalculatorOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AccuratPanelCWD"
             xmlns:controls="clr-namespace:AccuratPanelCWD.Controls"
             xmlns:models="clr-namespace:AccuratPanelCWD.Models"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200">

    <UserControl.Resources>
        <!-- Стиль кнопок классического калькулятора -->
        <Style x:Key="CalcBttnStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BgCard}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource BgSelected}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Анимации (синхронизированы с AppointmentsOverlay) -->
        <Storyboard x:Key="ShowAnimation">
            <DoubleAnimation Storyboard.TargetName="OverlayBackground" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25"/>
            <DoubleAnimation Storyboard.TargetName="PopupPanel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="PopupPanel" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.8" To="1" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PopupPanel" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.8" To="1" Duration="0:0:0.25">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="HideAnimation">
            <DoubleAnimation Storyboard.TargetName="OverlayBackground" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="PopupPanel" Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.15"/>
            <DoubleAnimation Storyboard.TargetName="PopupPanel" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="0.9" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="PopupPanel" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="0.9" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction>
                    <QuadraticEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Карточка КУПЮРЫ -->
        <DataTemplate x:Key="BanknoteCardTemplate">
            <Border Background="{DynamicResource BgCard}" CornerRadius="10" Margin="5" Padding="12,10"
            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold"
                        Foreground="{DynamicResource TextMain}" 
                        HorizontalAlignment="Center" Margin="0,0,0,8"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <Button Content="−" Margin="0" FontSize="18" FontWeight="Bold" Cursor="Hand"
                        Click="Money_Minus_Click" Tag="{Binding}" Style="{StaticResource DangerBtn}"/>
                        <TextBox Grid.Column="1" Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}"
                         Margin="6,0" TextAlignment="Center" 
                         FontSize="15" FontWeight="Bold" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="2" Content="+" Margin="0" FontSize="18" FontWeight="Bold" Cursor="Hand"
                        Click="Money_Plus_Click" Tag="{Binding}" Style="{StaticResource SuccessBtn}"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Карточка МОНЕТЫ (компактная) -->
        <DataTemplate x:Key="CoinCardTemplate">
            <Border Background="{DynamicResource BgCard}" CornerRadius="8" Margin="4" Padding="8,6"
            BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold"
                        Foreground="{DynamicResource TextMuted}" 
                        HorizontalAlignment="Center" Margin="0,0,0,6"/>

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="45"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="45"/>
                        </Grid.ColumnDefinitions>

                        <Button Content="−" Margin="0" FontSize="13" FontWeight="Bold" Cursor="Hand"
                        Click="Money_Minus_Click" Tag="{Binding}" Style="{StaticResource DangerBtn}"/>
                        <TextBox Grid.Column="1" Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}"
                         Margin="4,0" TextAlignment="Center" 
                         FontSize="13" FontWeight="Bold" VerticalContentAlignment="Center"/>
                        <Button Grid.Column="2" Content="+" Margin="0" FontSize="13" FontWeight="Bold" Cursor="Hand"
                        Click="Money_Plus_Click" Tag="{Binding}" Style="{StaticResource SuccessBtn}"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <!-- ГЛАВНЫЙ КОНТЕЙНЕР -->
    <Border x:Name="OverlayBackground" 
            Background="#A6000000" 
            Visibility="Collapsed" 
            Opacity="0"
            HorizontalAlignment="Stretch" 
            VerticalAlignment="Stretch"
            MouseLeftButtonDown="Overlay_MouseLeftButtonDown">

        <Border x:Name="PopupPanel" 
                Background="{DynamicResource BgMain}" 
                CornerRadius="6" 
                HorizontalAlignment="Center" 
                VerticalAlignment="Center"
                Width="700" Height="850" 
                Opacity="0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="10" Opacity="0.4"/>
            </Border.Effect>
            <Border.RenderTransform>
                <ScaleTransform ScaleX="0.8" ScaleY="0.8"/>
            </Border.RenderTransform>

            <Grid Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- Заголовок -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="🧮 Калькулятор" 
                               FontSize="24" 
                               FontWeight="Black" 
                               Foreground="{DynamicResource TextMain}" 
                               HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Переключатель режимов -->
                <TabControl Grid.Row="1" 
                            Background="{DynamicResource CalcBg}" 
                            BorderThickness="0" 
                            Margin="0,0,0,15">
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem">
                            <Setter Property="Padding" Value="10,5"/>
                            <Setter Property="HorizontalAlignment" Value="Center"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TabItem">
                                        <Border x:Name="Border" Background="Transparent" CornerRadius="6" Margin="2,2,2,0" Padding="10,5">
                                            <ContentPresenter ContentSource="Header"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentBlue}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TabControl.ItemContainerStyle>

                    <TabControl.Items>
                        <TabItem Header="Классический" IsSelected="True">
                            <Grid Margin="0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Дисплей на всю ширину -->
                                <Border Background="{DynamicResource BgCard}"
                                CornerRadius="10"
                                Padding="20,15" 
                                Margin="0,0,0,20" 
                                BorderBrush="{DynamicResource BorderColor}" 
                                BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Предыдущее выражение -->
                                        <TextBlock x:Name="ClassicExpressionText"
                                        Grid.Row="0"
                                        Text="{Binding ClassicExpression}" 
                                        FontSize="16"
                                        Foreground="{DynamicResource TextMuted}"
                                        TextAlignment="Right"
                                        Margin="0,0,0,4"
                                        MinHeight="22"/>

                                        <!-- Текущее число -->
                                        <TextBlock Grid.Row="1"
                                        Text="{Binding ClassicResult}" 
                                        FontSize="48" 
                                        FontWeight="SemiBold" 
                                        Foreground="{DynamicResource TextMain}" 
                                        TextAlignment="Right"
                                        TextTrimming="CharacterEllipsis"/>
                                    </Grid>
                                </Border>

                                <UniformGrid Grid.Row="1" Columns="4" Rows="5">
                                    <Button Content="C" Style="{StaticResource CalcBttnStyle}" Click="Calc_Clear_Click" 
                                    Background="{DynamicResource CalcClearBg}" Foreground="{DynamicResource AccentRed}"/>
                                    <Button Content="±" Style="{StaticResource CalcBttnStyle}" Click="Calc_Sign_Click"/>
                                    <Button Content="%" Style="{StaticResource CalcBttnStyle}" Click="Calc_Percent_Click"/>
                                    <Button Content="÷" Style="{StaticResource CalcBttnStyle}" Click="Calc_Op_Click" 
                                    Background="{DynamicResource CalcOperatorBg}"/>

                                    <Button Content="7" Style="{StaticResource CalcBttnStyle}" Click="Calc_Num_Click"/>
                                    <Button Content="8" Style="{StaticResource CalcBttnStyle}" Click="Calc_Num_Click"/>
                                    <Button Content="9" Style="{StaticResource CalcBttnStyle}" Click="Calc_Num_Click"/>
                                    <Button Content="×" Style="{StaticResource CalcBttnStyle}" Click="Calc_Op_Click" 
                                    Background="{DynamicResource CalcOperatorBg}"/>

                                    <Button Content="4" Style="{StaticResource CalcBttnStyle}" Click="Calc_Num_Click"/>
                                    <Button Content="5" Style="{StaticResource CalcBttnStyle}" Click="Calc_Num_Click"/>
                                    <Button Content="6" Style="{StaticResource CalcBttnStyle}" Click="Calc_Num_Click"/>
                                    <Button Content="-" Style="{StaticResource CalcBttnStyle}" Click="Calc_Op_Click" 
                                    Background="{DynamicResource CalcOperatorBg}"/>

                                    <Button Content="1" Style="{StaticResource CalcBttnStyle}" Click="Calc_Num_Click"/>
                                    <Button Content="2" Style="{StaticResource CalcBttnStyle}" Click="Calc_Num_Click"/>
                                    <Button Content="3" Style="{StaticResource CalcBttnStyle}" Click="Calc_Num_Click"/>
                                    <Button Content="+" Style="{StaticResource CalcBttnStyle}" Click="Calc_Op_Click" 
                                    Background="{DynamicResource CalcOperatorBg}"/>

                                    <!-- Backspace вместо пустой кнопки -->
                                    <Button Content="⌫" Style="{StaticResource CalcBttnStyle}" Click="Calc_Backspace_Click"
                                    FontSize="20" Foreground="{DynamicResource AccentOrange}"/>
                                    <Button Content="0" Style="{StaticResource CalcBttnStyle}" Click="Calc_Num_Click"/>
                                    <Button Content="," Style="{StaticResource CalcBttnStyle}" Click="Calc_Comma_Click"/>
                                    <Button Content="=" Style="{StaticResource CalcBttnStyle}" Click="Calc_Equal_Click" 
                                    Background="{DynamicResource AccentGreen}" Foreground="White"/>
                                </UniformGrid>
                            </Grid>
                        </TabItem>

                        <TabItem Header="Денежный">
                            <Grid Margin="0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- ИТОГО -->
                                <Border Grid.Row="0" Background="{DynamicResource TextMain}" 
                                CornerRadius="12" Padding="20,15" Margin="0,0,0,15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="ИТОГО В КАССЕ" Foreground="{DynamicResource TextLightMuted}" 
                                        FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding MoneyTotal, StringFormat={}{0:N0} ₽}" 
                                        Foreground="{DynamicResource AccentGreen}"
                                        FontSize="30" FontWeight="Black" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>

                                        <!-- КУПЮРЫ: индексы 0–8 (3 колонки = ровные 3 ряда по 3) -->
                                        <TextBlock Text="Купюры" FontSize="16" FontWeight="Bold"
                                        Foreground="{DynamicResource TextMain}" Margin="5,0,0,5"/>
                                        <UniformGrid Columns="3">
                                            <ContentControl Content="{Binding Denominations[0]}" ContentTemplate="{StaticResource BanknoteCardTemplate}"/>
                                            <ContentControl Content="{Binding Denominations[1]}" ContentTemplate="{StaticResource BanknoteCardTemplate}"/>
                                            <ContentControl Content="{Binding Denominations[2]}" ContentTemplate="{StaticResource BanknoteCardTemplate}"/>
                                            <ContentControl Content="{Binding Denominations[3]}" ContentTemplate="{StaticResource BanknoteCardTemplate}"/>
                                            <ContentControl Content="{Binding Denominations[4]}" ContentTemplate="{StaticResource BanknoteCardTemplate}"/>
                                            <ContentControl Content="{Binding Denominations[5]}" ContentTemplate="{StaticResource BanknoteCardTemplate}"/>
                                            <ContentControl Content="{Binding Denominations[6]}" ContentTemplate="{StaticResource BanknoteCardTemplate}"/>
                                            <ContentControl Content="{Binding Denominations[7]}" ContentTemplate="{StaticResource BanknoteCardTemplate}"/>
                                            <ContentControl Content="{Binding Denominations[8]}" ContentTemplate="{StaticResource BanknoteCardTemplate}"/>
                                        </UniformGrid>

                                        <Separator Background="{DynamicResource BorderColor}" Margin="5,15"/>

                                        <!-- МОНЕТЫ: индексы 9–12 (один ряд из 4) -->
                                        <TextBlock Text="Монеты" FontSize="16" FontWeight="Bold"
                                        Foreground="{DynamicResource TextMuted}" Margin="5,15,0,5"/>
                                        <UniformGrid Columns="4">
                                            <ContentControl Content="{Binding Denominations[9]}" ContentTemplate="{StaticResource CoinCardTemplate}"/>
                                            <ContentControl Content="{Binding Denominations[10]}" ContentTemplate="{StaticResource CoinCardTemplate}"/>
                                            <ContentControl Content="{Binding Denominations[11]}" ContentTemplate="{StaticResource CoinCardTemplate}"/>
                                            <ContentControl Content="{Binding Denominations[12]}" ContentTemplate="{StaticResource CoinCardTemplate}"/>
                                        </UniformGrid>

                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </TabItem>
                    </TabControl.Items>
                </TabControl>

                <!-- ДОПИСАННАЯ Кнопка закрытия и закрывающие теги -->
                <Button Grid.Row="3" 
                        Content="✖ Закрыть" 
                        Click="CloseButton_Click" 
                        Style="{StaticResource DangerBtn}"
                        Width="200" 
                        Height="50" 
                        FontSize="16"
                        HorizontalAlignment="Center" />
            </Grid>
        </Border>
    </Border>
</UserControl>