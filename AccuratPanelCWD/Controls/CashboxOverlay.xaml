<UserControl x:Class="AccuratPanelCWD.Controls.CashboxOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:AccuratPanelCWD.Controls"
             Background="Transparent">

    <UserControl.Resources>
        <Storyboard x:Key="ShowAnimation">
            <DoubleAnimation Storyboard.TargetName="OverlayBackground" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="PopupPanel" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.9" To="1" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="PopupPanel" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.9" To="1" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="PopupPanel" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <Border x:Name="OverlayBackground" Background="#90000000" Opacity="0" Visibility="Collapsed"/>

        <Border x:Name="PopupPanel" 
                Background="{DynamicResource BgMain}" 
                CornerRadius="6" 
                Width="950" 
                Height="650" 
                VerticalAlignment="Center" 
                HorizontalAlignment="Center" 
                BorderBrush="{DynamicResource BorderColor}" 
                BorderThickness="1"
                Opacity="0" 
                Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.4"/>
            </Border.Effect>
            <Border.RenderTransform>
                <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
            </Border.RenderTransform>

            <Grid Margin="25">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Заголовок -->
                <DockPanel Grid.Row="0" LastChildFill="False" Margin="0,0,0,20" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="💰 Касса смены" 
                                   FontSize="26" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource TextMain}"/>
                    </StackPanel>
                    <Button Click="Close_Click" 
                            DockPanel.Dock="Right" 
                            Background="Transparent" 
                            BorderThickness="0" 
                            Cursor="Hand"
                            Width="45"
                            Height="45">
                        <TextBlock Text="✕" 
                                   VerticalAlignment="Center" 
                                   FontSize="24" 
                                   Foreground="{DynamicResource TextMain}"
                                   FontWeight="Bold"/>
                    </Button>
                </DockPanel>

                <!-- Статистические карточки -->
                <Grid Grid.Row="1" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" 
                            Background="{DynamicResource BgCard}" 
                            CornerRadius="6" 
                            Padding="15" 
                            Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="💵 Наличных в ящике" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock Text="{Binding CashInHand, StringFormat={}{0:N0} ₽}" 
                                       FontSize="24" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource AccentGreen}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" 
                            Background="{DynamicResource BgCard}" 
                            CornerRadius="6" 
                            Padding="15" 
                            Margin="5,0,5,0">
                        <StackPanel>
                            <TextBlock Text="📉 Расходы / Авансы" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock Text="{Binding TotalExpenses, StringFormat={}{0:N0} ₽}" 
                                       FontSize="24" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource AccentRed}"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" 
                            Background="{DynamicResource TextMain}" 
                            CornerRadius="6" 
                            Padding="15" 
                            Margin="10,0,0,0">
                        <StackPanel>
                            <TextBlock Text="🏢 Чистая прибыль (наличная)" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource TextLightMuted}"/>
                            <TextBlock Text="{Binding NetCashProfit, StringFormat={}{0:N0} ₽}" 
                                       FontSize="24" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource BgCard}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Основной контент -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Лента операций -->
                    <Border Grid.Column="0" 
                            Background="{DynamicResource BgCard}" 
                            CornerRadius="6" 
                            Padding="15" 
                            Margin="0,0,15,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" 
                                       Text="📜 Лента операций" 
                                       FontWeight="Bold" 
                                       FontSize="14"
                                       Foreground="{DynamicResource TextMain}"
                                       Margin="0,0,0,10"/>
                            <ListBox ItemsSource="{Binding Transactions}" 
                                     BorderThickness="0" 
                                     Background="Transparent" 
                                     HorizontalContentAlignment="Stretch">

                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="10"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter Margin="0,2"/>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource SeparatorColor}" 
                                                BorderThickness="0,0,0,1" 
                                                Padding="5,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Icon}" 
                                                           FontSize="18" 
                                                           VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" 
                                                            VerticalAlignment="Center" 
                                                            Margin="10,0">
                                                    <TextBlock Text="{Binding Type}" 
                                                               FontWeight="Bold" 
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextMain}"/>
                                                    <TextBlock Text="{Binding Comment}" 
                                                               FontSize="11" 
                                                               Foreground="{DynamicResource TextMuted}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" 
                                                           Text="{Binding FormattedAmount}" 
                                                           FontWeight="Bold" 
                                                           FontSize="13"
                                                           Foreground="{Binding ColorHex, Converter={StaticResource HexToBrushConverter}}" 
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- Форма новой операции -->
                    <Border Grid.Column="1" 
                            Background="{DynamicResource BgCard}" 
                            CornerRadius="6" 
                            Padding="15">
                        <StackPanel>
                            <TextBlock Text="➕ Новая операция" 
                                       FontWeight="Bold" 
                                       FontSize="14"
                                       Foreground="{DynamicResource TextMain}"
                                       Margin="0,0,0,15"/>

                            <controls:CustomComboBox x:Name="TypeCashTransactionCombo" 
                                                     Margin="0,5,0,10" 
                                                     Height="50"
                                                     ItemsSource="{Binding OperationTypes}"
                                                     SelectedValue="{Binding SelectedOperationType, Mode=TwoWay}"
                                                     SelectedValuePath="Value"
                                                     DisplayMemberPath="Key"
                                                     Placeholder="Выберите тип операции"/>

                            <controls:CustomComboBox x:Name="EmployeeCombo" 
                                                     Margin="0,0,0,10" 
                                                     Height="50"
                                                     Visibility="{Binding EmployeeComboVisibility}"
                                                     ItemsSource="{Binding ActiveEmployees}"
                                                     SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}"
                                                     DisplayMemberPath="FullName"
                                                     Placeholder="Кому выдаем аванс?"/>

                            <TextBlock Text="Сумма (₽)" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource TextMuted}"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="AmountText" 
                                     Height="45" 
                                     FontSize="14" 
                                     FontWeight="Bold" 
                                     Padding="15,0" 
                                     Margin="0,0,0,15"/>

                            <TextBlock Text="Комментарий" 
                                       FontSize="12" 
                                       Foreground="{DynamicResource TextMuted}"
                                       Margin="0,0,0,5"/>
                            <TextBox x:Name="CommentText" 
                                     Height="60" 
                                     TextWrapping="Wrap" 
                                     AcceptsReturn="True" 
                                     Padding="10" 
                                     Margin="0,0,0,20"
                                     FontSize="12"/>

                            <Button Content="Провести операцию" 
                                    Click="AddTransaction_Click" 
                                    Style="{StaticResource PrimaryBtn}"
                                    Height="50"
                                    FontSize="14"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>