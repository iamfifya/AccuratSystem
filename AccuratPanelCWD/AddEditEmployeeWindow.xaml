<Window x:Class="AccuratPanelCWD.AddEditEmployeeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AccuratPanelCWD"
        xmlns:controls="clr-namespace:AccuratPanelCWD.Controls"
        Title="Редактирование сотрудника"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize" 
        Width="700" Height="850" 
        Background="{DynamicResource BgMain}"
        BorderBrush="{DynamicResource BorderColor}"
        BorderThickness="1"
        WindowStyle="SingleBorderWindow"
        Foreground="{DynamicResource TextMain}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Область со скроллом -->
        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,20">

                <!-- Заголовок -->
                <TextBlock Text="{Binding Title}" 
                           FontSize="22" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource TextMain}"
                           Margin="0,0,0,25" 
                           HorizontalAlignment="Center"/>

                <!-- ФИО -->
                <TextBlock Text="ФИО" 
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMain}"
                           Margin="0,0,0,8"/>
                <TextBox Text="{Binding CurrentEmployee.FullName, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,0,0,20" 
                         Padding="15,0"
                         />

                <!-- Телефон -->
                <TextBlock Text="📱 Телефон" 
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMain}"
                           Margin="0,0,0,8"/>
                <TextBox x:Name="PhoneTextBox" 
                         Text="{Binding CurrentEmployee.Phone, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,0,0,5" 
                         Padding="15,0" 
                         PreviewTextInput="PhoneTextBox_PreviewTextInput"
                         TextChanged="PhoneTextBox_TextChanged" 
                         MaxLength="20"/>
                <TextBlock Text="Формат: 89996094363" 
                           Foreground="{DynamicResource TextMuted}" 
                           Margin="0,0,0,20" 
                           HorizontalAlignment="Left"/>

                <!-- Логин -->
                <TextBlock Text="Логин" 
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMain}"
                           Margin="0,0,0,8"/>
                <TextBox Text="{Binding CurrentEmployee.Login, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,0,0,20" 
                         Padding="15,0"/>

                <!-- Пароль -->
                <TextBlock Text="Пароль" 
                            
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMain}"
                           Margin="0,0,0,8"/>
                <PasswordBox x:Name="PasswordBox" 
                             Margin="0,0,0,20" 
                             Padding="15,0" 
                             VerticalContentAlignment="Center"/>

                <!-- Должность -->
                <controls:CustomComboBox x:Name="RoleComboBox" 
                                         Header="Категория-фильтр"
                                         Margin="0,0,0,20" 
                                         Placeholder="Выберите должность"
                                         DisplayMemberPath="Name" 
                                         SelectedValuePath="Id"
                                         SelectedValue="{Binding CurrentEmployee.RoleId, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Секция зарплаты -->
                <Border Background="{DynamicResource BgCard}" 
                        CornerRadius="6" 
                        Padding="20" 
                        Margin="0,5,0,20"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="💰 Параметры оплаты"
                                   FontSize="16" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource TextMain}" 
                                   Margin="0,0,0,15"/>

                        <!-- Ставка зарплаты -->
                        <TextBlock Text="Ставка зарплаты (%)" 
                                    
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMain}"
                                   Margin="0,0,0,8"/>
                        <TextBox Text="{Binding CurrentEmployee.BaseWagePercentage, UpdateSourceTrigger=PropertyChanged}" 
                                 Margin="0,0,0,15" 
                                  
                                 Padding="15,0"
                                 />

                        <!-- Фиксированный оклад -->
                        <TextBlock Text="Фиксированный оклад за смену (₽)" 
                                    
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMain}"
                                   Margin="0,0,0,8"/>
                        <TextBox x:Name="SalaryTextBox" 
                                  
                                 Padding="15,0" 
                                 VerticalContentAlignment="Center"
                                 
                                 Text="{Binding CurrentEmployee.BaseSalaryPerShift, UpdateSourceTrigger=PropertyChanged, FallbackValue=0}"/>
                    </StackPanel>
                </Border>

                <!-- Филиал привязки -->
                <TextBlock Text="📂 Филиал привязки" 
                            
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMain}"
                           Margin="0,0,0,8"/>
                <controls:CustomComboBox x:Name="BranchComboBox" 
                                         Margin="0,0,0,20" 
                                          
                                         Placeholder="Выберите филиал"
                                         DisplayMemberPath="Name" 
                                         SelectedValuePath="Id"
                                         SelectedValue="{Binding CurrentEmployee.BranchId, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Чекбокс трудоустройства -->
                <CheckBox Content="Трудоустроен" 
                          IsChecked="{Binding CurrentEmployee.IsActive}" 
                          Margin="0,10,0,0" 
                          HorizontalAlignment="Left" 
                          Foreground="{DynamicResource TextMain}"
                          
                          FontWeight="SemiBold"/>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки действий -->
        <StackPanel Grid.Row="1" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,20">
            <Button Content="✅ Сохранить" 
                    Click="SaveButton_Click" 
                    Style="{StaticResource SuccessBtn}"/>
            <Button Content="✖ Отмена" 
                    Click="CloseButton_Click" 
                    Style="{StaticResource DangerBtn}"/>
        </StackPanel>
    </Grid>
</Window>