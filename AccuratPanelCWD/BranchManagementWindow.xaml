<Window x:Class="AccuratPanelCWD.BranchManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление филиалами" 
        Height="750" Width="1100"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource BgMain}"
        BorderBrush="{DynamicResource BorderColor}"
        BorderThickness="1"
        Foreground="{DynamicResource TextMain}"
        Focusable="True">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель: список филиалов -->
        <Border Background="{DynamicResource BgCard}" 
                CornerRadius="6"
                Padding="20" 
                Margin="0,0,15,0"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="🏢 Ваши филиалы" 
                           FontWeight="Bold" 
                           FontSize="20" 
                           Margin="0,0,0,20" 
                           Foreground="{DynamicResource TextMain}"/>

                <ListBox x:Name="BranchesListBox" 
                         Grid.Row="1" 
                         DisplayMemberPath="Name" 
                         SelectionChanged="BranchesListBox_SelectionChanged"
                         BorderThickness="1" 
                         BorderBrush="{DynamicResource BorderColor}" 
                         Background="{DynamicResource BgMain}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Padding="5">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="MinHeight" Value="45"/>
                            <Setter Property="VerticalContentAlignment" Value="Center"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Border"
                                                Background="{DynamicResource BgCard}"
                                                BorderBrush="{DynamicResource BorderColor}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}"
                                                Margin="{TemplateBinding Margin}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource AccentBlue}"/>
                                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                                                <Setter Property="Foreground" Value="White"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource BgSelected}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <Button Grid.Row="2" 
                        Content="➕ Добавить филиал" 
                        Margin="0,20,0,0"
                        Style="{StaticResource PrimaryBtn}"
                        Click="AddNewBranch_Click"/>
            </Grid>
        </Border>

        <!-- Правая панель: форма редактирования -->
        <Border Grid.Column="1" 
                Background="{DynamicResource BgCard}" 
                CornerRadius="6"
                Padding="30"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.08" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid x:Name="EditPanel" Grid.Row="0" IsEnabled="False">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовок -->
                    <TextBlock x:Name="EditTitleTextBlock" 
                               Text="Редактирование филиала" 
                               FontWeight="Bold" 
                               FontSize="22" 
                               Foreground="{DynamicResource TextMain}" 
                               Margin="0,0,0,25"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,10,20">
                            <!-- Название -->
                            <TextBlock Text="Название филиала" 
                                       FontSize="13" 
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMain}"
                                       Margin="0,0,0,8"/>
                            <TextBox x:Name="NameTextBox" 
                                     Height="45" 
                                     Padding="15,0"
                                     FontSize="14"/>

                            <!-- Адрес -->
                            <TextBlock Text="Адрес" 
                                       FontSize="13" 
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMain}"
                                       Margin="0,20,0,8"/>
                            <TextBox x:Name="AddressTextBox" 
                                     Height="45" 
                                     Padding="15,0"
                                     FontSize="14"/>

                            <!-- Телефон -->
                            <TextBlock Text="Телефон" 
                                       FontSize="13" 
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMain}"
                                       Margin="0,20,0,8"/>
                            <TextBox x:Name="PhoneTextBox" 
                                     Height="45" 
                                     Padding="15,0"
                                     FontSize="14"/>

                            <!-- Постов и подъёмников -->
                            <Grid Margin="0,20,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Постов мойки (шт)" 
                                               FontSize="13" 
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMain}"
                                               Margin="0,0,0,8"/>
                                    <TextBox x:Name="WashBaysTextBox" 
                                             Height="45" 
                                             Padding="15,0"
                                             FontSize="14"
                                             PreviewTextInput="NumericOnly_PreviewTextInput"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                    <TextBlock Text="Подъёмников сервиса (шт)" 
                                               FontSize="13" 
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMain}"
                                               Margin="0,0,0,8"/>
                                    <TextBox x:Name="ServiceLiftsTextBox" 
                                             Height="45" 
                                             Padding="15,0"
                                             FontSize="14"
                                             PreviewTextInput="NumericOnly_PreviewTextInput"/>
                                </StackPanel>
                            </Grid>

                            <!-- Чекбокс активности -->
                            <CheckBox x:Name="IsActiveCheckBox" 
                                      Content="Филиал активен (работает)" 
                                      FontWeight="SemiBold"  
                                      Margin="0,25,0,0" 
                                      Foreground="{DynamicResource AccentGreen}"
                                      FontSize="14"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Кнопки сохранения (БЕЗ Width/Height — размеры из AppStyles) -->
                    <StackPanel Grid.Row="2" 
                                Orientation="Horizontal" 
                                HorizontalAlignment="Center" 
                                Margin="0,20,0,0">
                        <Button Content="✅ Сохранить" 
                                Style="{StaticResource SuccessBtn}"
                                Margin="0,0,10,0"
                                Click="SaveBranch_Click"/>

                        <Button x:Name="DeleteButton" 
                                Content="🗑 Удалить" 
                                Style="{StaticResource DangerBtn}"
                                Click="DeleteBranch_Click"/>
                    </StackPanel>
                </Grid>

                <!-- Кнопка возврата (БЕЗ Width/Height) -->
                <Button Grid.Row="1" 
                        Content="✖ Вернуться к столу управляющего" 
                        Click="CloseButton_Click" 
                        Style="{StaticResource DangerBtn}"
                        HorizontalAlignment="Center"
                        Margin="0,20,0,0"/>
            </Grid>
        </Border>
    </Grid>
</Window>