<Window x:Class="AccuratPanelCWD.DiscountRulesManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AccuratPanelCWD.Controls" 
        xmlns:local="clr-namespace:AccuratPanelCWD"
        Title="Управление правилами скидок" 
        Height="750" 
        Width="850"
        WindowStartupLocation="CenterScreen" 
        Background="{DynamicResource BgMain}" 
        WindowStyle="SingleBorderWindow"
        Foreground="{DynamicResource TextMain}">

    <Window.Resources>
        <local:BooleanToDiscountTypeConverter x:Key="BooleanToDiscountTypeConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="🎁 Настройка Правил Скидок" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Foreground="{DynamicResource AccentBlue}" 
                   Margin="0,0,0,20"/>

        <!-- Блок создания нового правила -->
        <Border Grid.Row="1" 
                Background="{DynamicResource BgCard}" 
                CornerRadius="6"
                Padding="20" 
                Margin="0,0,0,20" 
                BorderBrush="{DynamicResource BorderColor}" 
                BorderThickness="1">
            <StackPanel>
                <TextBlock Text="➕ Создать новое правило" 
                           FontWeight="Bold" 
                           FontSize="16" 
                           Foreground="{DynamicResource TextMain}"
                           Margin="0,0,0,15"/>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Название правила -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="Название (например: 'Дождь' или 'Пенсионер')" 
                                   Foreground="{DynamicResource TextMuted}" 
                                   FontSize="12"
                                   Margin="0,0,0,8"/>
                        <TextBox x:Name="RuleNameTextBox" 
                                 Height="45" 
                                 Padding="15,0" 
                                 VerticalContentAlignment="Center"
                                 FontSize="14"/>
                    </StackPanel>

                    <!-- Значение -->
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="Значение" 
                                   Foreground="{DynamicResource TextMuted}" 
                                   FontSize="12"
                                   Margin="0,0,0,8"/>
                        <TextBox x:Name="RuleValueTextBox" 
                                 Height="45" 
                                 Padding="15,0" 
                                 Width="120" 
                                 VerticalContentAlignment="Center" 
                                 TextAlignment="Center"
                                 FontSize="14"
                                 FontWeight="Bold"/>
                    </StackPanel>

                    <!-- Тип скидки -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Тип скидки" 
                                   Foreground="{DynamicResource TextMuted}" 
                                   FontSize="12"
                                   Margin="0,0,0,8"/>
                        <controls:CustomComboBox x:Name="RuleTypeCombo" 
                                                 Height="45" 
                                                 Width="150"
                                                 SelectedValuePath="Tag" 
                                                 Placeholder="Тип...">
                            <controls:CustomComboBox.Items>
                                <ComboBoxItem Content="Процент (%)" Tag="True"/>
                                <ComboBoxItem Content="Сумма (₽)" Tag="False"/>
                            </controls:CustomComboBox.Items>
                        </controls:CustomComboBox>
                    </StackPanel>
                </Grid>

                <Button Content="Сохранить правило" 
                        Click="SaveRule_Click" 
                        Style="{StaticResource SuccessBtn}"
                        HorizontalAlignment="Right"/>
            </StackPanel>
        </Border>

        <!-- Список существующих правил -->
        <Border Grid.Row="2" 
                Background="{DynamicResource BgCard}" 
                CornerRadius="6"
                Padding="15" 
                BorderBrush="{DynamicResource BorderColor}" 
                BorderThickness="1">
            <ListBox x:Name="RulesListBox" 
                     Background="Transparent" 
                     BorderThickness="0" 
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">

                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource DiscountRuleCardBg}" 
                                BorderBrush="{DynamicResource DiscountRuleCardBorder}" 
                                BorderThickness="1" 
                                CornerRadius="6" 
                                Padding="15" 
                                Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" 
                                               FontWeight="Bold" 
                                               FontSize="16" 
                                               Foreground="{DynamicResource TextMain}"/>
                                    <TextBlock Text="{Binding Value, StringFormat='Значение: {0}'}" 
                                               FontSize="14" 
                                               Foreground="{DynamicResource TextMuted}"
                                               Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding IsPercentage, Converter={StaticResource BooleanToDiscountTypeConverter}}"
                                               FontSize="12" 
                                               Foreground="{DynamicResource AccentBlue}" 
                                               FontWeight="SemiBold" 
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button Grid.Column="1" 
                                        Content="🗑 Удалить" 
                                        Click="DeleteRule_Click" 
                                        Style="{StaticResource DangerBtn}"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</Window>