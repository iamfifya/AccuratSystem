<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ЦВЕТОВАЯ ПАЛИТРА (Светлая тема) -->
    <SolidColorBrush x:Key="BgMain" Color="#F5F6FA"/>
    <SolidColorBrush x:Key="BgCard" Color="White"/>
    <SolidColorBrush x:Key="BorderColor" Color="#DCDDE1"/>

    <SolidColorBrush x:Key="TextMain" Color="#2C3E50"/>
    <SolidColorBrush x:Key="TextMuted" Color="#7F8C8D"/>
    <SolidColorBrush x:Key="TextLightMuted" Color="#95A5A6"/>

    <SolidColorBrush x:Key="AccentBlue" Color="#3498DB"/>
    <SolidColorBrush x:Key="AccentGreen" Color="#27AE60"/>
    <SolidColorBrush x:Key="AccentRed" Color="#E74C3C"/>
    <SolidColorBrush x:Key="AccentOrange" Color="#E67E22"/>
    <SolidColorBrush x:Key="AccentYellow" Color="#F39C12"/>
    <SolidColorBrush x:Key="AccentPurple" Color="#8E44AD"/>

    <!-- Дополнительные цвета для контролов -->
    <SolidColorBrush x:Key="InputBackground" Color="White"/>
    <SolidColorBrush x:Key="InputBorder" Color="#BDC3C7"/>
    <SolidColorBrush x:Key="InputText" Color="Black"/>

    <!-- Состояния карточек -->
    <SolidColorBrush x:Key="BgSelected" Color="#EBF5FB"/>
    <SolidColorBrush x:Key="BgAppointment" Color="#FFF8E1"/>
    <SolidColorBrush x:Key="BorderAppointment" Color="#FFD54F"/>
    <SolidColorBrush x:Key="BgAppointmentSelected" Color="#FFF3E0"/>
    <SolidColorBrush x:Key="SeparatorColor" Color="#F1F2F6"/>

    <!-- Калькулятор -->
    <SolidColorBrush x:Key="CalcOperatorBg" Color="#EBF5FB"/>
    <SolidColorBrush x:Key="CalcClearBg" Color="#FADBD8"/>
    <SolidColorBrush x:Key="CalcBg" Color="#f0f0f2"/>

    <!-- Окно заказа -->
    <SolidColorBrush x:Key="UpsellBannerBg" Color="#FFF9C4"/>
    <SolidColorBrush x:Key="UpsellBannerBorder" Color="#FBC02D"/>
    <SolidColorBrush x:Key="UpsellBannerText" Color="#F57F17"/>
    <SolidColorBrush x:Key="UpsellBonusText" Color="#2E7D32"/>
    <SolidColorBrush x:Key="ExpenseCardBg" Color="#F8F9FA"/>
    <SolidColorBrush x:Key="ExpenseTotalBg" Color="#E8F6F3"/>
    <SolidColorBrush x:Key="TimelineCardBorder" Color="#F1F2F6"/>
    <SolidColorBrush x:Key="SummaryPanelBg" Color="#F0F8FF"/>
    <SolidColorBrush x:Key="TabContentBg" Color="White"/>

    <!-- Таблица клиентов -->
    <SolidColorBrush x:Key="TableHeaderBg" Color="#2C3E50"/>
    <SolidColorBrush x:Key="TableRowHover" Color="#F0F8FF"/>
    <SolidColorBrush x:Key="TableRowSelected" Color="#E3F2FD"/>
    <SolidColorBrush x:Key="TableRowSelectedBorder" Color="#2196F3"/>
    <SolidColorBrush x:Key="GridSplitterColor" Color="#BDC3C7"/>
    <SolidColorBrush x:Key="TableRowBorder" Color="#E9ECEF"/>

    <!-- Отчеты -->
    <SolidColorBrush x:Key="ReportNetProfitBg" Color="#34495E"/>
    <SolidColorBrush x:Key="ReportNetProfitText" Color="#BDC3C7"/>
    <SolidColorBrush x:Key="ReportNetProfitValue" Color="#2ECC71"/>
    <SolidColorBrush x:Key="ReportWashProfit" Color="#27AE60"/>
    <SolidColorBrush x:Key="ReportServiceProfit" Color="#1A5276"/>
    <SolidColorBrush x:Key="ReportToPayText" Color="#8E44AD"/>

    <!-- Правила скидок -->
    <SolidColorBrush x:Key="DiscountRuleCardBg" Color="#EBF5FB"/>
    <SolidColorBrush x:Key="DiscountRuleCardBorder" Color="#3498DB"/>

    <!-- Статусы сотрудников -->
    <SolidColorBrush x:Key="StatusActive" Color="#27AE60"/>
    <SolidColorBrush x:Key="StatusInactive" Color="#E74C3C"/>

    <!-- График работы -->
    <SolidColorBrush x:Key="ScheduleWorkDay" Color="#A9DFBF"/>
    <SolidColorBrush x:Key="ScheduleDayOff" Color="#FAD7A1"/>
    <SolidColorBrush x:Key="ScheduleSkip" Color="#E74C3C"/>
    <SolidColorBrush x:Key="ScheduleWeekendText" Color="#E74C3C"/>
    <SolidColorBrush x:Key="ScheduleCellText" Color="#2C3E50"/>
    <SolidColorBrush x:Key="ScheduleGridBorder" Color="#BDC3C7"/>

    <!-- Админ-панель (DEV) -->
    <SolidColorBrush x:Key="AdminSidebarBg" Color="#2C3E50"/>
    <SolidColorBrush x:Key="AdminSidebarText" Color="White"/>
    <SolidColorBrush x:Key="AdminSidebarSelected" Color="#34495E"/>
    <SolidColorBrush x:Key="AdminGridAltRow" Color="#ECF0F1"/>
    <SolidColorBrush x:Key="AdminGridBg" Color="White"/>
    <SolidColorBrush x:Key="AdminGridHeaderBg" Color="#34495E"/>

</ResourceDictionary>