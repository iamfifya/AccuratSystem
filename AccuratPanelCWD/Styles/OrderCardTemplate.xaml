<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:AccuratPanelCWD.Models"
                    xmlns:controls="clr-namespace:AccuratPanelCWD.Controls">

    <!-- ============ СТИЛЬ КАРТОЧКИ ЗАКАЗА (темы + записи) ============ -->
    <Style x:Key="OrderCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BgCard}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="15"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1" Color="#000000"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Это предварительная запись -->
            <DataTrigger Binding="{Binding IsAppointment}" Value="True">
                <Setter Property="Background" Value="{DynamicResource BgAppointment}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderAppointment}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </DataTrigger>
            <!-- Карточка выбрана -->
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="Background" Value="{DynamicResource BgSelected}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </DataTrigger>
            <!-- Выбрана + запись (должен быть последним, чтобы победить) -->
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding IsSelected}" Value="True"/>
                    <Condition Binding="{Binding IsAppointment}" Value="True"/>
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource BgAppointmentSelected}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource AccentOrange}"/>
                <Setter Property="BorderThickness" Value="2"/>
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ============ ШАБЛОН КАРТОЧКИ ЗАКАЗА ============ -->
    <DataTemplate x:Key="OrderTemplate" DataType="{x:Type models:OrderDisplayItem}">
        <Border Style="{StaticResource OrderCardBorderStyle}"
                controls:OrderDragBehavior.IsEnabled="True">
            <StackPanel>
                <!-- Номер + значок записи | Время -->
                <DockPanel Margin="0,0,0,8">
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                        <TextBlock Text="{Binding CarNumber}" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource TextMain}"/>
                        <TextBlock Text=" 📅" FontSize="12" Foreground="{DynamicResource AccentOrange}"
                                   Visibility="{Binding IsAppointment, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Time, StringFormat={}{0:HH:mm}}" FontSize="14"
                               Foreground="{DynamicResource TextMuted}"
                               DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                </DockPanel>

                <TextBlock Text="{Binding CarModel}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMain}" Margin="0,0,0,4"/>

                <TextBlock Margin="0,0,0,4">
                    <Run Text="Мойщик: " Foreground="{DynamicResource TextLightMuted}" FontSize="12"/>
                    <Run Text="{Binding WasherName}" FontWeight="Medium" FontSize="12"
                         Foreground="{DynamicResource TextMain}"/>
                </TextBlock>

                <TextBlock Text="{Binding ServicesList}" FontSize="12"
                           Foreground="{DynamicResource TextMuted}"
                           TextWrapping="Wrap" Margin="0,0,0,8" MaxWidth="300" HorizontalAlignment="Left"/>

                <Separator Background="{DynamicResource SeparatorColor}" Margin="0,5"/>

                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Цены -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding OriginalPriceDisplay}" FontSize="11"
                                   Foreground="{DynamicResource TextLightMuted}"
                                   TextDecorations="Strikethrough"
                                   Visibility="{Binding ShowOriginalPrice, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <TextBlock Text="{Binding FinalPrice, StringFormat={}{0:N0} ₽}" FontSize="14"
                                   FontWeight="Bold" Foreground="{DynamicResource AccentGreen}"/>

                        <TextBlock Text="{Binding DiscountDisplay}" FontSize="10"
                                   Foreground="{DynamicResource AccentRed}" FontWeight="Bold"
                                   Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}"
                                   Margin="0,1,0,0"/>

                        <TextBlock Text="{Binding PaymentMethod, StringFormat=💳 {0}}" FontSize="9"
                                   Foreground="{DynamicResource AccentBlue}" Margin="0,1,0,0"/>
                    </StackPanel>

                    <!-- Статус + время в статусе -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Border Background="{Binding StatusColorHex, Converter={StaticResource HexToBrushConverter}}"
                                CornerRadius="6" Padding="6,2">
                            <TextBlock Text="{Binding Status}" Foreground="White" FontSize="9" FontWeight="Bold"/>
                        </Border>
                        <TextBlock Text="{Binding TimeInStatus}" FontSize="10"
                                   Foreground="{DynamicResource TextMuted}" FontWeight="SemiBold"
                                   HorizontalAlignment="Right" Margin="0,2,0,0"
                                   Visibility="{Binding TimeInStatus, Converter={StaticResource ZeroToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>

                <!-- Доплаты -->
                <StackPanel Visibility="{Binding ExtraCost, Converter={StaticResource ZeroToVisibilityConverter}}">
                    <TextBlock Text="{Binding ExtraCost, StringFormat=➕ {0:N0} ₽}" FontSize="11"
                               Foreground="{DynamicResource AccentOrange}" FontWeight="Bold" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding ExtraCostReason}" FontSize="10"
                               Foreground="{DynamicResource AccentOrange}" TextWrapping="Wrap" FontStyle="Italic"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- Неявный шаблон: применяется автоматически везде, где выводится OrderDisplayItem
         без явного ItemTemplate -->
    <DataTemplate DataType="{x:Type models:OrderDisplayItem}">
        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource OrderTemplate}"/>
    </DataTemplate>

    <!-- ============ ЧИСТЫЙ LISTBOX ============ -->
    <Style x:Key="CleanListBoxStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ СТРОКА СТАТИСТИКИ ОПЛАТ (DRY) ============ -->
    <Style x:Key="PaymentStatGridStyle" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

</ResourceDictionary>