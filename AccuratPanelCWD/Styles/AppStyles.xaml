<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:models="clr-namespace:AccuratPanelCWD.Models">

    <!-- БАЗОВЫЙ СТИЛЬ КНОПОК -->
    <Style x:Key="BaseButtonStyle" TargetType="Button">
        <Setter Property="Height" Value="45"/>
        <Setter Property="Padding" Value="15,0"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                        CornerRadius="6" 
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.9"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ЦВЕТОВЫЕ СТИЛИ КНОПОК -->
    <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource AccentBlue}"/>
    </Style>
    <Style x:Key="SuccessBtn" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource AccentGreen}"/>
    </Style>
    <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource AccentRed}"/>
    </Style>
    <Style x:Key="WarningBtn" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource AccentYellow}"/>
    </Style>
    <Style x:Key="PurpleBtn" TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}">
        <Setter Property="Background" Value="{DynamicResource AccentPurple}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>

    <!-- Стиль для KPI карточек (статистика в отчетах) -->
    <Style x:Key="StatCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BgCard}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="20"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.08" Color="#000000"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- СТИЛЬ КАРТОЧКИ ЗАКАЗА -->
    <Style x:Key="OrderCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BgCard}"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="15"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.1" Color="#000000"/>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Background" Value="#EBF5FB"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- ШАБЛОН КАРТОЧКИ ЗАКАЗА -->
    <DataTemplate x:Key="OrderTemplate" DataType="{x:Type models:OrderDisplayItem}">
        <Border Style="{StaticResource OrderCardBorderStyle}">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="{Binding CarNumber}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextMain}" DockPanel.Dock="Left"/>
                    <TextBlock Text="{Binding Time, StringFormat={}{0:HH:mm}}" FontSize="14" Foreground="{DynamicResource TextMuted}" DockPanel.Dock="Right" HorizontalAlignment="Right"/>
                </DockPanel>

                <TextBlock Text="{Binding CarModel}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>

                <TextBlock Margin="0,0,0,4">
                <Run Text="Мойщик: " Foreground="{DynamicResource TextLightMuted}" FontSize="12"/>
                <Run Text="{Binding WasherName}" FontWeight="Medium" FontSize="12"/>
                </TextBlock>

                <TextBlock Text="{Binding ServicesList}" FontSize="12" Foreground="{DynamicResource TextMuted}" 
                       TextWrapping="Wrap" Margin="0,0,0,8" MaxWidth="300" HorizontalAlignment="Left"/>

                <Separator Background="#F1F2F6" Margin="0,5"/>

                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding OriginalPriceDisplay}" FontSize="11" Foreground="{DynamicResource TextLightMuted}" 
                               TextDecorations="Strikethrough"
                               Visibility="{Binding ShowOriginalPrice, Converter={StaticResource BoolToVisibilityConverter}}"/>

                        <TextBlock Text="{Binding FinalPrice, StringFormat={}{0:N0} ₽}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentGreen}"/>

                        <TextBlock Text="{Binding DiscountDisplay}" FontSize="10" Foreground="{DynamicResource AccentRed}" FontWeight="Bold"
                               Visibility="{Binding HasDiscount, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,1,0,0"/>

                        <TextBlock Text="{Binding PaymentMethod, StringFormat=💳 {0}}" FontSize="9" Foreground="{DynamicResource AccentBlue}" Margin="0,1,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Border Background="{Binding StatusColorHex, Converter={StaticResource HexToBrushConverter}}" CornerRadius="6" Padding="6,2">
                            <TextBlock Text="{Binding Status}" Foreground="White" FontSize="9" FontWeight="Bold"/>
                        </Border>

                        <TextBlock Text="{Binding TimeInStatus}" FontSize="10" Foreground="{DynamicResource TextMuted}" FontWeight="SemiBold" 
                               HorizontalAlignment="Right" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>

                <StackPanel Visibility="{Binding ExtraCost, Converter={StaticResource ZeroToVisibilityConverter}}">
                    <TextBlock Text="{Binding ExtraCost, StringFormat=➕ {0:N0} ₽}" FontSize="11" Foreground="{DynamicResource AccentOrange}" FontWeight="Bold" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding ExtraCostReason}" FontSize="10" Foreground="{DynamicResource AccentOrange}" TextWrapping="Wrap" FontStyle="Italic"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <Style x:Key="CleanListBoxStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ListBoxItem">
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль для статистики оплат -->
    <Style x:Key="PaymentStatGridStyle" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <!-- Стиль для TextBox -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
        <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource InputText}"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Height" Value="35"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                            <Setter Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль для PasswordBox -->
    <Style TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
        <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource InputText}"/>
        <Setter Property="Padding" Value="15,0"/>
        <Setter Property="Height" Value="45"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" 
                                  Margin="0"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBlue}"/>
                            <Setter Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль для ComboBox -->
    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="35"/>
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource InputText}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
    </Style>

    <!-- Стиль для DatePicker -->
    <Style TargetType="DatePicker">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Background" Value="{DynamicResource InputBackground}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Height" Value="35"/>
    </Style>

    <!-- Стиль для GroupBox -->
    <Style TargetType="GroupBox">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
        <Setter Property="Margin" Value="5,0,15,15"/>
        <Setter Property="Padding" Value="5,10,5,5"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Стиль для TabControl -->
    <Style TargetType="TabControl">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="#F0F0F2"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="10,5"/>
    </Style>

</ResourceDictionary>