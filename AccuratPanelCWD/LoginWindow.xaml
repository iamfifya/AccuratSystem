<Window x:Class="AccuratPanelCWD.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AccuratPanelCWD"
        xmlns:controls="clr-namespace:AccuratPanelCWD.Controls" 
        mc:Ignorable="d"
        Title="Авторизация"
        WindowStartupLocation="CenterScreen"
        Height="600" Width="450"
        Background="{DynamicResource BgMain}"
        BorderBrush="{DynamicResource BorderColor}"
        BorderThickness="1"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize">

    <Border Background="{DynamicResource BgCard}" 
            CornerRadius="6" 
            Padding="30"
            Margin="20"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.15" Color="#000000"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <StackPanel Grid.Row="0" Margin="0,0,0,30">
                <TextBlock Text="AccuratSystem" 
                           FontSize="42" 
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextMain}" 
                           HorizontalAlignment="Center" 
                           FontFamily="Segoe UI"/>
                <TextBlock Text="Система управления автомойкой" 
                           FontSize="13" 
                           Foreground="{DynamicResource TextMuted}" 
                           HorizontalAlignment="Center"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Панель логина -->
            <StackPanel x:Name="LoginPanel" Grid.Row="1" VerticalAlignment="Center" Visibility="Visible">
                <TextBlock Text="Логин" 
                           FontSize="13" 
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMain}"
                           Margin="0,0,0,8"/>
                <TextBox x:Name="LoginTextBox" 
                         Margin="0,0,0,20" 
                         Height="45" 
                         Padding="15,0"
                         FontSize="14"
                         VerticalContentAlignment="Center"/>

                <TextBlock Text="Пароль" 
                           FontSize="13" 
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMain}"
                           Margin="0,0,0,8"/>
                <PasswordBox x:Name="PasswordBox" 
                             Margin="0,0,0,20" 
                             Height="45" 
                             Padding="15,0"
                             FontSize="14"
                             VerticalContentAlignment="Center"/>
            </StackPanel>

            <!-- Панель выбора филиала -->
            <StackPanel x:Name="BranchSelectionPanel" Grid.Row="1" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock Text="Выберите рабочую точку" 
                           FontSize="15" 
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMain}"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <controls:CustomComboBox x:Name="BranchComboBox" 
                                         Margin="0,0,0,20" 
                                         Height="45"
                                         Placeholder="Выберите место работы"
                                         DisplayMemberPath="Name"
                                         SelectedValuePath="Id"/>
            </StackPanel>

            <!-- Кнопки действий -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                <Button x:Name="ActionBtn" 
                        Content="Войти" 
                        Click="ActionBtn_Click" 
                        Style="{StaticResource SuccessBtn}"
                        IsDefault="True"/>
                <Button Content="Выход" 
                        Click="ExitButton_Click" 
                        Style="{StaticResource DangerBtn}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>