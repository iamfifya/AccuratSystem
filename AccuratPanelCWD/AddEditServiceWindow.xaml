<Window x:Class="AccuratPanelCWD.AddEditServiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AccuratPanelCWD"
        xmlns:controls="clr-namespace:AccuratPanelCWD.Controls"
        mc:Ignorable="d"
        Title="Добавление/Редактирование услуги"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Width="700" Height="950"
        Background="{DynamicResource BgMain}"
        BorderBrush="{DynamicResource BorderColor}"
        BorderThickness="1"
        WindowStyle="SingleBorderWindow"
        Foreground="{DynamicResource TextMain}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">

            <StackPanel Margin="0,0,10,20">
                <!-- Заголовок -->
                <TextBlock Text="{Binding WindowTitle}" 
                           FontSize="22" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource TextMain}" 
                           HorizontalAlignment="Center" 
                           Margin="0,0,0,25"/>

                <!-- Название услуги -->
                <TextBlock Text="Название услуги" 
                           FontSize="13" 
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMain}"
                           Margin="0,0,0,8"/>
                <TextBox x:Name="NameTextBox" 
                         Text="{Binding CurrentService.Name, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,0,0,20" 
                         Height="45" 
                         Padding="15,0"
                         FontSize="14"/>

                <!-- Цены по категориям кузова -->
                <TextBlock Text="Цены по категориям кузова" 
                           FontSize="13" 
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMain}"
                           Margin="0,0,0,8"/>

                <ItemsControl x:Name="PriceCategoriesControl" Margin="0,0,0,20">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource BgCard}" 
                                    CornerRadius="6" 
                                    Padding="15" 
                                    Margin="0,0,0,8"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding CategoryName}" 
                                               VerticalAlignment="Center" 
                                               FontSize="13" 
                                               Foreground="{DynamicResource TextMain}"
                                               FontWeight="SemiBold"/>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Width="180">
                                        <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" 
                                                 Width="120" 
                                                 Height="40" 
                                                 Padding="10,0" 
                                                 VerticalAlignment="Center"
                                                 FontSize="14"
                                                 FontWeight="Bold"
                                                 HorizontalContentAlignment="Center"/>
                                        <TextBlock Text=" ₽" 
                                                   VerticalAlignment="Center" 
                                                   FontWeight="Bold" 
                                                   Margin="8,0,0,0"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource TextMain}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Длительность -->
                <TextBlock Text="Длительность (минуты)" 
                           FontSize="13" 
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMain}"
                           Margin="0,0,0,8"/>
                <TextBox x:Name="DurationTextBox" 
                         Text="{Binding CurrentService.DurationMinutes, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,0,0,20" 
                         Height="45" 
                         Padding="15,0"
                         FontSize="14"/>

                <!-- Описание -->
                <TextBlock Text="Описание" 
                           FontSize="13" 
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMain}"
                           Margin="0,0,0,8"/>
                <TextBox x:Name="DescriptionTextBox" 
                         Text="{Binding CurrentService.Description, UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,0,0,20" 
                         Height="80" 
                         Padding="15,10" 
                         TextWrapping="Wrap" 
                         AcceptsReturn="True"
                         FontSize="13"/>

                <!-- Индивидуальный процент зарплаты -->
                <TextBlock Text="Индивидуальный % зарплаты за услугу" 
                           FontSize="13" 
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMain}"
                           Margin="0,0,0,8"/>
                <TextBox x:Name="CustomWageTextBox" 
                         Text="{Binding CurrentService.CustomWagePercentage, TargetNullValue='', UpdateSourceTrigger=PropertyChanged}" 
                         Margin="0,0,0,5" 
                         Height="45" 
                         Padding="15,0"
                         FontSize="14"
                         ToolTip="Оставьте пустым, чтобы использовать базовую ставку сотрудника"/>
                <TextBlock Text="Если указать здесь процент, он перекроет базовую ставку мойщика для этой услуги." 
                           Foreground="{DynamicResource TextMuted}" 
                           FontSize="11" 
                           TextWrapping="Wrap" 
                           Margin="0,0,0,20"/>

                <!-- Категория услуги -->
                <TextBlock Text="📂 Категория услуги" 
                           FontSize="13" 
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMain}"
                           Margin="0,0,0,8"/>
                <controls:CustomComboBox x:Name="CategoryComboBox" 
                                         Margin="0,0,0,20" 
                                         Height="45"
                                         Placeholder="Выберите категорию услуги"
                                         SelectedValue="{Binding CurrentService.ServiceCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         SelectedValuePath="Tag">
                    <controls:CustomComboBox.Items>
                        <ComboBoxItem Content="💦 Мойка (автомойка)" Tag="0"/>
                        <ComboBoxItem Content="🔧 Сервис (ремонт/ТО)" Tag="1"/>
                    </controls:CustomComboBox.Items>
                </controls:CustomComboBox>

            </StackPanel>

        </ScrollViewer>

        <!-- Кнопки действий (без Width/Height — размеры из AppStyles) -->
        <StackPanel Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Grid.Row="1" 
                    Margin="0,20">
            <Button Content="✅ Сохранить" 
                    Click="SaveButton_Click" 
                    Style="{StaticResource SuccessBtn}"
                    Margin="0,0,10,0"/>
            <Button Content="✖ Отмена" 
                    Click="CloseButton_Click" 
                    Style="{StaticResource DangerBtn}"/>
        </StackPanel>
    </Grid>
</Window>