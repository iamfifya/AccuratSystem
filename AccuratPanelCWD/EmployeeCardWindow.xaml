<Window x:Class="AccuratPanelCWD.EmployeeCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AccuratPanelCWD"
        mc:Ignorable="d"
        Title="Сотрудники"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        MinWidth="800" MinHeight="500"
        Width="1100" Height="700"
        Background="{DynamicResource BgMain}"
        BorderBrush="{DynamicResource BorderColor}"
        BorderThickness="1"
        WindowStyle="None"
        WindowState="Maximized"
        Foreground="{DynamicResource TextMain}">

    <Window.Resources>
        <Style x:Key="HeaderCellStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="TableRowStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgCard}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="{DynamicResource TableRowBorder}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource TableRowHover}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GridSplitterStyle" TargetType="GridSplitter">
            <Setter Property="Width" Value="4"/>
            <Setter Property="Background" Value="{DynamicResource GridSplitterColor}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="ShowsPreview" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBlue}"/>
                    <Setter Property="Cursor" Value="SizeWE"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="👥 Сотрудники" 
                   FontSize="24" 
                   FontWeight="Bold" 
                   Foreground="{DynamicResource TextMain}" 
                   HorizontalAlignment="Center" 
                   Margin="0,0,0,20" 
                   Grid.Row="0"/>

        <!-- Панель управления -->
        <StackPanel Grid.Row="1" 
                    Orientation="Horizontal" 
                    Margin="0,0,0,20" 
                    HorizontalAlignment="Left" 
                    VerticalAlignment="Center">
            <Button Content="➕ Добавить сотрудника" 
                    Click="AddButton_Click" 
                    Style="{StaticResource SuccessBtn}"
                    Margin="0,0,8,0"/>
            <Button x:Name="ScheduleButton" 
                    Content="📅 График сотрудников" 
                    Click="ScheduleButton_Click" 
                    Style="{StaticResource WarningBtn}"
                    Margin="0,0,8,0"/>

            <Border Width="1" Background="{DynamicResource BorderColor}" Margin="15,5"/>

            <TextBlock Text="🔍 Поиск" 
                       VerticalAlignment="Center" 
                       Foreground="{DynamicResource TextMain}"
                       FontWeight="SemiBold"
                       Margin="0,0,8,0"/>
            <TextBox x:Name="SearchFilterTextBox" 
                     Width="280" 
                     Height="45" 
                     Padding="15,0"
                     FontSize="14"
                     KeyUp="SearchFilterTextBox_KeyUp"/>
        </StackPanel>

        <!-- Заголовок таблицы -->
        <Border Grid.Row="2" 
                Background="{DynamicResource TableHeaderBg}" 
                Height="45" 
                CornerRadius="6,6,0,0">
            <Grid x:Name="HeaderGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.8*" MinWidth="50"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="3*" MinWidth="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*" MinWidth="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*" MinWidth="100"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*" MinWidth="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.2*" MinWidth="80"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="ФИО" Style="{StaticResource HeaderCellStyle}" HorizontalAlignment="Left" Padding="10,8" Grid.Column="2"/>
                <GridSplitter Grid.Column="3" Style="{StaticResource GridSplitterStyle}"/>
                <TextBlock Text="Телефон" Style="{StaticResource HeaderCellStyle}" HorizontalAlignment="Left" Padding="10,8" Grid.Column="4"/>
                <GridSplitter Grid.Column="5" Style="{StaticResource GridSplitterStyle}"/>
                <TextBlock Text="Логин" Style="{StaticResource HeaderCellStyle}" HorizontalAlignment="Left" Padding="10,8" Grid.Column="6"/>
                <GridSplitter Grid.Column="7" Style="{StaticResource GridSplitterStyle}"/>
                <TextBlock Text="Должность" Style="{StaticResource HeaderCellStyle}" HorizontalAlignment="Center" Padding="10,8" Grid.Column="8"/>
                <GridSplitter Grid.Column="9" Style="{StaticResource GridSplitterStyle}"/>
                <TextBlock Text="Статус" Style="{StaticResource HeaderCellStyle}" HorizontalAlignment="Center" Padding="10,8" Grid.Column="10"/>
            </Grid>
        </Border>

        <!-- Таблица с данными -->
        <ScrollViewer Grid.Row="3" 
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Auto"
                      CanContentScroll="True">
            <Grid x:Name="DataGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.8*" MinWidth="50"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="3*" MinWidth="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*" MinWidth="100"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*" MinWidth="120"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.2*" MinWidth="80"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1.2*" MinWidth="80"/>
                </Grid.ColumnDefinitions>

                <GridSplitter Grid.Column="1" Style="{StaticResource GridSplitterStyle}"/>
                <GridSplitter Grid.Column="3" Style="{StaticResource GridSplitterStyle}"/>
                <GridSplitter Grid.Column="5" Style="{StaticResource GridSplitterStyle}"/>
                <GridSplitter Grid.Column="7" Style="{StaticResource GridSplitterStyle}"/>
                <GridSplitter Grid.Column="9" Style="{StaticResource GridSplitterStyle}"/>

                <ListBox x:Name="EmployeesListView" 
                         Grid.ColumnSpan="11"
                         SelectionMode="Single" 
                         Background="{DynamicResource BgCard}"
                         BorderThickness="0"
                         SelectionChanged="EmployeesListView_SelectionChanged"
                         MouseDoubleClick="EmployeesListView_MouseDoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         Foreground="{DynamicResource TextMain}">

                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="✏ Редактировать" Click="EditEmployeeMenuItem_Click"/>
                        </ContextMenu>
                    </ListBox.ContextMenu>

                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="RowBorder" Style="{StaticResource TableRowStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.8*" MinWidth="50"/>
                                        <ColumnDefinition Width="3*" MinWidth="150"/>
                                        <ColumnDefinition Width="2*" MinWidth="100"/>
                                        <ColumnDefinition Width="2*" MinWidth="100"/>
                                        <ColumnDefinition Width="2*" MinWidth="120"/>
                                        <ColumnDefinition Width="1.2*" MinWidth="80"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding FullName}" 
                                               HorizontalAlignment="Left" 
                                               VerticalAlignment="Center" 
                                               Padding="10,8"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextMain}"
                                               FontWeight="SemiBold"
                                               Grid.Column="1"/>

                                    <TextBlock Text="{Binding Phone}" 
                                               HorizontalAlignment="Left" 
                                               VerticalAlignment="Center" 
                                               Padding="10,8"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextMuted}"
                                               Grid.Column="2"/>

                                    <TextBlock Text="{Binding Login}" 
                                               HorizontalAlignment="Left" 
                                               VerticalAlignment="Center" 
                                               Padding="10,8"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextMain}"
                                               Grid.Column="3"/>

                                    <TextBlock Text="{Binding Role.Name}" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center" 
                                               Padding="10,8"
                                               Foreground="{DynamicResource TextMain}"
                                               Grid.Column="4"/>

                                    <!-- Статус с использованием триггера -->
                                    <TextBlock Grid.Column="5" 
                                               HorizontalAlignment="Center" 
                                               VerticalAlignment="Center" 
                                               Padding="10,8"
                                               FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="Трудоустроен"/>
                                                <Setter Property="Foreground" Value="{DynamicResource StatusActive}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                        <Setter Property="Text" Value="Уволен"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource StatusInactive}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource TableRowSelected}"/>
                                    <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource TableRowSelectedBorder}"/>
                                    <Setter TargetName="RowBorder" Property="BorderThickness" Value="0,0,0,2"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </ScrollViewer>

        <!-- Кнопка закрытия (БЕЗ размеров — из AppStyles) -->
        <StackPanel Grid.Row="4" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Center" 
                    Margin="0,20,0,15">
            <Button Content="✖ Закрыть" 
                    Click="CloseButton_Click" 
                    Style="{StaticResource DangerBtn}"/>
        </StackPanel>
    </Grid>
</Window>