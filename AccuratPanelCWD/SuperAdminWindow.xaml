<Window x:Class="AccuratPanelCWD.SuperAdminWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DEV PANEL: Управление БД" 
        Height="750" Width="1300"
        WindowStartupLocation="CenterScreen" 
        Background="{DynamicResource BgMain}"
        Foreground="{DynamicResource TextMain}">

    <Window.Resources>
        <!-- Стиль для DataGrid -->
        <Style x:Key="AdminDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource AdminGridBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="{DynamicResource AdminGridBg}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource AdminGridAltRow}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="MinColumnWidth" Value="50"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="True"/>
            <Setter Property="CanUserAddRows" Value="True"/>
            <Setter Property="CanUserDeleteRows" Value="True"/>
        </Style>

        <!-- Стиль заголовков колонок -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource AdminGridHeaderBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource AdminSidebarText}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>

        <!-- Стиль ячеек -->
        <Style TargetType="DataGridCell">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBlue}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Левая панель: список таблиц -->
        <Border Grid.Column="0" Background="{DynamicResource AdminSidebarBg}">
            <StackPanel>
                <TextBlock Text="🗄️ ТАБЛИЦЫ БД" 
                           Foreground="{DynamicResource AdminSidebarText}" 
                           FontWeight="Bold" 
                           Margin="20,25,20,15" 
                           FontSize="17"/>

                <ListBox x:Name="TablesListBox" 
                         Background="Transparent" 
                         BorderThickness="0" 
                         Foreground="{DynamicResource AdminSidebarText}" 
                         SelectionChanged="TablesListBox_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="20,12"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Foreground" Value="{DynamicResource AdminSidebarText}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Border"
                                                Background="Transparent"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource AdminSidebarSelected}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource AdminSidebarSelected}"/>
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBoxItem Content="🏢 Companies (Компании)" Tag="Companies"/>
                    <ListBoxItem Content="🌿 Branches (Филиалы)" Tag="Branches"/>
                    <ListBoxItem Content="👥 Users (Сотрудники)" Tag="Users"/>
                    <ListBoxItem Content="🛠 Services (Услуги)" Tag="Services"/>
                    <ListBoxItem Content="👤 Clients (Клиенты)" Tag="Clients"/>
                    <ListBoxItem Content="📦 Orders (Заказы)" Tag="Orders"/>
                    <ListBoxItem Content="🎭 Roles (Роли)" Tag="Roles"/>
                    <ListBoxItem Content="🔐 TenantFeatures (Лицензии)" Tag="TenantFeatures"/>
                </ListBox>

                <!-- Информация о панели -->
                <Border Margin="15,20,15,15" 
                        Background="{DynamicResource AdminSidebarSelected}" 
                        CornerRadius="6" 
                        Padding="12">
                    <StackPanel>
                        <TextBlock Text="⚠️ Осторожно!" 
                                   Foreground="{DynamicResource AccentYellow}" 
                                   FontWeight="Bold" 
                                   FontSize="12" 
                                   Margin="0,0,0,5"/>
                        <TextBlock Text="Прямое редактирование БД. Изменения необратимы." 
                                   Foreground="{DynamicResource AdminSidebarText}" 
                                   FontSize="11" 
                                   TextWrapping="Wrap"
                                   Opacity="0.8"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Правая панель: DataGrid + кнопки -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Заголовок текущей таблицы -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource BgCard}" 
                    CornerRadius="6" 
                    Padding="20" 
                    Margin="0,0,0,15"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1">
                <StackPanel>
                    <TextBlock x:Name="CurrentTableTitle" 
                               Text="Выберите таблицу..." 
                               FontSize="22" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource TextMain}"/>
                    <TextBlock Text="Прямое редактирование через DataGrid" 
                               FontSize="12" 
                               Foreground="{DynamicResource TextMuted}"
                               Margin="0,5,0,0"/>
                </StackPanel>
            </Border>

            <!-- DataGrid -->
            <DataGrid x:Name="DynamicDataGrid" 
                      Grid.Row="1" 
                      Style="{StaticResource AdminDataGridStyle}"
                      Margin="0" 
                      Padding="5"/>

            <!-- Кнопки управления -->
            <StackPanel Grid.Row="2" 
                        Orientation="Horizontal" 
                        HorizontalAlignment="Right" 
                        Margin="0,15,0,0">
                <Button Content="🔄 Обновить" 
                        Click="RefreshTable_Click" 
                        Style="{StaticResource PrimaryBtn}"
                        Margin="0,0,8,0"/>
                <Button Content="🗑 Удалить выделенное" 
                        Click="DeleteRow_Click" 
                        Style="{StaticResource DangerBtn}"
                        Margin="0,0,8,0"/>
                <Button Content="💾 Сохранить изменения" 
                        Click="SaveChanges_Click" 
                        Style="{StaticResource SuccessBtn}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>