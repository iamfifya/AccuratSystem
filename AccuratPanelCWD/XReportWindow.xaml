<Window x:Class="AccuratPanelCWD.XReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🧮 X-Отчет — пересчёт кассы"
        Height="580" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource BgMain}">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="🧮 X-Отчет" FontSize="24" FontWeight="Black"
                       Foreground="{DynamicResource TextMain}"/>
            <TextBlock x:Name="ShiftInfoText" FontSize="12"
                       Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Ожидается (read-only) -->
        <Border Grid.Row="1" Background="{DynamicResource BgCard}" CornerRadius="6"
                Padding="15" Margin="0,0,0,12"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Ожидается в кассе" FontSize="13"
                           Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                <TextBlock x:Name="ExpectedCashText" Grid.Column="1" FontSize="22" FontWeight="Bold"
                           Foreground="{DynamicResource TextMain}" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Факт -->
        <TextBlock Grid.Row="2" Text="Фактически насчитано" FontSize="12" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
        <TextBox x:Name="ActualCashTextBox" Grid.Row="3" Height="45" FontSize="18" FontWeight="Bold"
                 Padding="15,0" Margin="0,0,0,12" TextChanged="ActualCashTextBox_TextChanged"/>

        <!-- Живая разница -->
        <Border Grid.Row="4" CornerRadius="6" Padding="15" Margin="0,0,0,12"
                Background="{DynamicResource BgCard}"
                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock x:Name="DifferenceText" Text="Введите фактическую сумму"
                           FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextMuted}"/>
                <TextBlock x:Name="DifferenceHintText" FontSize="11" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextLightMuted}" Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <!-- Комментарий -->
        <StackPanel Grid.Row="5">
            <TextBlock Text="Комментарий" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextMuted}" Margin="0,0,0,6"/>
            <TextBox x:Name="CommentTextBox" Height="70" TextWrapping="Wrap" AcceptsReturn="True"
                     Padding="10,8" FontSize="13"/>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button Content="✅ Зафиксировать пересчёт" Click="Save_Click"
                    Style="{StaticResource SuccessBtn}" Width="200"/>
            <Button Content="✖ Отмена" Click="Close_Click"
                    Style="{StaticResource DangerBtn}" Width="110"/>
        </StackPanel>
    </Grid>
</Window>